---
import BaseLayout from "../layouts/BaseLayout.astro";
import MethodPanelBody from "../components/MethodPanelBody.astro";
import Model3DViewer from "../components/Model3DViewer.astro";
import FlowMapViewer from "../components/FlowMapViewer.astro";
import LaunchFamilyNav from "../components/LaunchFamilyNav.astro";
import { href, ytThumb, ytWatch, MEDIA_BASE } from "../lib/url";
import { typeGroups, typeFamilies, gameLabelFor, type TypeItem, type TypeGroup } from "../data/types";
import { typeContent, type TypeMethod, type TermGroup, type VideoGroup } from "../data/type-content";
import { uiStrings, type Lang } from "../data/ui-strings";
import { resolveTypeContent } from "../lib/i18n-content";
import { parseAccent, parseStep, stepParts, parseName, principleHtml, principleExtraHtml, principleSectionsHtml } from "../lib/method-format";

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");

// 同一份模板產出中日兩種路徑：
//   中文 /types/totk-11、日文 /ja/types/totk-11
// 語言擺在路徑最前面（而不是 /types/ja/...），是因為 home／videos／resources
// 這些頁面沒有共同的父路徑，語言前綴才是唯一能一條規則吃遍全站的形式；
// hreflang 與搜尋引擎辨識語言版本，也是對前綴形式支援最好。
//
// 這個檔案放在 src/pages/ 根層級而非 types/ 底下，才有辦法自由決定完整路徑
// （放在 types/ 底下的話，Astro 會固定幫你補上 /types 前綴，就只能產出
// /types/ja/... 這種語言夾在中間的形式）。
//
// 日文版是漸進式的：ui-strings 決定外殼文字，攻略內文尚未翻譯時沿用中文，
// 所以日文頁在翻譯補齊前會是「外殼日文、內文中文」的混合狀態。
export function getStaticPaths() {
  const paths: {
    params: { typePath: string };
    props: { group: TypeGroup; item: TypeItem; lang: Lang };
  }[] = [];
  for (const group of typeGroups) {
    for (const item of group.items) {
      const base = `${group.game}-${item.no}`;
      paths.push({ params: { typePath: `types/${base}` }, props: { group, item, lang: "zh" } });
      paths.push({ params: { typePath: `ja/types/${base}` }, props: { group, item, lang: "ja" } });
    }
  }
  return paths;
}

const { group, item, lang } = Astro.props;
// params.typePath 形如 "types/totk-11" 或 "ja/types/totk-11"，
// 查 typeContent 要用去掉語言與 types/ 前綴的原始 id
const { typePath: routeId } = Astro.params as { typePath: string };
const id = routeId.replace(/^ja\//, "").replace(/^types\//, "");
const t = uiStrings[lang];
// 本頁自己的身分（h1／麵包屑／分頁標題）一律用日文標題；type-content.ja.ts
// 疊加的是攻略內文，跟這裡的 item.ja（技巧名稱本身）是兩回事，各自獨立維護
const itemTitle = (lang === "ja" && item.ja) || item.zh;
// 遊戲名稱一律以 types.ts 的 typeGroups 為單一資料來源，不在這裡另外複製一份
// （曾經在這裡手寫過對照表，結果跟 types.ts 的資料脫節，見 gameLabelFor）。
// 唯一例外是大亂鬥中文版：label 的正式全名「任天堂明星大亂鬥特別版」在標題／
// 麵包屑這種行文語境下太長，shortLabel「大亂鬥」又是特地給篩選鈕等窄版空間用
// 的超短版本（改動它會連帶影響那些地方）；「大亂鬥特別版」是介於兩者之間、
// 只有這個語境會用到的慣用簡稱，不值得為了單一遊戲、單一場合擴充 gameLabelFor
// 的分級機制，直接在這裡覆蓋即可。
const gameLabel =
  lang === "zh" && group.game === "ssbu" ? "大亂鬥特別版" : gameLabelFor(group, lang);
// 日文版會把 type-content.ja.ts 的翻譯疊加上來；沒翻到的欄位自動沿用中文
const content = resolveTypeContent(id, lang);
// [[文字|tab:分頁名]] 的跳轉目標一律以「中文版的 tab」為準：分頁標籤被翻成日文後，
// 若還用顯示文字比對就會找不到目標而靜默失效。合併後的 methods 與中文版同序同長度，
// 所以可以用索引取回原始 tab 當作穩定 key。
const zhMethods = typeContent[id]?.methods;
const family = item.family ? typeFamilies[item.family] : null;
const familyMembers = item.family ? group.items.filter((i) => i.family === item.family) : [];

const videoBase = content?.videoFolder
  ? `${MEDIA_BASE}/${content.videoFolder}`
  : null;
const imageBase = content?.imageFolder
  ? `${MEDIA_BASE}/${content.imageFolder}`
  : null;
// 流程地圖的常駐標記：資料層只寫圖檔名，這裡補上資料夾與 BASE_URL
const pinImageBase = content?.flowMap?.pinImageFolder
  ? `${BASE}/${content.flowMap.pinImageFolder}`
  : BASE;
const flowMapPins = content?.flowMap?.pins?.map((p) => ({
  ...p,
  image: p.image ? `${pinImageBase}/${p.image}` : undefined,
}));
const hasAnyVideo = content?.methods?.some((m) => m.video || (m.videos && m.videos.length > 0)) ?? false;
const hasAnyImage = content?.methods?.some((m) => m.image || m.extraImage) ?? false;
const hasMedia = hasAnyVideo || hasAnyImage || content?.showEmptyMedia;

// 只顯示「相關影片」區的分類：隱藏流程／原理／注意事項，
// 並讓影片區延續上方標題區的背景色（不另加 bg-surface）。
const videosOnly = item.videosOnly ?? false;
// 只顯示「名詞說明」＋「相關影片」（大亂鬥用）
const termsOnly = item.termsOnly ?? false;
const isSimpleLayout = videosOnly || termsOnly;
const vidSectionClass = isSimpleLayout ? "" : "border-t border-border-soft bg-surface";
const vidRowHover = isSimpleLayout ? "hover:bg-surface" : "hover:bg-bg";
const vidBtnBg = isSimpleLayout ? "bg-surface" : "bg-bg";

const VIDEOS_PER_PAGE = 10;
// 相關影片縮圖右下角的日期徽章：YYYY-MM-DD 縮成 YY/MM/DD，縮圖空間小放不下完整年份
const shortDate = (d?: string) => (d ? d.slice(2).replace(/-/g, "/") : null);
const hasDynamicPrinciple = content?.methods?.some((m) => m.principle != null || m.principleSections?.length) ?? false;

// 只有一個方法時不渲染分頁按鈕列，此時 panel 不可宣告 role="tabpanel"，
// 否則 aria-labelledby 會指向不存在的 tab，反而讓輔助技術讀到壞掉的關聯。
const hasMethodTabs = (content?.methods?.length ?? 0) > 1;

// 分頁按鈕分組：同 group 的方法會排在同一行，並在最前面顯示分組標籤；
// 沒有設定 group 的方法全部落在同一個（無標籤）分組，維持原本單行排列。
const methodGroups: { label: string | null; items: { m: TypeMethod; i: number }[] }[] = [];
(content?.methods ?? []).forEach((m, i) => {
  const label = m.group ?? null;
  let bucket = methodGroups.find((g) => g.label === label);
  if (!bucket) {
    bucket = { label, items: [] };
    methodGroups.push(bucket);
  }
  bucket.items.push({ m, i });
});

---

<BaseLayout
  title={`${itemTitle} · ${gameLabel}`}
  description={`${itemTitle}（${item.en}）攻略說明，${gameLabel}系列。`}
  active="types"
  lang={lang}
  altPath={`/types/${id}`}
>
  {/* 麵包屑 + 標題 */}
  <section class="border-b border-border-soft">
    <div class="mx-auto max-w-[1244px] px-8 pb-12 pt-[54px]">
      <div class="mb-[22px] flex flex-wrap items-center gap-2 text-[13px] text-muted">
        <a href={href("/home", lang)} class="no-underline text-muted">{t.breadcrumbHome}</a>
        <span>/</span>
        <a href={href("/types", lang)} class="no-underline text-muted">{t.navTypes}</a>
        {family && (
          <>
            <span>/</span>
            <span>{lang === "ja" ? family.ja : family.zh}</span>
          </>
        )}
        <span>/</span>
        <span class="text-ink">{itemTitle}</span>
      </div>
      <div class="mb-2 flex items-center gap-2.5">
        <span class="font-mono text-[13px] text-accent">{group.en} · {item.no}</span>
      </div>
      <div class="mb-[18px] flex flex-wrap items-center justify-between gap-4">
        <h1 class="font-serif text-[27px] sm:text-[36px] font-medium leading-[1.12] text-ink">
          {itemTitle}
        </h1>
        <a
          href={href(`/types#${group.game}`, lang)}
          class="whitespace-nowrap text-sm text-accent no-underline"
        >
          {t.backToGameSeries.replace("{game}", gameLabel)}
        </a>
      </div>
      <p class="text-[13px] sm:text-[17px] text-muted">{content?.heroEn ?? item.en}</p>
    </div>
  </section>

  {familyMembers.length > 1 && (
    <section class="border-b border-border-soft bg-surface">
      <div class="mx-auto max-w-[1244px] px-8 py-8">
        <div class="mb-3 font-mono text-[11px] font-bold uppercase tracking-[2px] text-muted">
          {family?.en} · {lang === "ja" ? <>{family?.ja}シリーズ</> : <>{family?.zh}系列</>}
        </div>
        <LaunchFamilyNav game={group.game} members={familyMembers} currentNo={item.no} lang={lang} />
      </div>
    </section>
  )}

  {/* 主體：流程步驟（左）／原理說明＋快速示意（右）＋ 注意事項（下）。videosOnly / termsOnly 分類不顯示 */}
  {!videosOnly && !termsOnly && (
  <article class="mx-auto max-w-[1244px] px-8 pb-16 pt-10">
    <div class="grid gap-x-12 gap-y-10 md:grid-cols-[1.6fr_1fr]">
      {/* 左：流程步驟 */}
      <div class="prose-custom">
        <h2>{content?.methodsTitle ?? t.sectionMethods}</h2>
        {content?.methods ? (
          <div class="method-tabs">
            {/* 只有單一分頁時不顯示膠囊分頁按鈕列，內容改由 MethodPanelBody 的 m.name 顯示白色小標題 */}
            {content.methods.length > 1 && (
            <div role="tablist" class="mb-5 flex flex-col gap-2">
              {methodGroups.map((g) => (
                <div class="flex flex-wrap items-center gap-2">
                  {g.label && (
                    <span class="mr-1 shrink-0 text-[12px] font-medium text-muted">{g.label}</span>
                  )}
                  {g.items.map(({ m, i }) => (
                    <button
                      type="button"
                      role="tab"
                      id={`method-tab-${i}`}
                      aria-controls={`method-panel-${i}`}
                      aria-selected={i === 0 ? "true" : "false"}
                      tabindex={i === 0 ? 0 : -1}
                      data-tab={i}
                      data-tab-key={zhMethods?.[i]?.tab ?? m.tab}
                      class="method-tab cursor-pointer rounded-full border border-border-strong bg-surface px-4 py-1.5 text-sm font-medium transition-colors hover:border-brand"
                    >
                      {m.tab}
                    </button>
                  ))}
                </div>
              ))}
            </div>
            )}
            {content.methods.map((m, i) => (
              <div class="method-panel" id={hasMethodTabs ? `method-panel-${i}` : undefined} role={hasMethodTabs ? "tabpanel" : undefined} aria-labelledby={hasMethodTabs ? `method-tab-${i}` : undefined} tabindex={hasMethodTabs ? 0 : undefined} data-panel={i} data-video={m.video ?? ""} data-videos={m.videos ? JSON.stringify(m.videos) : ""} data-image={m.image ?? ""} data-extra-image={m.extraImage ?? ""} data-hide-demo={m.hideDemo ? "1" : ""} data-principle={principleHtml(m.principle ?? "")} data-principle-sections={principleSectionsHtml(m.principleSections)} data-principle-extra={principleExtraHtml(m.principleExtra)} hidden={i !== 0}>
                {m.subTabs ? (
                  <div class="subtab-group">
                    <div role="tablist" class="subtab-tabs mb-4 flex flex-wrap gap-2">
                      {m.subTabs.map((sub, j) => (
                        <button
                          type="button"
                          role="tab"
                          id={`subtab-${i}-${j}`}
                          aria-controls={`subpanel-${i}-${j}`}
                          data-subtab={j}
                          aria-selected={j === 0 ? "true" : "false"}
                          tabindex={j === 0 ? 0 : -1}
                          class="method-subtab cursor-pointer rounded-full border border-border-strong bg-surface px-3.5 py-1 text-[13px] font-medium transition-colors hover:border-brand"
                        >
                          {sub.tab}
                        </button>
                      ))}
                    </div>
                    {m.subTabs.map((sub, j) => (
                      <div class="subtab-panel" id={`subpanel-${i}-${j}`} role="tabpanel" aria-labelledby={`subtab-${i}-${j}`} tabindex="0" data-subpanel={j} hidden={j !== 0}>
                        <MethodPanelBody method={sub} mapGroup={`${i}-${j}`} lang={lang} />
                      </div>
                    ))}
                  </div>
                ) : (
                  <MethodPanelBody method={m} mapGroup={String(i)} lang={lang} />
                )}
              </div>
            ))}
          </div>
        ) : (
          <>
            <p class="note">{t.emptySteps}</p>
            <ol>
              <li>{t.stepPlaceholder1}</li>
              <li>{t.stepPlaceholder2}</li>
              <li>{t.stepPlaceholder3}</li>
            </ol>
          </>
        )}
      </div>

      {/* 右：B 原理說明 + C 快速示意 */}
      <div class="flex flex-col gap-8">
        {/* B: 原理說明 */}
        <div class="prose-custom">
          <h2>{content?.principleTitle ?? t.sectionPrinciple}</h2>
          {hasDynamicPrinciple ? (
            // 兩個容器都固定生成、用 hidden 切換，而非建置時只挑一個：
            // 分頁彼此獨立決定要用 principle 還是 principleSections（例如本頁
            // 第一個分頁 MSD 用純文字，SID 用可收合分段），若只依 methods[0]
            // 決定要不要生成 #principle-sections，其他分頁切過去時 JS 會找不到
            // 容器可寫入，原理說明整欄變空白。
            <>
              <p
                id="principle-text"
                class:list={{ hidden: !!content?.methods?.[0]?.principleSections }}
                set:html={principleHtml(content?.methods?.[0]?.principle ?? "")}
              />
              <div
                id="principle-sections"
                class:list={{ hidden: !content?.methods?.[0]?.principleSections }}
                set:html={principleSectionsHtml(content?.methods?.[0]?.principleSections)}
              />
            </>
          ) : content?.principleSections ? (
            content.principleSections.map((sec) => {
              const body = (
                <>
                  {sec.text && (
                    <p>
                      {parseName(sec.text).map((seg) =>
                        seg.name
                          ? <u style="text-decoration-color: white; text-underline-offset: 3px;">{seg.text}</u>
                          : parseAccent(seg.text).map((a) =>
                              a.accent ? <span class="text-accent">{a.text}</span> : a.text
                            )
                      )}
                    </p>
                  )}
                  {sec.items && (
                    <ul>
                      {sec.items.map((it) => {
                        const { text, sub } = stepParts(it);
                        return (
                          <li>
                            {parseStep(text).map((seg) =>
                              seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
                                : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
                                : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
                            )}
                            {sub.length > 0 && (
                              <ul class="step-sub">
                                {sub.map((d) => (
                                  <li>
                                    {parseStep(d).map((seg) =>
                                      seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
                                        : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
                                        : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
                                    )}
                                  </li>
                                ))}
                              </ul>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </>
              );
              return sec.collapsible ? (
                <details class="principle-collapse">
                  <summary class="principle-collapse-summary">
                    <span class="principle-block-title principle-collapse-title">{sec.title}</span>
                    <svg class="principle-collapse-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </summary>
                  <div class="principle-collapse-body">{body}</div>
                </details>
              ) : (
                <div class="principle-block">
                  {sec.title && <div class="principle-block-title">{sec.title}</div>}
                  {body}
                </div>
              );
            })
          ) : content?.principleItems ? (
            <ul>
              {content.principleItems.map((item) => (
                <li class={/^[①②③④⑤⑥⑦⑧⑨⑩]/.test(item) ? "principle-sub" : ""}>
                  {parseAccent(item).map((seg) => seg.accent ? <span class="text-accent">{seg.text}</span> : seg.text)}
                </li>
              ))}
            </ul>
          ) : (
            <p>
              {content?.principle ? (
                parseName(content.principle).map((seg) =>
                  seg.name
                    ? <u style="text-decoration-color: white; text-underline-offset: 3px;">{seg.text}</u>
                    : parseAccent(seg.text).map((a) =>
                        a.accent ? <span class="text-accent">{a.text}</span> : a.text
                      )
                )
              ) : (
                t.principleFallbackTemplate.replace("{name}", itemTitle)
              )}
            </p>
          )}
          {content?.principleNote && (
            <p class="mt-3 text-[13px] leading-[1.7] text-muted">{content.principleNote}</p>
          )}
          {hasDynamicPrinciple && (
            <div id="principle-extra" set:html={principleExtraHtml(content?.methods?.[0]?.principleExtra)} />
          )}
          {content?.applications && content.applications.placement !== "notes" && (
            <button type="button" class="applications-open" data-applications-open>
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3.5" y="4.5" width="17" height="15" rx="2"></rect>
                <path d="M3.5 9.5h17M9 9.5v10" stroke-linecap="round"></path>
              </svg>
              {content.applications.label ?? t.applicationsLabel}
            </button>
          )}
        </div>

        {content?.toolCta && (
          <aside class="tool-cta" aria-label={content.toolCta.title}>
            <div class="tool-cta-kicker">
              <span class="tool-cta-dot" aria-hidden="true"></span>
              {content.toolCta.kicker ?? t.toolCtaKicker}
            </div>
            <h2 class="tool-cta-title">{content.toolCta.title}</h2>
            <p class="tool-cta-desc">{content.toolCta.description}</p>
            <div class="tool-cta-actions">
              <a class="tool-cta-primary" href={href(content.toolCta.primary.path, lang)}>
                {content.toolCta.primary.label}
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="flex-none" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </a>
              {content.toolCta.secondary && (
                <a class="tool-cta-secondary" href={content.toolCta.secondary.url} target="_blank" rel="noopener">
                  {content.toolCta.secondary.label}
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" class="flex-none" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              )}
            </div>
          </aside>
        )}

        {/* C: 快速示意（影片或圖片，隨分頁切換）。整塊在頁面層級渲染一次；個別分頁若設了
             hideDemo，JS 在切分頁時會把這個 wrapper 整個隱藏（見下方 updateMedia） */}
        {!content?.model3d && hasMedia && (
          <div class="prose-custom" id="demo-section">
            <h2>{t.sectionDemo}</h2>
            <div
              id="demo-media-wrap"
              data-video-base={videoBase}
              data-image-base={imageBase}
              class="relative overflow-hidden rounded-xl bg-sand"
            >
              <video
                id="demo-video"
                controls
                loop
                muted
                playsinline
                class="hidden w-full rounded-xl"
              ></video>
              <button type="button" id="demo-image-trigger" class="demo-image-trigger hidden" aria-label={t.zoomDemoImage}>
                <img
                  id="demo-image"
                  alt={t.demoImageAlt}
                  loading="lazy"
                  class="w-full rounded-xl"
                />
                <span class="demo-zoom-hint" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /><path d="M11 8v6M8 11h6" /></svg>
                </span>
              </button>
              <div
                id="demo-media-empty"
                class="hidden flex-col items-center justify-center py-10 text-center text-[14px] text-muted"
              >
                <span>{t.emptyDemo}</span>
              </div>
            </div>
            {/* 多支影片上下排列＋各自標題（例：Zuggle 分頁需同時示意 Invizuggle 與
                GDI Chain 兩種手法）。與上面單一影片的 demo-media-wrap 互斥顯示，
                由 updateMedia() 依 panel 是否設定 m.videos 決定顯示哪一個 */}
            <div id="demo-video-stack" class="flex flex-col gap-4" hidden></div>
            {/* 影片下方的補充圖解（例如 SLD 的逐幀流程圖），與影片並存、同尺寸容器；
                圖片路徑沿用上面 demo-media-wrap 的 imageBase，不重複宣告 */}
            <div
              id="demo-extra-wrap"
              class="relative mt-3 overflow-hidden rounded-xl bg-sand"
              hidden
            >
              <button type="button" id="demo-extra-trigger" class="demo-image-trigger" aria-label={t.zoomFlowImage}>
                <img
                  id="demo-extra-image"
                  alt={t.flowImageAlt}
                  loading="lazy"
                  class="w-full rounded-xl"
                />
                <span class="demo-zoom-hint" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /><path d="M11 8v6M8 11h6" /></svg>
                </span>
              </button>
            </div>
          </div>
        )}
      </div>
    </div>

    {hasMedia && (
      <div class="demo-lightbox" id="demo-lightbox" data-default-title={t.demoImageAlt} hidden>
        <button
          class="demo-lightbox-backdrop"
          type="button"
          data-demo-lightbox-close
          tabindex="-1"
          aria-hidden="true"
        ></button>
        <div class="demo-lightbox-dialog" role="dialog" aria-modal="true" aria-labelledby="demo-lightbox-title">
          <div class="demo-lightbox-head">
            <h2 id="demo-lightbox-title">{t.demoImageAlt}</h2>
            <button type="button" data-demo-lightbox-close aria-label={t.closePreview}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 6 12 12M18 6 6 18" />
              </svg>
            </button>
          </div>
          <div class="demo-lightbox-image">
            <img src="" alt="" id="demo-lightbox-image" />
          </div>
        </div>
      </div>
    )}

    {/* 3D 模型參考：獨立全寬區塊（不塞進右欄，避免只有 C 欄寬度太窄），置於注意事項之上 */}
    {content?.model3d && (
      <div class="prose-custom mt-10 border-t border-border-soft pt-10">
        <h2>{t.sectionModel}</h2>
        <Model3DViewer
          lang={lang}
          src={content.model3d.src}
          alt={content.model3d.alt}
          poster={content.model3d.poster}
          posterAlt={content.model3d.posterAlt}
          cameraOrbit={content.model3d.cameraOrbit}
          cameraTarget={content.model3d.cameraTarget}
          overviewOrbit={content.model3d.overviewOrbit}
          overviewTarget={content.model3d.overviewTarget}
          topOrbit={content.model3d.topOrbit}
          topTarget={content.model3d.topTarget}
          layoutSrc={content.model3d.layoutSrc}
          transparencyMaterials={content.model3d.transparencyMaterials}
          transparencyOpacity={content.model3d.transparencyOpacity}
          aspectRatio="2/1"
          mobileAspectRatio="4/3"
        />
        {content.model3d.legend && content.model3d.legend.length > 0 && (
          <>
            <details class="model3d-legend mt-4" open>
              <summary class="cursor-pointer text-[12px] font-medium text-ink select-none">
                {t.model3dLegend}
              </summary>
              <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5">
                {content.model3d.legend.map((item) => (
                  <span class="inline-flex items-center gap-1.5 text-[12px] text-muted">
                    <span
                      class="inline-block h-3 w-3 flex-none rounded-[3px] shadow-[0_0_0_1px_var(--border-strong)]"
                      style={`background:${item.color}`}
                    ></span>
                    {item.label}
                  </span>
                ))}
              </div>
            </details>
            <script is:inline>
              // 手機（≤767px）預設收合圖例；桌機維持原本一直展開的行為。用「同步執行的
              // classic script」在瀏覽器繪製前就移掉 open，避免手機上先展開又收合的閃爍。
              (function () {
                var d = document.currentScript.previousElementSibling;
                if (d && d.tagName === "DETAILS" && window.matchMedia("(max-width: 767px)").matches) {
                  d.removeAttribute("open");
                }
              })();
            </script>
          </>
        )}
        <div class="mt-3 text-[13px] leading-[1.6] text-muted">
          <div class="mb-1.5 text-[12px] font-medium text-ink">{t.sectionControls}</div>
          <ul>
            <li>{t.model3dRotate}</li>
            <li>{t.model3dZoom}</li>
            <li>{t.model3dPan}</li>
            <li>{t.model3dButtons}</li>
          </ul>
        </div>
      </div>
    )}

    {/* 參照流程地圖：獨立全寬區塊（與 3D 模型同層級、可並存），置於注意事項之上。
        點擊步驟前的單選按鈕（.flow-step-radio）會在這張地圖上顯示該步驟的行為 */}
    {content?.flowMap && (
      <div class="prose-custom mt-10 border-t border-border-soft pt-10">
        <h2>{content.flowMap.title ?? t.sectionFlowMap}</h2>
        <FlowMapViewer
          layers={content.flowMap.game === "botw"
            ? [{ id: "surface", label: t.flowMapLayerSurface, image: "/flow-map/botw/surface.webp" }]
            : undefined}
          defaultLayer={content.flowMap.defaultLayer}
          note={content.flowMap.note}
          grid={content.flowMap.grid}
          pins={flowMapPins}
          lang={lang}
        />
        <div class="mt-3 text-[13px] leading-[1.6] text-muted">
          <div class="mb-1.5 text-[12px] font-medium text-ink">{t.sectionControls}</div>
          <ul>
            <li>{t.flowMapSteps}</li>
            <li>{t.flowMapPan}</li>
            <li>{t.model3dZoom}</li>
            <li>{t.flowMapLayers}</li>
          </ul>
        </div>
      </div>
    )}

    {/* 注意事項：跨兩欄 */}
    <div class="prose-custom mt-10 border-t border-border-soft pt-10">
      <h2>{content?.notesTitle ?? t.sectionNotes}</h2>
      <ul>
        {content?.notes ? (
          content.notes.map((n) => (
            <li>
              {parseStep(n.text).map((seg) =>
                seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
                  : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
                  : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
              )}
              {n.sub && n.sub.length > 0 && (
                <ul class="note-sub">
                  {n.sub.map((s) => (
                    <li>
                      {parseStep(s).map((seg) =>
                        seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
                          : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
                          : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        ) : (
          <>
            <li>{t.placeholderPage}</li>
            <li>{t.askOnYoutube}</li>
          </>
        )}
      </ul>
      {content?.closing && <p class="mt-1 text-[15px] text-muted">{content.closing}</p>}
      {(content?.faqLink || (content?.applications && content.applications.placement === "notes")) && (
        <div class="mt-6 flex flex-wrap items-center gap-3">
          {content?.faqLink && (
            <a
              href={href(content.faqLink.path, lang)}
              class="faq-btn inline-flex items-center gap-2 no-underline"
            >
              {content.faqLink.label}
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="flex-none">
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </a>
          )}
          {content?.applications && content.applications.placement === "notes" && (
            <button type="button" class="applications-open applications-open--inline" data-applications-open>
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3.5" y="4.5" width="17" height="15" rx="2"></rect>
                <path d="M3.5 9.5h17M9 9.5v10" stroke-linecap="round"></path>
              </svg>
              {content.applications.label ?? t.applicationsLabel}
            </button>
          )}
        </div>
      )}
    </div>
  </article>
  )}

  {/* 應用一覽彈出視窗：由右欄原理說明下方的按鈕開啟 */}
  {content?.applications && (
    <div class="applications-modal" data-applications-modal hidden>
      <button
        type="button"
        class="applications-backdrop"
        tabindex="-1"
        aria-hidden="true"
        data-applications-close
      ></button>

      <div class="applications-dialog" role="dialog" aria-modal="true" aria-labelledby="applications-title">
        <div class="applications-head">
          <div>
            <span>{itemTitle} · {item.en}</span>
            <h2 id="applications-title">{content.applications.title ?? content.applications.label ?? t.applicationsLabel}</h2>
          </div>
          <button type="button" data-applications-close aria-label={t.closeAppList}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>

        <div class="applications-body">
          {content.applications.intro && (
            <p class="applications-intro">{content.applications.intro}</p>
          )}

          {content.applications.groups.map((g) => (
            <section class="applications-group">
              <h3>{g.title}</h3>
              {g.intro && <p class="applications-group-intro">{g.intro}</p>}

              {g.columns ? (
                <>
                  {/* 對照表：直式卡片，每個效果一列，右側用小標籤標示適用模式。
                      不用 <table> 是因為說明文字長，窄螢幕上表格會被迫橫向捲動。 */}
                  <div class="applications-legend" aria-hidden="true">
                    {g.columns.map((c) => <span>{c}</span>)}
                  </div>
                  <ul class="applications-matrix">
                    {g.items.map((it) => (
                      <li>
                        <div class="applications-matrix-main">
                          <span class="applications-name">{it.name}</span>
                          {it.desc && <span class="applications-desc">{it.desc}</span>}
                        </div>
                        <div class="applications-marks">
                          {g.columns!.map((c, ci) => (
                            <span
                              class:list={["applications-mark", it.marks?.[ci] ? "is-on" : "is-off"]}
                            >
                              <span class="applications-mark-label">{c}</span>
                              <span class="applications-mark-dot" aria-hidden="true">
                                {it.marks?.[ci] ? "●" : "—"}
                              </span>
                              <span class="sr-only">{it.marks?.[ci] ? "適用" : "不適用"}</span>
                            </span>
                          ))}
                        </div>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <ul class="applications-list">
                  {g.items.map((it) => (
                    <li>
                      <span class="applications-name">{it.name}</span>
                      {it.desc && <span class="applications-desc">{it.desc}</span>}
                    </li>
                  ))}
                </ul>
              )}

              {g.note && (
                Array.isArray(g.note) ? (
                  <div class="applications-note">
                    {g.note.map((n) => <p>{n}</p>)}
                  </div>
                ) : (
                  <div class="applications-note"><p>{g.note}</p></div>
                )
              )}
            </section>
          ))}
        </div>
      </div>
    </div>
  )}

  {/* termsOnly 頁的名詞說明 */}
  {termsOnly && (
    <div class="border-b border-border-soft">
      <div class="mx-auto max-w-[1244px] px-8 pb-12 pt-10">
        <h2 class="mb-8 font-serif text-[22px] font-medium text-ink">{t.sectionTerms}</h2>
        {content?.termGroups && content.termGroups.length > 0 ? (
          content.termGroups.map((tg: TermGroup) => (
            <div class="mb-10 last:mb-0">
              <div class="mb-3 text-[11px] font-bold uppercase tracking-[1.4px] text-accent">{tg.title}</div>
              <div class="term-list">
                {tg.terms.map((term) => (
                  <details class="term-item">
                    <summary class="term-summary">
                      <span class="term-label">
                        {term.zh}
                        {term.en && <span class="term-en"> / {term.en}</span>}
                        {term.ja && <span class="term-en"> （{term.ja}）</span>}
                      </span>
                      <svg class="term-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </summary>
                    <div class="term-answer">
                      {term.desc
                        ? <p>{term.desc}</p>
                        : <p class="term-empty">{t.emptyPrincipleShort}</p>
                      }
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))
        ) : (
          <p class="text-[15px] text-muted">{t.emptyTerms}</p>
        )}
      </div>
    </div>
  )}

  {/* videosOnly 頁的簡介與說明 */}
  {videosOnly && (
    <div class="border-b border-border-soft">
      <div class="mx-auto max-w-[1244px] px-8 pb-10 pt-10">
        <h2 class="mb-4 font-serif text-[22px] font-medium text-ink">{t.sectionIntro}</h2>
        {content?.intro ? (
          <p class="text-[16px] leading-[1.8] text-ink">{content.intro}</p>
        ) : (
          <p class="text-[15px] text-muted">{t.emptyPrinciple}</p>
        )}
      </div>
    </div>
  )}

  {/* videosOnly 頁的分類影片（例如「個別角色」依角色分組） */}
  {content?.videoGroups && content.videoGroups.length > 0 && (
    <div class={vidSectionClass}>
      <div class="mx-auto max-w-[1244px] px-8 pb-16 pt-10">
        {!videosOnly && (
          <div class="mb-6">
            <div class="text-[11px] font-bold uppercase tracking-[2px] text-accent">
              {t.sectionVideos}
            </div>
            <h2 class="mt-2 font-serif text-[26px] font-medium text-ink">
              {itemTitle} {t.relatedVideosSuffix}
            </h2>
          </div>
        )}
        <div class="video-group-tabs">
          <div role="tablist" class="mb-5 flex flex-wrap gap-2">
            {content.videoGroups.map((vg: VideoGroup, i) => (
              <button
                type="button"
                role="tab"
                id={`vg-tab-${i}`}
                aria-controls={`vg-panel-${i}`}
                data-vg-tab={i}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class="method-tab cursor-pointer rounded-full border border-border-strong bg-surface px-4 py-1.5 text-sm font-medium transition-colors hover:border-brand"
              >
                {vg.title}
              </button>
            ))}
          </div>
          {content.videoGroups.map((vg: VideoGroup, i) => (
            <div class="video-group-panel" id={`vg-panel-${i}`} role="tabpanel" aria-labelledby={`vg-tab-${i}`} tabindex="0" data-vg-panel={i} hidden={i !== 0}>
              {vg.videos.map((v) => (
                <a
                  href={ytWatch(v.id, v.at)}
                  target="_blank"
                  rel="noopener"
                  class={`flex cursor-pointer items-center gap-4 border-b border-border-soft py-[14px] no-underline transition-colors ${vidRowHover}`}
                >
                  <div class="relative flex-none">
                    <img
                      src={ytThumb(v.id)}
                      alt={v.title}
                      loading="lazy"
                      class="h-[79px] w-[140px] rounded-lg bg-sand object-cover"
                    />
                    {shortDate(v.publishedAt) && (
                      <span class="absolute bottom-[5px] right-[5px] rounded bg-black/70 px-[5px] py-[1px] font-mono text-[10px] leading-[1.4] tabular-nums tracking-wide text-white">
                        {shortDate(v.publishedAt)}
                      </span>
                    )}
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="line-clamp-2 font-serif text-[17px] font-medium leading-[1.3] text-ink">
                      {v.title}
                    </div>
                    <div class="mt-1 flex items-center gap-1.5 text-[13px] text-muted">
                      <svg viewBox="0 0 24 24" fill="currentColor" width="11" height="11">
                        <polygon points="6,4 20,12 6,20"></polygon>
                      </svg>
                      {v.desc || "YouTube"}
                    </div>
                  </div>
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" class="flex-none text-muted">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  {/* 相關影片 */}
  {content?.videos && content.videos.length > 0 ? (
    <section class={vidSectionClass}>
      <div class="mx-auto max-w-[1244px] px-8 pb-16 pt-10">
        <div class="mb-6 flex items-end justify-between gap-5">
          <div>
            <div class="text-[11px] font-bold uppercase tracking-[2px] text-accent">
              {t.sectionVideos}
            </div>
            <h2 class="mt-2 font-serif text-[26px] font-medium text-ink">
              {itemTitle} {t.relatedVideosSuffix}
            </h2>
          </div>
          {content.videos.length > VIDEOS_PER_PAGE && (
            <span
              id="vid-page-label"
              class="whitespace-nowrap text-[13px] text-muted"
              data-page-label-template={t.videoPageLabel}
            ></span>
          )}
        </div>
        <div id="related-videos">
          {content.videos.map((v, i) => (
            <a
              href={ytWatch(v.id, v.at)}
              target="_blank"
              rel="noopener"
              data-vindex={i}
              class={`related-video flex cursor-pointer items-center gap-4 border-b border-border-soft py-[14px] no-underline transition-colors ${vidRowHover}`}
            >
              <div class="relative flex-none">
                <img
                  src={ytThumb(v.id)}
                  alt={v.title}
                  loading="lazy"
                  class="h-[79px] w-[140px] rounded-lg bg-sand object-cover"
                />
                {shortDate(v.publishedAt) && (
                  <span class="absolute bottom-[5px] right-[5px] rounded bg-black/70 px-[5px] py-[1px] font-mono text-[10px] leading-[1.4] tabular-nums tracking-wide text-white">
                    {shortDate(v.publishedAt)}
                  </span>
                )}
              </div>
              <div class="min-w-0 flex-1">
                <div class="line-clamp-2 font-serif text-[17px] font-medium leading-[1.3] text-ink">
                  {v.title}
                </div>
                <div class="mt-1 flex items-center gap-1.5 text-[13px] text-muted">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="11" height="11">
                    <polygon points="6,4 20,12 6,20"></polygon>
                  </svg>
                  {v.desc || "YouTube"}
                </div>
              </div>
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" class="flex-none text-muted">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          ))}
        </div>

        {content.videos.length > VIDEOS_PER_PAGE && (
          <div class="mt-8 flex items-center justify-between gap-2 sm:gap-4">
            <button
              id="vid-prev"
              type="button"
              class={`whitespace-nowrap rounded-[10px] border border-border-strong ${vidBtnBg} px-3 py-1.5 text-[13px] sm:px-5 sm:py-2 sm:text-[15px] font-medium text-ink transition-colors hover:border-brand hover:text-brand disabled:cursor-not-allowed disabled:opacity-40`}
            >
              {t.videoPrevPage}
            </button>
            <span id="vid-page-info" class="whitespace-nowrap text-[12px] sm:text-sm text-muted"></span>
            <button
              id="vid-next"
              type="button"
              class={`whitespace-nowrap rounded-[10px] border border-border-strong ${vidBtnBg} px-3 py-1.5 text-[13px] sm:px-5 sm:py-2 sm:text-[15px] font-medium text-ink transition-colors hover:border-brand hover:text-brand disabled:cursor-not-allowed disabled:opacity-40`}
            >
              {t.videoNextPage}
            </button>
          </div>
        )}
      </div>
    </section>
  ) : !(content?.videoGroups && content.videoGroups.length > 0) && (
    <section class={vidSectionClass}>
      <div class="mx-auto max-w-[1244px] px-8 py-12">
        <div class="text-[11px] font-bold uppercase tracking-[2px] text-accent">{t.sectionVideos}</div>
        <p class="mt-3 text-[15px] text-muted">{t.emptyVideos}</p>
      </div>
    </section>
  )}
</BaseLayout>

<style is:global>
  .prose-custom {
    color: var(--text);
    line-height: 1.75;
    font-size: 16px;
  }
  .prose-custom h2 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 500;
    color: var(--ink);
    margin-top: 0;
    margin-bottom: 0.7em;
    padding-bottom: 0.4em;
    border-bottom: 1px solid var(--border-soft);
  }
  .prose-custom p,
  .prose-custom ul,
  .prose-custom ol {
    margin-bottom: 1.1em;
  }
  .prose-custom ul,
  .prose-custom ol {
    padding-left: 1.6em;
  }
  .prose-custom ol {
    list-style: decimal;
  }
  .prose-custom ul {
    list-style: disc;
  }
  .prose-custom li::marker {
    color: var(--accent);
  }

  /* 步驟中的橙色文字 */
  .accent-text {
    color: var(--accent);
    font-weight: 500;
  }

  /* 步驟中連到其他主題頁的橙色連結 */
  .accent-link {
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }
  .accent-link:hover {
    opacity: 0.8;
  }
  /* 跳到同頁其他分頁的按鈕（重置原生 button 樣式，外觀與 .accent-link 一致） */
  button.accent-link {
    border: none;
    background: none;
    padding: 0;
    margin: 0;
    font: inherit;
    text-align: left;
  }

  /* 注意事項的子清單 */
  .prose-custom .note-sub {
    list-style: none;
    padding-left: 1em;
    margin-top: 0.5em;
    margin-bottom: 0;
  }
  .prose-custom .note-sub li {
    margin-bottom: 0.3em;
    color: var(--muted);
    font-size: 15px;
  }
  .prose-custom .note-sub li::marker {
    content: none;
  }

  /* 步驟內的巢狀子項目（・、(1)(2) 開頭） */
  .prose-custom .step-sub {
    list-style: none;
    padding-left: 0;
    margin-top: 0.5em;
    margin-bottom: 0;
  }
  .prose-custom .step-sub li {
    margin-bottom: 0.35em;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }
  .prose-custom .step-sub li::marker {
    content: none;
  }
  .prose-custom .step-sub .step-sub-deep {
    padding-left: 1.2em;
  }

  /* 「參照流程地圖」的步驟單選按鈕：跟在步驟編號後、步驟文字前的圓形按鈕，
     點擊後頁面下方的流程地圖會顯示該步驟的行為（見 FlowMapViewer.astro） */
  .flow-step-radio {
    appearance: none;
    -webkit-appearance: none;
    display: inline-block;
    width: 16px;
    height: 16px;
    margin: 0 0.5em 0 0;
    vertical-align: -3px;
    border: 1.5px solid var(--muted);
    border-radius: 50%;
    background: var(--surface);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
  }
  .flow-step-radio:hover {
    border-color: var(--accent);
  }
  .flow-step-radio:checked {
    border-color: var(--accent);
    background: var(--accent);
    /* 內圈留一圈底色，做出實心圓點的樣子 */
    box-shadow: inset 0 0 0 3px var(--surface);
  }
  .flow-step-radio:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* 原理說明的次層條列（①②③ 開頭） */
  .prose-custom .principle-sub {
    list-style: none;
    padding-left: 0.8em;
    margin-bottom: 0.25em;
  }

  /* 原理說明依副標題分段（例："歷史"／"原理"） */
  .prose-custom .principle-block + .principle-block,
  .prose-custom .principle-block + .principle-collapse,
  .prose-custom .principle-collapse + .principle-block,
  .prose-custom .principle-collapse + .principle-collapse {
    margin-top: 1.2em;
  }
  .prose-custom .principle-block-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 0.5em;
    text-transform: uppercase;
  }

  /* 原理說明的可收合段落（手風琴樣式，同「轉存格 Q&A」） */
  .prose-custom .principle-collapse {
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    padding: 0 14px;
  }
  .prose-custom .principle-collapse-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .prose-custom .principle-collapse-summary::-webkit-details-marker {
    display: none;
  }
  .prose-custom .principle-collapse-title {
    margin-bottom: 0;
  }
  .prose-custom .principle-collapse-chevron {
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 0.2s;
  }
  .prose-custom details.principle-collapse[open] .principle-collapse-chevron {
    transform: rotate(180deg);
  }
  .prose-custom .principle-collapse-body {
    padding: 0 0 14px;
  }

  /* 原理說明中的人名白色底線 */
  .name-underline {
    text-decoration: underline 2px white;
    text-underline-offset: 3px;
  }
  .prose-custom li {
    margin-bottom: 0.5em;
  }
  .prose-custom ol li {
    padding-left: 0.2em;
  }
  .prose-custom u {
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .prose-custom .note {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 14px;
    color: var(--muted);
  }

  /* 多區塊步驟的子標題 */
  .method-section + .method-section {
    margin-top: 1.6em;
    padding-top: 1.4em;
    border-top: 1px solid var(--border-soft);
  }
  .method-section-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 0.75em;
    text-transform: uppercase;
  }
  /* 快速示意多支影片各自的標題，沿用同一套橙色小標語彙，但保留原始大小寫 */
  .demo-video-item-title {
    margin-bottom: 0.5em;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  /* 區塊標題內的重點：以底線強調（標題本身已是橙色） */
  .method-section-title .accent-strong {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* 分頁內只有單一區塊時，標題改為白字（與 m.name 一致），只有多區塊才用橙色標題區分 */
  .method-section-title-single {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.75em;
  }
  .method-section-title-single .accent-strong {
    color: var(--accent);
  }
  .method-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 0.75em;
  }
  .method-section-head .method-section-title,
  .method-section-head .method-section-title-single {
    margin-bottom: 0;
  }
  /* 小節專屬教學影片連結：與相關影片列表沿用同一個播放三角形圖示 */
  .section-video-link {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--accent);
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 160ms, background-color 160ms;
  }
  .section-video-link:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .section-video-link svg {
    flex: none;
  }

  /* 流程步驟的可收合小節（手風琴樣式，用於單一分頁內方法過多時，
     標題與適合版本先收合列出，展開才顯示詳細步驟；同「原理說明」的 principle-collapse） */
  .method-section-collapse {
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    padding: 14px 16px;
  }
  .method-section + .method-section-collapse,
  .method-section-collapse + .method-section,
  .method-section-collapse + .method-section-collapse {
    margin-top: 1em;
  }
  .method-section-collapse-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .method-section-collapse-summary::-webkit-details-marker {
    display: none;
  }
  .method-section-collapse-summary .method-section-head {
    flex: 1 1 auto;
    min-width: 0;
    margin-bottom: 0;
  }
  .method-section-collapse-tags {
    flex: none;
  }
  .method-section-collapse-tags .mb-3 {
    margin-bottom: 0;
  }
  .method-section-collapse-chevron {
    flex: none;
    color: var(--muted);
    transition: transform 0.2s;
  }
  .method-section-collapse[open] .method-section-collapse-chevron {
    transform: rotate(180deg);
  }
  .method-section-collapse-body {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border-soft);
  }

  /* 右欄工具導引卡片 */
  .tool-cta {
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent) 8%, transparent), transparent 52%),
      var(--surface);
    padding: 18px;
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 12%, transparent);
  }
  .tool-cta-kicker {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 10px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tool-cta-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .tool-cta-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.25;
  }
  .tool-cta-desc {
    margin: 9px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
  }
  .tool-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 16px;
  }
  .tool-cta-primary,
  .tool-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 38px;
    border-radius: 8px;
    padding: 8px 13px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: border-color 0.16s, background-color 0.16s, color 0.16s;
  }
  .tool-cta-primary {
    border: 1px solid var(--brand);
    background: var(--brand);
    color: #f6f6f4;
  }
  .tool-cta-primary:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: #f6f6f4;
  }
  .tool-cta-secondary {
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--surface) 78%, var(--bg));
    color: var(--ink);
  }
  .tool-cta-secondary:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  @media (max-width: 520px) {
    .tool-cta {
      padding: 16px;
    }
    .tool-cta-actions {
      flex-direction: column;
    }
    .tool-cta-primary,
    .tool-cta-secondary {
      width: 100%;
    }
  }

  /* Q&A 按鈕 */
  .faq-btn {
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--ink);
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 15px;
    font-weight: 500;
    transition: border-color 0.15s, color 0.15s;
  }
  .faq-btn:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  /* ── 應用一覽：右欄按鈕 + 彈出視窗 ───────────────────────────── */
  .applications-open {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 18px;
    padding: 9px 16px;
    cursor: pointer;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    transition: border-color 0.15s, color 0.15s;
  }
  .applications-open:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  /* 放在注意事項區、跟 faq-btn 並排時：外層 flex 已經有 gap，
     不需要 .applications-open 原本為了獨立站在原理說明下方留的頂部間距 */
  .applications-open--inline {
    margin-top: 0;
  }
  .applications-open svg {
    flex: none;
    color: var(--accent);
  }

  .applications-modal[hidden] {
    display: none;
  }
  .applications-modal {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: grid;
    padding: 24px;
    place-items: center;
  }
  .applications-backdrop {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: color-mix(in srgb, #000 62%, transparent);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }
  .applications-dialog {
    position: relative;
    display: flex;
    width: min(760px, 100%);
    max-height: min(82vh, 780px);
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    background: var(--bg);
    box-shadow: 0 26px 64px rgb(0 0 0 / 0.32);
  }

  .applications-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--border-soft);
    background: var(--surface);
  }
  .applications-head span {
    display: block;
    margin-bottom: 3px;
    color: var(--accent);
    font-family: ui-monospace, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  .applications-head h2 {
    margin: 0;
    font-family: var(--font-serif, Georgia, serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--ink);
  }
  .applications-head button {
    display: grid;
    width: 34px;
    height: 34px;
    flex: none;
    cursor: pointer;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 9px;
    background: var(--bg);
    color: var(--muted);
    transition: border-color 0.15s, color 0.15s;
  }
  .applications-head button:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .applications-head svg {
    width: 16px;
    height: 16px;
  }

  .applications-body {
    overflow-y: auto;
    padding: 22px;
    overscroll-behavior: contain;
  }
  .applications-intro {
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.75;
    color: var(--muted);
  }

  .applications-group + .applications-group {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--border-soft);
  }
  .applications-group h3 {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
    text-transform: uppercase;
  }
  .applications-group-intro {
    margin: 0 0 14px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
  }

  /* 定義清單：名稱一行、說明一行 */
  .applications-list {
    display: flex;
    flex-direction: column;
    margin: 12px 0 0;
    padding: 0;
    gap: 2px;
    list-style: none;
  }
  .applications-list li {
    padding: 10px 12px;
    border-radius: 9px;
    background: var(--surface);
  }
  .applications-name {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .applications-desc {
    display: block;
    margin-top: 3px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
  }

  /* 對照表：左側效果、右側各模式的適用標記 */
  .applications-legend {
    display: none;
  }
  .applications-matrix {
    display: flex;
    flex-direction: column;
    margin: 12px 0 0;
    padding: 0;
    gap: 2px;
    list-style: none;
  }
  .applications-matrix li {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 12px;
    border-radius: 9px;
    background: var(--surface);
  }
  .applications-matrix-main {
    min-width: 0;
  }
  .applications-marks {
    display: flex;
    flex: none;
    gap: 6px;
  }
  .applications-mark {
    display: flex;
    min-width: 52px;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 4px 8px;
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    background: var(--bg);
  }
  .applications-mark-label {
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .applications-mark-dot {
    font-size: 11px;
    line-height: 1;
    color: var(--border-strong);
  }
  .applications-mark.is-on {
    border-color: color-mix(in srgb, var(--accent) 42%, transparent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }
  .applications-mark.is-on .applications-mark-label {
    color: var(--ink);
    font-weight: 600;
  }
  .applications-mark.is-on .applications-mark-dot {
    color: var(--accent);
  }

  .applications-note {
    margin-top: 12px;
  }
  .applications-note p {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
  }
  .applications-note p + p {
    margin-top: 3px;
  }

  @media (max-width: 620px) {
    .applications-modal {
      padding: 0;
      place-items: end stretch;
    }
    .applications-dialog {
      width: 100%;
      max-height: 90svh;
      border-width: 1px 0 0;
      border-radius: 16px 16px 0 0;
    }
    .applications-head,
    .applications-body {
      padding-inline: 16px;
    }
    /* 窄螢幕改為上下堆疊：說明佔滿寬度，標記列移到下方，避免文字被擠成細長條 */
    .applications-matrix li {
      flex-direction: column;
      gap: 9px;
    }
    .applications-marks {
      width: 100%;
    }
    .applications-mark {
      flex: 1 1 0;
      min-width: 0;
      flex-direction: row;
      justify-content: center;
      gap: 6px;
      padding: 5px 8px;
    }
  }

  /* 分頁字色：未選為一般文字色，選中為象牙白（兩個主題皆清晰） */
  .method-tab {
    color: var(--text);
  }
  .method-tab[aria-selected="true"] {
    background: var(--brand);
    border-color: var(--brand);
    color: #f6f6f4;
  }

  /* 合併分頁底下的子分頁（例：R0 Cull Zuggle 的 In Bound／Out of Bound），樣式較小一號以區隔層級 */
  .subtab-group {
    border-left: 2px solid var(--border-soft);
    padding-left: 14px;
    margin-bottom: 1.2em;
  }
  .method-subtab {
    color: var(--text);
  }
  .method-subtab[aria-selected="true"] {
    background: var(--brand);
    border-color: var(--brand);
    color: #f6f6f4;
  }

  /* 名詞說明 accordion */
  .term-list {
    display: flex;
    flex-direction: column;
  }
  .term-item {
    border-bottom: 1px solid var(--border-soft);
  }
  .term-item:first-child {
    border-top: 1px solid var(--border-soft);
  }
  .term-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 6px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background 0.15s;
    border-radius: 6px;
  }
  .term-summary::-webkit-details-marker { display: none; }
  .term-summary:hover { background: var(--surface); }
  .term-label {
    flex: 1;
    font-size: 15px;
    color: var(--ink);
    line-height: 1.5;
  }
  .term-en {
    color: var(--ink);
  }
  .term-chevron {
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 0.2s;
  }
  details[open] .term-chevron {
    transform: rotate(180deg);
  }
  .term-answer {
    padding: 2px 6px 14px 6px;
    font-size: 14px;
    color: var(--text);
    line-height: 1.75;
  }
  .term-empty {
    color: var(--muted);
    font-style: italic;
    margin: 0;
  }

  /* 快速示意圖片（單張示意圖或影片下方的補充圖解）：點擊可放大看燈箱。
     .hidden 用來在沒有圖片時把整顆按鈕藏起來——它跟 .demo-image-trigger
     同樣是單一 class，權重相同時後寫的規則會贏，所以這裡明確用
     .demo-image-trigger.hidden 蓋掉 display:block，而不是依賴書寫順序。 */
  .demo-image-trigger {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .demo-image-trigger.hidden {
    display: none;
  }
  .demo-image-trigger img {
    display: block;
  }
  .demo-zoom-hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    color: var(--text);
    opacity: 0;
    transition: opacity 0.15s;
  }
  .demo-zoom-hint svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  @media (hover: hover) {
    .demo-image-trigger:hover .demo-zoom-hint {
      opacity: 1;
    }
  }
  .demo-image-trigger:focus-visible .demo-zoom-hint {
    opacity: 1;
  }
  .demo-image-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* 快速示意圖放大燈箱：與 practical-schematics.astro 的藍圖燈箱同一套互動慣例
     （遮罩點擊關閉、Esc 關閉、Tab 焦點鎖在對話框內），但圖片改用 contain + 自然比例，
     因為這裡放的是流程圖解、介面截圖，不是固定比例的 QR Code。 */
  .demo-lightbox[hidden] {
    display: none;
  }
  .demo-lightbox {
    position: fixed;
    z-index: 80;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
  }
  .demo-lightbox-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: color-mix(in srgb, var(--bg) 74%, #000);
    opacity: 0.92;
    cursor: zoom-out;
  }
  .demo-lightbox-dialog {
    position: relative;
    z-index: 1;
    width: min(92vw, 900px);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: 0 24px 70px color-mix(in srgb, #000 32%, transparent);
  }
  .demo-lightbox-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-soft);
  }
  .demo-lightbox-head h2 {
    margin: 0;
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
  }
  .demo-lightbox-head button {
    display: grid;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .demo-lightbox-head svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .demo-lightbox-image {
    display: grid;
    place-items: center;
    overflow: auto;
    background: var(--bg);
  }
  .demo-lightbox-image img {
    display: block;
    max-width: 100%;
    max-height: calc(88vh - 66px);
    object-fit: contain;
  }
</style>

<script>
  // 索引標籤的方向鍵導覽（WAI-ARIA 慣例）：← → 移動、Home／End 跳頭尾。
  // 搭配 roving tabindex —— 只有選中的分頁在 Tab 順序內，避免鍵盤使用者
  // 要按很多次 Tab 才能跨過整列分頁。
  function bindTabArrowKeys(tabEls: HTMLButtonElement[], onSelect: (i: number) => void) {
    tabEls.forEach((tab, pos) => {
      tab.addEventListener("keydown", (event: KeyboardEvent) => {
        const keys = ["ArrowRight", "ArrowLeft", "Home", "End"];
        if (!keys.includes(event.key)) return;
        event.preventDefault();
        let next = pos;
        if (event.key === "ArrowRight") next = (pos + 1) % tabEls.length;
        else if (event.key === "ArrowLeft") next = (pos - 1 + tabEls.length) % tabEls.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabEls.length - 1;
        onSelect(next);
        tabEls[next].focus();
      });
    });
  }

  // ── 參照流程地圖：步驟單選按鈕 ↔ 地圖（FlowMapViewer.astro）──
  // 依「目前可見面板裡被選取的 radio」決定地圖顯示什麼：切換分頁／子分頁後
  // 也呼叫一次，回到該分頁上次選取的步驟（radio 的 checked 狀態跨 hidden 保留），
  // 該分頁沒選過就回總覽。函式宣告放在 .method-tabs 初始化之前，
  // select() 首次執行時就叫得到。
  function syncFlowMap() {
    if (!document.querySelector("[data-flow-map]")) return;
    const radios = Array.from(document.querySelectorAll<HTMLInputElement>(".flow-step-radio"));
    // offsetParent 為 null 代表在 hidden 面板裡（display:none）
    const visible = radios.find((r) => r.checked && r.offsetParent !== null);
    if (visible?.dataset.map) {
      document.dispatchEvent(new CustomEvent("flowmap:show", { detail: JSON.parse(visible.dataset.map) }));
    } else {
      document.dispatchEvent(new CustomEvent("flowmap:reset"));
    }
  }
  // 「再點一次取消選取」：radio 原生不支援取消，而且事件順序是 click 先於
  // change（activation 先改 checked、發 click，之後才發 input/change），沒辦法
  // 在 click 當下用 checked 區分「剛選上」還是「本來就選著」，所以自己用一張
  // 表記住每個群組目前選到哪一顆
  const lastFlowRadio = new Map<string, HTMLInputElement>();
  document.addEventListener("click", (event) => {
    const t = event.target;
    if (!(t instanceof HTMLInputElement) || !t.classList.contains("flow-step-radio")) return;
    if (lastFlowRadio.get(t.name) === t) {
      // 點擊已選取的 radio：取消選取、地圖回總覽
      t.checked = false;
      lastFlowRadio.delete(t.name);
    } else {
      lastFlowRadio.set(t.name, t);
    }
    syncFlowMap();
  });
  document.addEventListener("change", (event) => {
    // 鍵盤方向鍵切換選取只發 change 不發 click，這裡也要記錄＋同步
    const t = event.target;
    if (t instanceof HTMLInputElement && t.classList.contains("flow-step-radio")) {
      lastFlowRadio.set(t.name, t);
      syncFlowMap();
    }
  });
  // 地圖上按了「清除」：步驟單選按鈕要跟著取消，否則會變成「有選取但地圖空白」，
  // 而且切分頁回來時 syncFlowMap 又會把標記畫回去
  document.addEventListener("flowmap:cleared", () => {
    document.querySelectorAll<HTMLInputElement>(".flow-step-radio").forEach((r) => (r.checked = false));
    lastFlowRadio.clear();
  });

  document.querySelectorAll<HTMLElement>(".method-tabs").forEach((root) => {
    // 用 data-tab／data-panel（原始 content.methods 索引）而非 DOM 順序做對應，
    // 這樣分頁按鈕依 group 分行排列時，仍能正確找到對應的內容區塊。
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".method-tab"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".method-panel"));
    const panelByIndex = new Map(panels.map((p) => [Number(p.dataset.panel), p]));

    const demoSection = document.getElementById("demo-section");
    const mediaWrap = document.getElementById("demo-media-wrap");
    const videoEl = document.getElementById("demo-video") as HTMLVideoElement | null;
    const imageTrigger = document.getElementById("demo-image-trigger") as HTMLButtonElement | null;
    const imageEl = document.getElementById("demo-image") as HTMLImageElement | null;
    const mediaEmpty = document.getElementById("demo-media-empty");
    const videoStackEl = document.getElementById("demo-video-stack");
    const extraWrap = document.getElementById("demo-extra-wrap");
    const extraImageEl = document.getElementById("demo-extra-image") as HTMLImageElement | null;
    const videoBase = mediaWrap?.dataset.videoBase ?? "";
    const imageBase = mediaWrap?.dataset.imageBase ?? "";

    function showOnly(which: "video" | "image" | "empty") {
      videoEl?.classList.toggle("hidden", which !== "video");
      imageTrigger?.classList.toggle("hidden", which !== "image");
      if (mediaEmpty) {
        mediaEmpty.classList.toggle("hidden", which !== "empty");
        mediaEmpty.classList.toggle("flex", which === "empty");
      }
    }

    function updateMedia(index: number) {
      if (!mediaWrap) return;
      const panel = panelByIndex.get(index);

      // 該分頁明確要求不顯示快速示意（例如只想請玩家自行看相關影片），整塊區域
      // （含「快速示意」標題）都不出現，跟「示意內容準備中」的空狀態不同
      if (demoSection) {
        demoSection.hidden = panel?.dataset.hideDemo === "1";
      }
      if (panel?.dataset.hideDemo === "1") {
        videoEl?.pause();
        videoStackEl?.querySelectorAll("video").forEach((v) => (v as HTMLVideoElement).pause());
        return;
      }

      const image = panel?.dataset.image ?? "";
      const video = panel?.dataset.video ?? "";
      const extraImage = panel?.dataset.extraImage ?? "";
      const videosRaw = panel?.dataset.videos ?? "";

      let videoList: { video: string; title: string }[] = [];
      if (videosRaw) {
        try {
          videoList = JSON.parse(videosRaw);
        } catch {
          videoList = [];
        }
      }

      if (videoList.length > 0 && videoStackEl) {
        // 多支影片模式：跟單一影片／圖片互斥，切走時記得暫停裡面所有影片
        videoEl?.pause();
        mediaWrap.hidden = true;
        videoStackEl.innerHTML = "";
        for (const item of videoList) {
          const wrap = document.createElement("div");
          const label = document.createElement("p");
          label.className = "demo-video-item-title";
          label.textContent = item.title ?? "";
          const vid = document.createElement("video");
          vid.className = "w-full rounded-xl bg-sand";
          vid.controls = true;
          vid.loop = true;
          vid.muted = true;
          vid.playsInline = true;
          vid.src = `${videoBase}/${item.video}`;
          wrap.append(label, vid);
          videoStackEl.append(wrap);
        }
        videoStackEl.hidden = false;
      } else {
        if (videoStackEl) {
          videoStackEl.querySelectorAll("video").forEach((v) => v.pause());
          videoStackEl.hidden = true;
          videoStackEl.innerHTML = "";
        }
        mediaWrap.hidden = false;

        if (image && imageEl && imageTrigger) {
          const src = `${imageBase}/${image}`;
          if (imageEl.getAttribute("src") !== src) imageEl.src = src;
          videoEl?.pause();
          showOnly("image");
        } else if (video && videoEl) {
          const src = `${videoBase}/${video}`;
          if (videoEl.getAttribute("src") !== src) {
            videoEl.pause();
            videoEl.src = src;
            videoEl.load();
          }
          showOnly("video");
        } else {
          videoEl?.pause();
          showOnly("empty");
        }
      }

      // 影片下方的補充圖解：與上面的 video/image 互不影響，獨立顯示/隱藏
      if (extraWrap && extraImageEl) {
        if (extraImage) {
          const src = `${imageBase}/${extraImage}`;
          if (extraImageEl.getAttribute("src") !== src) extraImageEl.src = src;
          extraWrap.hidden = false;
        } else {
          extraWrap.hidden = true;
        }
      }
    }

    const principleText = document.getElementById("principle-text");
    const principleSections = document.getElementById("principle-sections");
    const principleExtra = document.getElementById("principle-extra");

    function select(index: number) {
      tabs.forEach((t) => {
        const on = Number(t.dataset.tab) === index;
        t.setAttribute("aria-selected", String(on));
        // roving tabindex：只有選中的分頁進入 Tab 順序，其餘用方向鍵抵達
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => (p.hidden = Number(p.dataset.panel) !== index));
      updateMedia(index);
      // 每個分頁各自決定用哪一種：this.dataset.principleSections 非空就代表
      // 該分頁設了 principleSections，兩個容器都要跟著切換內容與顯示狀態，
      // 不能只填內容不管 hidden（否則舊分頁的空段落會跟新分頁的內容並排出現）。
      const activePanel = panelByIndex.get(index);
      const sectionsHtml = activePanel?.dataset.principleSections ?? "";
      const hasSections = sectionsHtml.length > 0;
      if (principleText) {
        principleText.innerHTML = activePanel?.dataset.principle ?? "";
        principleText.classList.toggle("hidden", hasSections);
      }
      if (principleSections) {
        principleSections.innerHTML = sectionsHtml;
        principleSections.classList.toggle("hidden", !hasSections);
      }
      if (principleExtra) {
        principleExtra.innerHTML = activePanel?.dataset.principleExtra ?? "";
      }
      // 參照流程地圖跟著分頁走：回到該分頁上次選取的步驟，或總覽
      syncFlowMap();
    }

    tabs.forEach((tab) => tab.addEventListener("click", () => select(Number(tab.dataset.tab))));

    // 方向鍵依 DOM 順序移動（跨分組也能連續移動），
    // 但 select() 吃的是 data-tab（原始 methods 索引），兩者不一定相同，需轉換。
    bindTabArrowKeys(tabs, (pos) => select(Number(tabs[pos].dataset.tab)));

    // 從網址 hash 深連結到指定分頁（例如 /types/totk-06#FE），供跨頁連結使用
    const hashTab = decodeURIComponent(window.location.hash.slice(1));
    const hashTabEl = hashTab ? tabs.find((t) => t.textContent?.trim() === hashTab) : undefined;
    select(hashTabEl ? Number(hashTabEl.dataset.tab) : 0);
    if (hashTabEl) {
      root.scrollIntoView({ block: "start" });
    }

    // 步驟中「跳到同頁其他分頁」的按鈕（[[文字|tab:分頁名]] 語法）
    root.querySelectorAll<HTMLButtonElement>(".jump-tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.jumpTab;
        // 比對 data-tab-key（中文版的 tab）而非顯示文字：日文版的標籤已翻譯，
        // 用文字比對會找不到目標而讓跳轉鈕靜默失效
        const targetTab = tabs.find((t) => t.dataset.tabKey === target);
        if (targetTab) select(Number(targetTab.dataset.tab));
      });
    });
  });

  // 快速示意圖放大燈箱：demo-image（單張示意圖）與 demo-extra-image（影片下方的補充
  // 圖解）共用同一個燈箱實例。這兩顆觸發鈕在頁面上只有一份，不隨 .method-tabs 數量
  // 重複，所以獨立於上面的 forEach 之外只綁定一次。
  (function () {
    const lightbox = document.getElementById("demo-lightbox");
    const lightboxImage = document.getElementById("demo-lightbox-image") as HTMLImageElement | null;
    const lightboxTitle = document.getElementById("demo-lightbox-title");
    const closeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-demo-lightbox-close]"));
    let lastTrigger: HTMLButtonElement | null = null;

    function closeLightbox() {
      if (!lightbox || !lightboxImage) return;
      lightbox.hidden = true;
      lightboxImage.src = "";
      lightboxImage.alt = "";
      document.documentElement.style.overflow = "";
      lastTrigger?.focus();
    }

    function openLightbox(trigger: HTMLButtonElement, sourceImg: HTMLImageElement) {
      if (!lightbox || !lightboxImage || !lightboxTitle || !sourceImg.currentSrc) return;
      lastTrigger = trigger;
      lightboxTitle.textContent = sourceImg.alt || lightbox.dataset.defaultTitle || "快速示意圖";
      lightboxImage.src = sourceImg.currentSrc;
      lightboxImage.alt = sourceImg.alt;
      lightbox.hidden = false;
      document.documentElement.style.overflow = "hidden";
      lightbox.querySelector<HTMLButtonElement>(".demo-lightbox-dialog [data-demo-lightbox-close]")?.focus();
    }

    [
      ["demo-image-trigger", "demo-image"],
      ["demo-extra-trigger", "demo-extra-image"],
    ].forEach(([triggerId, imgId]) => {
      const trigger = document.getElementById(triggerId) as HTMLButtonElement | null;
      const img = document.getElementById(imgId) as HTMLImageElement | null;
      if (!trigger || !img) return;
      trigger.addEventListener("click", () => openLightbox(trigger, img));
    });

    closeButtons.forEach((button) => button.addEventListener("click", closeLightbox));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && lightbox && !lightbox.hidden) closeLightbox();
    });

    // 焦點鎖在對話框內：燈箱宣告了 aria-modal="true"，若 Tab 能跑到背景，
    // 鍵盤使用者會在看不見的元素上操作，與「背景不存在」的宣告矛盾。
    lightbox?.addEventListener("keydown", (event) => {
      if (event.key !== "Tab" || lightbox.hidden) return;
      const focusables = Array.from(
        lightbox.querySelectorAll<HTMLElement>("button, a[href], [tabindex]")
      ).filter((el) => el.tabIndex >= 0);
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  })();

  // 合併分頁底下的子分頁（例：R0 Cull Zuggle 的 In Bound／Out of Bound）
  // 各自獨立於所屬的 .method-panel 內切換，不影響外層分頁或快速示意媒體。
  document.querySelectorAll<HTMLElement>(".subtab-group").forEach((group) => {
    const subTabs = Array.from(group.querySelectorAll<HTMLButtonElement>(".method-subtab"));
    const subPanels = Array.from(group.querySelectorAll<HTMLElement>(".subtab-panel"));

    function selectSub(index: number) {
      subTabs.forEach((t, i) => {
        t.setAttribute("aria-selected", String(i === index));
        t.tabIndex = i === index ? 0 : -1;
      });
      subPanels.forEach((p, i) => (p.hidden = i !== index));
      // 參照流程地圖跟著子分頁走（同外層分頁的 syncFlowMap 行為）
      syncFlowMap();
    }

    subTabs.forEach((tab, i) => tab.addEventListener("click", () => selectSub(i)));
    bindTabArrowKeys(subTabs, selectSub);
  });

  // 相關影片分組（videoGroups）：分頁按鈕切換顯示對應分組
  document.querySelectorAll<HTMLElement>(".video-group-tabs").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-vg-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-vg-panel]"));

    function select(index: number) {
      tabs.forEach((t, i) => {
        t.setAttribute("aria-selected", String(i === index));
        t.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((p, i) => (p.hidden = i !== index));
    }

    tabs.forEach((tab, i) => tab.addEventListener("click", () => select(i)));
    bindTabArrowKeys(tabs, select);
  });

  // 相關影片分頁（每頁 10 部）
  (function () {
    const PER_PAGE = 10;
    const rows = Array.from(document.querySelectorAll<HTMLElement>(".related-video"));
    if (rows.length <= PER_PAGE) return;

    const prevBtn = document.getElementById("vid-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("vid-next") as HTMLButtonElement | null;
    const pageInfo = document.getElementById("vid-page-info");
    const pageLabel = document.getElementById("vid-page-label");
    const pageLabelTemplate = pageLabel?.dataset.pageLabelTemplate ?? "第 {page} 頁，共 {total} 頁";
    const totalPages = Math.ceil(rows.length / PER_PAGE);
    let page = 1;

    function render() {
      const start = (page - 1) * PER_PAGE;
      const end = start + PER_PAGE;
      rows.forEach((r, i) => (r.style.display = i >= start && i < end ? "" : "none"));
      if (prevBtn) prevBtn.disabled = page === 1;
      if (nextBtn) nextBtn.disabled = page === totalPages;
      const label = pageLabelTemplate
        .replace("{page}", String(page))
        .replace("{total}", String(totalPages));
      if (pageInfo) pageInfo.textContent = label;
      if (pageLabel) pageLabel.textContent = label;
    }

    prevBtn?.addEventListener("click", () => {
      if (page > 1) { page--; render(); }
    });
    nextBtn?.addEventListener("click", () => {
      if (page < totalPages) { page++; render(); }
    });

    render();
  })();

  // ── 應用一覽彈出視窗 ──────────────────────────────────────────
  (function () {
    const modal = document.querySelector<HTMLElement>("[data-applications-modal]");
    const openBtn = document.querySelector<HTMLButtonElement>("[data-applications-open]");
    if (!modal || !openBtn) return;

    function close() {
      if (!modal || modal.hidden) return;
      modal.hidden = true;
      document.documentElement.style.overflow = "";
      openBtn?.focus();
    }

    openBtn.addEventListener("click", () => {
      modal.hidden = false;
      document.documentElement.style.overflow = "hidden";
      // 只在對話框內找關閉鈕：遮罩雖然也帶 data-applications-close，
      // 但它是 aria-hidden，焦點落上去等於落進讀屏讀不到的地方。
      modal.querySelector<HTMLButtonElement>(".applications-dialog [data-applications-close]")?.focus();
    });

    modal.querySelectorAll<HTMLButtonElement>("[data-applications-close]").forEach((btn) => {
      btn.addEventListener("click", close);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });

    // 焦點鎖在對話框內：宣告了 aria-modal="true"，若 Tab 能跑到背景，
    // 鍵盤使用者會在看不見的元素上操作，與「背景不存在」的宣告矛盾。
    modal.addEventListener("keydown", (event) => {
      if (event.key !== "Tab" || modal.hidden) return;
      // 用 tabIndex >= 0 過濾而非 CSS :not([tabindex="-1"])——後者是 OR 條件，
      // 遮罩仍會被前面的 button 選擇器命中而混進循環。
      const focusables = Array.from(
        modal.querySelectorAll<HTMLElement>("button, a[href], [tabindex]")
      ).filter(
        (el) =>
          el.tabIndex >= 0 &&
          !(el as HTMLButtonElement).disabled &&
          el.offsetParent !== null
      );
      if (focusables.length === 0) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  })();
</script>
