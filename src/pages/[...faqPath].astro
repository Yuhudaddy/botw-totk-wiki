---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/url";
import { uiStrings, type Lang } from "../data/ui-strings";
import { typeGroups } from "../data/types";

// 中文 /types/botw-02-faq、日文 /ja/types/botw-02-faq
export function getStaticPaths() {
  return [
    { params: { faqPath: "types/botw-02-faq" }, props: { lang: "zh" as Lang } },
    { params: { faqPath: "ja/types/botw-02-faq" }, props: { lang: "ja" as Lang } },
  ];
}

const { lang } = Astro.props;
const t = uiStrings[lang];
// 麵包屑「回到轉存格」的技巧名稱：跟 [...typePath].astro 同一套資料來源，
// 不在這裡另外寫死中文
const parentItem = typeGroups.find((g) => g.game === "botw")!.items.find((i) => i.no === "02")!;
const parentLabel = (lang === "ja" && parentItem.ja) || parentItem.zh;

interface FaqItem {
  no: number;
  type: string;
  q: string;
  qJa: string;
  a: string;
  aJa: string;
}

const typeLabel: Record<string, string> = {
  IST: "轉存格",
  DIC: "數值訛轉",
  WMC: "加成訛植",
  PE:  "同位操作",
};

// 日文沒有官方或社群公認譯名的縮寫（DIC/WMC/PE），沿用漢字組合直譯，
// 讀者可從縮寫本身理解；IST 沿用術語表已註冊的「引き継ぎ枠」。
const typeLabelJa: Record<string, string> = {
  IST: "引き継ぎ枠",
  DIC: "数値訛転",
  WMC: "装備補正訛植",
  PE:  "同位操作",
};

const faqs: FaqItem[] = [
  {
    no: 1,
    type: "IST",
    q: "製作轉存格時，賣掉4格道具之後，手持丟在地上的材料可以再撿起來使用嗎？",
    qJa: "引き継ぎ枠を作る際、4マス分のアイテムを売った後、手持ちして地面に捨てた素材は拾い直して使ってもいい？",
    a: "可以，重點在「丟在地上」的那個動作而已，丟完轉存格就觸發了，之後你要怎麼使用在地上的那個東西都不影響。",
    aJa: "大丈夫。重要なのは「地面に捨てる」という動作そのものだけで、捨てた時点で引き継ぎ枠は発動している。その後、地面にあるものをどう使おうと影響はない。",
  },
  {
    no: 2,
    type: "IST",
    q: "番外52.5的流程要繼承光弓回舊檔案，如果有4個英傑+和傳送標記器，一開始製作轉存格時就要多做5個嗎？",
    qJa: "番外52.5の手順で光の弓を旧セーブに引き継ぐ場合、英傑の力+が4つとトラベルメダルがあるなら、最初に引き継ぎ枠を作る時点で追加で5マス分作る必要がある？",
    a: "4個就好，番外52.5的流程不會觸發傳送標記器的黑格。你可以一開始就多做4格或是讀檔後再觸發4格轉存格。反正重點是讓mCount=0清空背包，這樣之後就只會繼承光弓回去舊檔。",
    aJa: "4個だけでいい。番外52.5の手順ではトラベルメダルの黒マスは発生しない。最初に4マス分多く作ってもいいし、ロード後に4マス分の引き継ぎ枠を発動させてもいい。重要なのは mCount=0 でインベントリを空にすることで、そうすれば後は光の弓だけが旧セーブに引き継がれる。",
  },
  {
    no: 3,
    type: "IST",
    q: "網路上有其他薩爾達YT做的影片不用清空背包就能繼承光弓和必殺之劍，原因是什麼呢？",
    qJa: "ネット上の他のゼルダ系 YouTuber の動画では、インベントリを空にしなくても光の弓と一撃必殺の剣を引き継げるものがあるけど、その理由は？",
    a: "據我所知，該影片使用的檔案，每一種屬性箭已經大於500發，這樣讀取時原讀檔的屬性箭就不會讀進來（∵AddToPouch函數）。所以事實上該流程有前提條件「每種屬性箭≧500」發。",
    aJa: "私の知る限り、その動画で使われているセーブデータは、各属性の矢がすでに500本を超えている。そのため、ロード時に元のセーブの属性矢が読み込まれない（∵ AddToPouch 関数の仕様）。つまり実際には、その手順には「各属性矢が500本以上」という前提条件がある。",
  },
  {
    no: 4,
    type: "WMC",
    q: "可以做一個詳細WMC的步驟影片嗎？",
    qJa: "WMC の詳しい手順動画を作ってもらえる？",
    a: "WMC的步驟和玩家的需求、袋子內的道具種類有關，所以一種步驟影片無法通用所有玩家的情況（所以你搜尋網路會有一大堆不同的流程），我不喜歡同種原理做一大堆類似影片。",
    aJa: "WMC の手順はプレイヤーの目的やインベントリ内のアイテムの種類によって変わるので、1本の手順動画だけではすべてのプレイヤーの状況に対応できない（だからネットで検索するとたくさんの異なる手順が出てくる）。同じ原理で似たような動画を大量に作るのは好きではない。",
  },
  {
    no: 5,
    type: "IST",
    q: "轉存格或光弓可以繼承到另一個帳號嗎？",
    qJa: "引き継ぎ枠や光の弓を別のアカウントに引き継ぐことはできる？",
    a: "不行，相對地你可以試想，如果可以繼承到另一個帳號，表示你即便關閉遊戲也無法取消這個程錯，那不是很可怕嗎？",
    aJa: "できない。逆に考えてみてほしい。もし別のアカウントに引き継げるとしたら、ゲームを終了してもこのグリッチを取り消せないことになる。それはかなり怖いことではないだろうか。",
