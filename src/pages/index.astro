---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoCard from "../components/VideoCard.astro";
import { href } from "../lib/url";
import { quickNav, SITE } from "../data/site";
import youtubeData from "../data/youtube.json";

const featured = youtubeData.featured;
---

<BaseLayout active="home">
  {/* ===== 首頁導覽 ===== */}
  <section class="home-hero-shell">
    <div class="home-hero mx-auto max-w-[1244px] px-8 pt-[40px]">
      <div class="home-hero-frame">
        <div class="home-hero-copy">
          <div class="home-kicker">
            <span class="home-kicker-line"></span>
            技巧索引 · The Technique & Glitch Index
          </div>

          <h1 class="home-title font-serif text-ink">
            <span>Yuda頻道的</span>
            <span>攻略百科</span>
          </h1>

          <p class="home-description text-text">
            攻略來源出自 Yuda 的 YouTube 頻道
            <a href={SITE.youtube} target="_blank" rel="noopener">@zb_yuhudaddy</a>，包含《曠野之息》《王國之淚》《智慧的再現》《任天堂明星大亂鬥特別版》的攻略秘技與解說。
          </p>

          <div class="home-actions" aria-label="快速瀏覽系列">
            <a href={href("/videos?game=totk")} class="home-action home-action-primary">
              瀏覽王國之淚
              <span aria-hidden="true">→</span>
            </a>
            <a href={href("/videos?game=botw")} class="home-action home-action-secondary">
              瀏覽曠野之息
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="home-series" aria-label="收錄遊戲系列">
            <span>BOTW</span>
            <span>TOTK</span>
            <span>EOW</span>
            <span>SSBU</span>
          </div>
        </div>

        <div class="home-hero-scene" aria-hidden="true">
          <img class="home-scene home-scene-light" src={href("/logo/light.png")} alt="" loading="eager" />
          <img class="home-scene home-scene-dark" src={href("/logo/dark.png")} alt="" loading="eager" />
          <img
            class="home-link-wide"
            src={href("/logo/55AFA7FA-20B1-4351-B645-454C89FE30C7-Photoroom.png")}
            alt=""
            loading="eager"
          />
          <img
            class="home-link-tall"
            src={href("/logo/1D0CB390-F719-4376-B57A-3039F034587F-Photoroom.png")}
            alt=""
            loading="eager"
          />
        </div>
      </div>

      <aside class="home-latest" aria-labelledby="latest-heading">
        <div class="home-latest-header">
          <div>
            <p id="latest-heading">最新整理</p>
            <span>LATEST</span>
          </div>
          <a href={href("/videos")} class="home-latest-all">全部影片 <span aria-hidden="true">→</span></a>
        </div>
        <ol class="home-latest-list">
          {
            youtubeData.latest.map((l) => {
              const d = new Date(l.publishedAt);
              const dateLabel = `${d.getMonth() + 1}/${String(d.getDate()).padStart(2, "0")}`;
              return (
                <li>
                  <a
                    href={`https://www.youtube.com/watch?v=${l.id}`}
                    target="_blank"
                    rel="noopener"
                    class="home-latest-item"
                  >
                    <time datetime={l.publishedAt} class="home-latest-date">{dateLabel}</time>
                    <span class="home-latest-title">{l.title}</span>
                  </a>
                </li>
              );
            })
          }
        </ol>
      </aside>
    </div>

    <nav class="home-section-nav" aria-label="首頁段落">
      <div class="mx-auto flex max-w-[1244px] items-center px-8">
        <span class="home-section-id">HOME / 01</span>
        <div class="home-section-links">
          <a href="#featured">最近熱門</a>
          <a href="#explore">從哪開始</a>
          <a href="#about">關於本站</a>
        </div>
      </div>
    </nav>
  </section>

  {/* ===== 精選技巧 ===== */}
  <section id="featured" class="home-section mx-auto max-w-[1244px] px-8 py-[84px]">
    <div class="home-section-heading">
      <div>
        <div class="home-section-kicker">近期整理 · Featured</div>
        <h2 class="home-section-title font-serif text-ink">最近熱門</h2>
      </div>
      <a href={href("/videos")} class="home-text-link">
        查看全部影片 <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-5">
      {featured.map((f) => <VideoCard vid={f.id} title={f.title} meta={f.meta} />)}
    </div>
  </section>

  {/* ===== 快速導覽 ===== */}
  <section id="explore" class="home-explore border-y border-border-soft bg-surface">
    <div class="mx-auto grid max-w-[1244px] grid-cols-[0.72fr_1.28fr] gap-16 px-8 py-[84px]">
      <div class="home-explore-intro">
        <div class="home-section-kicker">快速導覽 · Explore</div>
        <h2 class="home-section-title font-serif text-ink">從哪開始</h2>
        <p class="mt-5 max-w-[25ch] text-[15px] leading-[1.8] text-text">
          依遊戲、主題與操作目的挑一個入口；每一頁都會持續補上實作步驟與對應影片。
        </p>
      </div>

      <div class="home-nav-grid">
        {
          quickNav.map((q) =>
            q.links ? (
              <div class="home-nav-card home-nav-card-multi">
                <div class="home-nav-card-meta">
                  <span class="home-nav-no">{q.no}</span>
                  <span class="home-nav-series">{q.series}</span>
                </div>
                {/* 桌面（有滑鼠）hover 感應區：左右各半，觸控裝置隱藏改用下方按鈕 */}
                {q.links.map((l, i) => (
                  <a
                    href={href(l.path)}
                    class={`home-nav-zone home-nav-zone-${i + 1}`}
                    data-tone={l.tone}
                    aria-label={l.label}
                  />
                ))}
                <span class="home-nav-title font-serif text-ink">{q.title}</span>
                {q.links.map(
                  (l, i) =>
                    l.word && (
                      <span
                        class={`home-nav-word home-nav-word-${i + 1} home-nav-word-${l.tone} font-serif`}
                        aria-hidden="true"
                      >
                        {l.word}
                      </span>
                    )
                )}
                <div class="home-nav-links">
                  {q.links.map((l) => (
                    <a href={href(l.path)} class="home-nav-link-btn">
                      {l.label}
                      <span aria-hidden="true">→</span>
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a href={href(q.path!)} class="home-nav-card">
                <span class="home-nav-no">{q.no}</span>
                <span class="home-nav-series">{q.series}</span>
                <span class="home-nav-title font-serif text-ink">{q.title}</span>
                <span class="home-nav-arrow" aria-hidden="true">→</span>
              </a>
            )
          )
        }
      </div>
    </div>
  </section>

  {/* ===== 關於本站 ===== */}
  <section id="about" class="mx-auto max-w-[1244px] px-8 py-[76px]">
    <div class="home-about">
      <div class="home-about-meta">
        <div class="home-section-kicker">關於本站 · Note</div>
        <span>持續整理中</span>
      </div>
      <p class="home-about-copy text-text">
        本站為個人攻略筆記，內容會持續補充。技巧多與特定遊戲版本相關，請務必確認每篇頁面標註的「適用版本」。歡迎到
        <a href={SITE.youtube} target="_blank" rel="noopener">YouTube 頻道</a>
        訂閱與留言交流。
      </p>
    </div>
  </section>

  <style>
    .home-hero-shell {
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid var(--border);
      background: var(--bg);
    }

    .home-hero {
      position: relative;
      z-index: 1;
    }

    .home-hero-frame {
      position: relative;
      isolation: isolate;
      display: grid;
      min-height: 460px;
      grid-template-columns: minmax(405px, 0.88fr) minmax(0, 1.12fr);
      overflow: hidden;
      border: 1px solid var(--border-strong);
      background: var(--surface);
    }

    .home-hero-frame::before {
      position: absolute;
      z-index: 1;
      inset: 0;
      content: "";
      pointer-events: none;
      background: linear-gradient(
        90deg,
        rgba(250, 249, 245, 0.96) 0%,
        rgba(250, 249, 245, 0.91) 38%,
        rgba(250, 249, 245, 0.62) 54%,
        rgba(250, 249, 245, 0.14) 75%,
        rgba(250, 249, 245, 0.04) 100%
      );
    }

    .home-hero-copy {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 44px 52px 42px;
      background: transparent;
    }

    .home-kicker,
    .home-section-kicker {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .home-kicker-line {
      display: inline-block;
      width: 22px;
      height: 1px;
      background: currentColor;
    }

    .home-title {
      width: 100%;
      max-width: none;
      margin: 21px 0 0;
      font-size: 40px;
      font-weight: 500;
      line-height: 1.15;
      letter-spacing: 0;
    }

    .home-title span {
      display: block;
    }

    .home-description {
      max-width: 39ch;
      margin: 19px 0 0;
      font-size: 16px;
      line-height: 1.75;
    }

    .home-description a,
    .home-about-copy a {
      color: var(--accent);
      font-weight: 500;
      text-decoration: none;
    }

    .home-description a:hover,
    .home-about-copy a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .home-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 25px;
    }

    .home-action {
      display: inline-flex;
      align-items: center;
      gap: 22px;
      min-height: 44px;
      padding: 11px 15px 11px 17px;
      border: 1px solid var(--border-strong);
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      transition: color 180ms ease, border-color 180ms ease, background-color 180ms ease;
    }

    .home-action span {
      font-size: 17px;
      line-height: 1;
      transition: transform 180ms ease;
    }

    .home-action:hover span,
    .home-action:focus-visible span,
    .home-text-link:hover span,
    .home-text-link:focus-visible span {
      transform: translateX(3px);
    }

    .home-action:focus-visible,
    .home-latest-item:focus-visible,
    .home-latest-all:focus-visible,
    .home-text-link:focus-visible,
    .home-nav-card:focus-visible,
    .home-section-links a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    .home-action-primary {
      border-color: var(--brand);
      background: var(--brand);
      color: #fff;
    }

    .home-action-primary:hover,
    .home-action-primary:focus-visible {
      border-color: #b95538;
      background: #b95538;
      color: #fff;
    }

    .home-action-secondary {
      background: transparent;
      color: var(--ink);
    }

    .home-action-secondary:hover,
    .home-action-secondary:focus-visible {
      border-color: var(--accent);
      color: var(--accent);
    }

    .home-series {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      margin-top: 29px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.09em;
      color: var(--muted);
    }

    .home-series span {
      padding: 0 10px;
      border-right: 1px solid var(--border-strong);
    }

    .home-series span:first-child {
      padding-left: 0;
    }

    .home-series span:last-child {
      border-right: 0;
    }

    .home-hero-scene {
      position: absolute;
      z-index: 0;
      inset: 0;
      overflow: hidden;
      background: var(--surface-2);
    }

    .home-scene {
      position: absolute;
      inset: 0;
      z-index: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 59% center;
      pointer-events: none;
      user-select: none;
    }

    .home-scene-dark {
      display: none;
    }

    .home-link-wide,
    .home-link-tall {
      position: absolute;
      z-index: 1;
      display: block;
      max-width: none;
      width: auto;
      height: auto;
      pointer-events: none;
      user-select: none;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.16) 13%, #000 40%, #000 100%);
      mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.16) 13%, #000 40%, #000 100%);
    }

    .home-link-wide {
      top: 50%;
      right: -344px;
      bottom: auto;
      transform: translateY(-49%);
      width: auto;
      height: 528px;
      opacity: 0.62;
    }

    .home-link-tall {
      display: none;
    }

    .home-latest {
      display: grid;
      grid-template-columns: minmax(190px, 0.25fr) minmax(0, 1fr);
      border: 1px solid var(--border-strong);
      border-top: 0;
      background: var(--surface);
    }

    .home-latest-header {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 14px;
      padding: 20px 18px;
      border-right: 1px solid var(--border-strong);
    }

    .home-latest-header p {
      margin: 0;
      color: var(--ink);
      font-size: 15px;
      font-weight: 600;
      line-height: 1.2;
    }

    .home-latest-header span {
      display: block;
      margin-top: 4px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.12em;
      color: var(--muted);
    }

    .home-latest-all,
    .home-text-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex: none;
      color: var(--accent);
      font-size: 13px;
      font-weight: 500;
      text-decoration: none;
    }

    .home-latest-list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .home-latest-list li + li {
      border-left: 1px solid var(--border);
    }

    .home-latest-item {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 7px;
      min-height: 108px;
      padding: 18px 16px 20px;
      color: var(--ink);
      text-decoration: none;
      transition: background-color 180ms ease, color 180ms ease;
    }

    .home-latest-item:hover {
      background: var(--bg);
      color: var(--accent);
    }

    .home-latest-title {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      font-family: var(--font-serif);
      font-size: 15px;
      font-weight: 500;
      line-height: 1.38;
    }

    .home-latest-date {
      position: absolute;
      top: 18px;
      left: 16px;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 10px;
      line-height: 1.2;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }

    .home-section-nav {
      position: relative;
      z-index: 1;
      min-height: 70px;
      background: var(--bg);
    }

    .home-section-nav > div {
      min-height: 70px;
      justify-content: space-between;
      gap: 24px;
    }

    .home-section-id {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.12em;
    }

    .home-section-links {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .home-section-links a {
      color: var(--muted);
      font-size: 14px;
      text-decoration: none;
      transition: color 180ms ease;
    }

    .home-section-links a:hover {
      color: var(--accent);
    }

    .home-section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 30px;
    }

    .home-section-title {
      margin: 12px 0 0;
      font-size: 35px;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: 0;
    }

    .home-text-link {
      padding-bottom: 5px;
      border-bottom: 1px solid var(--accent);
    }

    .home-text-link span {
      font-size: 17px;
      line-height: 1;
      transition: transform 180ms ease;
    }

    .home-explore-intro {
      padding-top: 3px;
    }

    .home-nav-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-top: 1px solid var(--border-strong);
      border-left: 1px solid var(--border-strong);
    }

    .home-nav-card {
      position: relative;
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-rows: auto auto;
      gap: 4px 10px;
      min-height: 132px;
      padding: 20px 18px;
      border-right: 1px solid var(--border-strong);
      border-bottom: 1px solid var(--border-strong);
      background: var(--bg);
      text-decoration: none;
      transition: background-color 180ms ease, border-color 180ms ease;
    }

    .home-nav-card:hover {
      z-index: 1;
      border-color: var(--accent);
      background: var(--surface-2);
    }

    .home-nav-no {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.3;
    }

    .home-nav-series {
      overflow: hidden;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.3;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .home-nav-title {
      grid-column: 1 / -1;
      align-self: end;
      overflow: hidden;
      font-size: 19px;
      font-weight: 500;
      line-height: 1.3;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .home-nav-arrow {
      grid-column: 3;
      grid-row: 1;
      color: var(--accent);
      font-size: 17px;
      line-height: 1;
      transition: transform 180ms ease;
    }

    .home-nav-card:hover .home-nav-arrow,
    .home-nav-card:focus-visible .home-nav-arrow {
      transform: translateX(3px);
    }

    .home-nav-card-multi {
      position: relative;
      overflow: hidden;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr);
      grid-template-rows: auto 1fr;
      align-items: start;
      cursor: default;
    }

    /* hover 感應區與漸層字：預設隱藏，只在有滑鼠的裝置啟用 */
    .home-nav-zone,
    .home-nav-word {
      display: none;
    }

    .home-nav-card-multi:hover {
      border-color: var(--border-strong);
      background: var(--bg);
    }

    .home-nav-card-meta {
      display: flex;
      align-items: baseline;
      gap: 10px;
      grid-column: 1;
      grid-row: 1;
      min-width: 0;
    }

    .home-nav-card-multi .home-nav-series {
      text-overflow: ellipsis;
    }

    .home-nav-card-multi .home-nav-title {
      grid-column: 1;
      grid-row: 2;
      align-self: end;
      margin-bottom: 2px;
      white-space: normal;
    }

    .home-nav-links {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: center;
      display: grid;
      gap: 8px;
    }

    .home-nav-link-btn {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      min-width: 0;
      padding: 6px 12px;
      border: 1px solid var(--border-strong);
      border-radius: 999px;
      color: var(--text);
      font-size: 12.5px;
      text-decoration: none;
      white-space: normal;
      overflow-wrap: break-word;
      transition: border-color 160ms ease, color 160ms ease;
    }

    .home-nav-link-btn:hover,
    .home-nav-link-btn:focus-visible {
      border-color: var(--accent);
      color: var(--accent);
    }

    .home-nav-link-btn span {
      font-size: 12px;
    }

    /* ===== 物件地圖卡片：桌面 hover 特效（觸控裝置維持按鈕版型） ===== */
    @media (hover: hover) and (pointer: fine) {
      .home-nav-card-multi .home-nav-links {
        display: none;
      }

      .home-nav-card-multi:hover {
        z-index: 1;
        border-color: var(--accent);
        background: var(--surface-2);
      }

      .home-nav-zone {
        display: block;
        position: absolute;
        top: 0;
        bottom: 0;
        width: 50%;
        z-index: 4;
      }

      .home-nav-zone-1 { left: 0; }
      .home-nav-zone-2 { right: 0; }

      .home-nav-zone:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }

      .home-nav-card-multi .home-nav-title {
        position: relative;
        z-index: 3;
        transition: opacity 220ms ease;
      }

      .home-nav-word {
        display: block;
        grid-column: 1;
        grid-row: 2;
        /* 與 .home-nav-title 一樣靠下對齊，切換時才不會上下跳動 */
        align-self: end;
        margin-bottom: 2px;
        justify-self: start;
        position: relative;
        z-index: 3;
        font-size: 22px;
        font-weight: 500;
        line-height: 1.3;
        letter-spacing: 3px;
        opacity: 0;
        transform: translateY(7px);
