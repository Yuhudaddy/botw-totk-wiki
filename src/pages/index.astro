            particle.x += particle.vx * delta;
            particle.y += particle.vy * delta;

            if (!reducedMotion.matches && velocity > 0.48) {
              var trailScale = Math.min(3.1, 1.25 + velocity * 0.13);
              trails[particle.color].moveTo(particle.x, particle.y);
              trails[particle.color].lineTo(
                particle.x - particle.vx * trailScale,
                particle.y - particle.vy * trailScale
              );
            }

            var shimmer =
              0.9 + Math.sin(time * 1.8 + particle.phase) * 0.12;
            var radius = particle.size * shimmer;
            dots[particle.color].moveTo(particle.x + radius, particle.y);
            dots[particle.color].arc(
              particle.x,
              particle.y,
              radius,
              0,
              Math.PI * 2
            );

            if (particle.size > 1.55) {
              var glowRadius = particle.size * 3.8;
              glows[particle.color].moveTo(particle.x + glowRadius, particle.y);
              glows[particle.color].arc(
                particle.x,
                particle.y,
                glowRadius,
                0,
                Math.PI * 2
              );
            }
          }

          context.globalCompositeOperation = lightMode ? "source-over" : "lighter";
          context.lineCap = "round";
          context.lineWidth = 0.72;

          for (var colorIndex = 0; colorIndex < palette.length; colorIndex += 1) {
            var color = palette[colorIndex];
            var colorValue = color[0] + " " + color[1] + " " + color[2];

            if (!reducedMotion.matches) {
              context.globalAlpha = lightMode ? 0.14 : 0.13;
              context.strokeStyle = "rgb(" + colorValue + ")";
              context.stroke(trails[colorIndex]);
            }

            context.globalAlpha = lightMode ? 0.075 : 0.07;
            context.fillStyle = "rgb(" + colorValue + ")";
            context.fill(glows[colorIndex]);

            context.globalAlpha = lightMode ? 0.82 : 0.9;
            context.fillStyle = "rgb(" + colorValue + ")";
            context.fill(dots[colorIndex]);
          }

          context.globalAlpha = 1;
          context.globalCompositeOperation = "source-over";
          window.requestAnimationFrame(animate);
        }

        window.addEventListener(
          "resize",
          function () {
            window.clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(resizeCanvas, 120);
          },
          { passive: true }
        );

        resizeCanvas();
        window.requestAnimationFrame(animate);
      })();
    </script>
  </body>
</html>
