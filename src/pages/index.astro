---
import { SITE } from "../data/site";
import { href } from "../lib/url";

// 入口頁本身就在 "/"，兩顆按鈕與站內導引一律指向攻略首頁 "/home"
const wikiHomeUrl = href("/home");
---

<!doctype html>
<html lang="en" class="entrance-html">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="Advanced game guides and mechanics for The Legend of Zelda, Super Smash Bros., and beyond."
    />
    <meta name="theme-color" content="#1a0d07" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <title>Yuda's Channel · Game Wiki</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;600&family=Noto+Serif+TC:wght@400&family=Noto+Serif+JP:wght@400&family=Spectral:ital,wght@0,400;0,500;1,400;1,500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        var theme = "dark";
        try {
          var saved = localStorage.getItem("wiki-theme");
          if (saved === "light" || saved === "dark") {
            theme = saved;
          } else {
            theme = window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
          }
        } catch (error) {
          theme = "dark";
        }
        document.documentElement.setAttribute("data-theme", theme);
        document.documentElement.style.colorScheme = theme;

        // 入口頁語言：優先用記住的選擇，否則依瀏覽器語言判斷（zh→中文、ja→日文、其餘英文）。
        // 在 head 就決定並寫上 data-lang，讓日文標題的語序（CSS order）與字體在首次繪製前就定案，
        // 避免先閃一下英文版排版。實際文字替換在 body 末端的 script。
        var lang = "en";
        try {
          var savedLang = localStorage.getItem("entrance-lang");
          if (savedLang === "zh" || savedLang === "en" || savedLang === "ja") {
            lang = savedLang;
          } else {
            var nav = (navigator.languages && navigator.languages[0]) || navigator.language || "en";
            nav = nav.toLowerCase();
            if (nav.indexOf("zh") === 0) lang = "zh";
            else if (nav.indexOf("ja") === 0) lang = "ja";
          }
        } catch (error) {
          lang = "en";
        }
        document.documentElement.setAttribute("data-lang", lang);
        document.documentElement.setAttribute(
          "lang",
          lang === "zh" ? "zh-Hant-TW" : lang === "ja" ? "ja" : "en"
        );
      })();
    </script>
  </head>

  <body class="entrance-page">
    <a class="skip-link" href="#entrance-content">Skip to main content</a>

    <header class="entrance-header">
      {/* 入口頁本身就是站台起點，Logo 不再是連結（點了只會重載同一頁）；
          進站一律走下方的 Enter Shrine 按鈕。 */}
      <div class="entrance-brand">
        <img class="brand-logo" src={href("/logo/yuda-logo.png")} alt="" />
        <span class="brand-copy">
          <span>Dazotikuy Shrine</span>
        </span>
      </div>

      <div class="entrance-header-actions">
        {/* 語言切換：只影響入口頁的文案，站內其他頁面維持中文 */}
        <div class="lang-switch" id="entrance-lang-switch">
          <button
            class="lang-switch-button"
            id="entrance-lang-button"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="entrance-lang-menu"
            aria-label="Change language"
          >
            <svg class="lang-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.45" />
              <path
                d="M3.3 9.6h17.4M3.3 14.4h17.4"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
              />
              <path
                d="M12 3a14.4 14.4 0 0 1 0 18 14.4 14.4 0 0 1 0-18Z"
                stroke="currentColor"
                stroke-width="1.3"
              />
            </svg>
          </button>

          <div class="lang-menu" id="entrance-lang-menu" role="menu" aria-label="Language" hidden>
            <button class="lang-option" type="button" role="menuitemradio" aria-checked="false" data-lang-option="zh">
              <span class="lang-option-label">繁體中文</span>
              <svg class="lang-option-check" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12.5 10 17.5 19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button class="lang-option" type="button" role="menuitemradio" aria-checked="false" data-lang-option="en">
              <span class="lang-option-label">English</span>
              <svg class="lang-option-check" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12.5 10 17.5 19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button class="lang-option" type="button" role="menuitemradio" aria-checked="false" data-lang-option="ja">
              <span class="lang-option-label">日本語</span>
              <svg class="lang-option-check" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12.5 10 17.5 19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>

        <button
          class="theme-switch"
          id="entrance-theme-switch"
          type="button"
          aria-label="Switch to light theme"
        >
          <span class="theme-switch-icons" aria-hidden="true">
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none">
            <path
              d="M19.6 15.2A8.2 8.2 0 0 1 8.8 4.4a8.25 8.25 0 1 0 10.8 10.8Z"
              stroke="currentColor"
              stroke-width="1.45"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path d="M16.7 5.2v2.3M15.55 6.35h2.3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
          </svg>
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="3.75" stroke="currentColor" stroke-width="1.45" />
            <path
              d="M12 2.8v2.1M12 19.1v2.1M21.2 12h-2.1M4.9 12H2.8M18.5 5.5 17 7M7 17l-1.5 1.5M18.5 18.5 17 17M7 7 5.5 5.5"
              stroke="currentColor"
              stroke-width="1.45"
              stroke-linecap="round"
            />
            </svg>
          </span>
        </button>
      </div>
    </header>

    <main id="entrance-content">
      <section class="entrance-stage" aria-labelledby="entrance-heading">
        <div class="ambient-field" aria-hidden="true"></div>
        <div class="pointer-light" aria-hidden="true"></div>
        <div class="vortex-halo" aria-hidden="true"></div>
        <div class="orbit orbit-wide" aria-hidden="true"></div>
        <div class="orbit orbit-tall" aria-hidden="true"></div>
        <canvas id="yuda-particles" class="particle-canvas" aria-hidden="true"></canvas>
        <div class="yuda-ghost" aria-hidden="true">YUDA</div>
        <div class="grain" aria-hidden="true"></div>
        <div class="vignette" aria-hidden="true"></div>

        <div class="hero-copy">
          <div class="hero-eyebrow entrance-reveal entrance-reveal-1">
            <span>Yuda's Channel</span>
            <span class="eyebrow-line" aria-hidden="true"></span>
            <span>Game Wiki</span>
          </div>

          <h1 id="entrance-heading" class="hero-title entrance-reveal entrance-reveal-2">
            <span class="hero-title-prefix">Welcome to</span>
            <em>Dazotikuy Shrine</em>
          </h1>

          <div class="hero-support entrance-reveal entrance-reveal-3">
            <p>
              Advanced game guides and mechanics for The Legend of Zelda,
              Super Smash Bros., and beyond.
            </p>

            <div class="hero-actions" aria-label="Entrance actions">
              <a class="hero-action hero-action-primary magnetic" href={wikiHomeUrl}>
                <span>Enter Shrine</span>
                <span class="action-icon" aria-hidden="true">
                  <svg class="action-symbol action-symbol-default" viewBox="0 0 24 24" fill="none">
                    <path d="M6 18 18 6M9 6h9v9" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <img class="action-symbol action-symbol-hover action-symbol-favicon" src={href("/favicon.svg")} alt="" />
                </span>
              </a>

              <a
                class="hero-action hero-action-secondary magnetic"
                href={SITE.youtube}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Visit Channel</span>
                <span class="action-icon" aria-hidden="true">
                  <svg class="action-symbol action-symbol-default" viewBox="0 0 24 24" fill="none">
                    <path d="M7 12h10M13.5 8.5 17 12l-3.5 3.5" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <svg class="action-symbol action-symbol-hover action-symbol-youtube" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
                  </svg>
                </span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="entrance-footer entrance-reveal entrance-reveal-4">
      <p>© 2026 Yuhudaddy - Content Curated from Personal YouTube Channel</p>
    </footer>

    <div class="custom-cursor cursor-dot" aria-hidden="true"></div>
    <div class="custom-cursor cursor-ring" aria-hidden="true"></div>

    <style is:global>
      :root,
      :root[data-theme="dark"] {
        color-scheme: dark;
        --entrance-bg: oklch(14% 0.018 52);
        --entrance-bg-deep: oklch(10% 0.018 48);
        --entrance-bg-soft: oklch(18% 0.028 52);
        --entrance-surface: oklch(24% 0.052 55);
        --entrance-text: oklch(95% 0.025 75);
        --entrance-text-soft: oklch(77% 0.045 67);
        --entrance-text-faint: oklch(64% 0.035 65);
        --entrance-line: oklch(63% 0.088 57 / 0.28);
        --entrance-line-strong: oklch(72% 0.13 58 / 0.46);
        --entrance-accent: oklch(72% 0.17 55);
        --entrance-accent-bright: oklch(82% 0.14 68);
        --entrance-accent-deep: oklch(56% 0.17 44);
        /* 背景環境光暈專用（YUDA 粒子周圍的大片朦朧光），與上面三個
           --entrance-accent* 分開，不影響按鈕圖示、游標、對焦框等 UI 強調色。
           深色模式：接近白色的極淡皮膚色；淺色模式沿用原本的橘色調（見下方 light 區塊）。 */
        --entrance-glow-1: oklch(93% 0.02 55);
        --entrance-glow-2: oklch(96% 0.015 55);
        --entrance-glow-3: oklch(98% 0.01 55);
        --entrance-button-primary: oklch(27% 0.074 53);
        --entrance-button-primary-text: oklch(95% 0.025 75);
        --entrance-button-secondary: oklch(19% 0.035 52);
        --entrance-focus: oklch(83% 0.15 70);
        --entrance-particle-glow: oklch(76% 0.18 59 / 0.25);
        --entrance-shadow: oklch(6% 0.012 50 / 0.38);
        --entrance-glass-fill: oklch(96% 0.018 78 / 0.065);
        --entrance-glass-edge: oklch(79% 0.095 64 / 0.42);
        --entrance-glass-edge-bright: oklch(98% 0.012 80 / 0.5);
        --entrance-glass-sheen: oklch(100% 0 0 / 0.28);
        --entrance-glass-reflection: oklch(100% 0 0 / 0.22);
        --entrance-glass-shadow: oklch(4% 0.012 50 / 0.34);
        --entrance-title-gradient-a: #ffffff;
        --entrance-title-gradient-b: #c9a98b;
        --entrance-title-gradient-c: #e97870;
        --entrance-title-gradient-d: #f2a05e;
        --entrance-theme-color: #1a0d07;
        --cursor-x: -100px;
        --cursor-y: -100px;
        --cursor-dot-x: -100px;
        --cursor-dot-y: -100px;
        --cursor-scale: 1;
      }

      :root[data-theme="light"] {
        color-scheme: light;
        --entrance-bg: #fff;
        --entrance-bg-deep: #fff;
        --entrance-bg-soft: #fff;
        --entrance-surface: #fff;
        --entrance-text: oklch(27% 0.07 44);
        --entrance-text-soft: oklch(42% 0.075 50);
        --entrance-text-faint: oklch(50% 0.06 55);
        --entrance-line: oklch(53% 0.11 52 / 0.24);
        --entrance-line-strong: oklch(51% 0.14 49 / 0.4);
        --entrance-accent: oklch(56% 0.18 45);
        --entrance-accent-bright: oklch(66% 0.17 54);
        --entrance-accent-deep: oklch(44% 0.16 40);
        /* 淺色模式維持原本的橘色系背景光暈（本次調整僅指定深色模式） */
        --entrance-glow-1: oklch(44% 0.16 40);
        --entrance-glow-2: oklch(56% 0.18 45);
        --entrance-glow-3: oklch(66% 0.17 54);
        --entrance-button-primary: oklch(89% 0.075 66);
        --entrance-button-primary-text: oklch(29% 0.07 42);
        --entrance-button-secondary: #fff;
        --entrance-focus: oklch(48% 0.19 45);
        --entrance-particle-glow: oklch(60% 0.16 50 / 0.17);
        --entrance-shadow: oklch(48% 0.09 48 / 0.14);
        --entrance-glass-fill: oklch(100% 0 0 / 0.12);
        --entrance-glass-edge: oklch(77% 0.028 72 / 0.38);
        --entrance-glass-edge-bright: oklch(100% 0 0 / 0.82);
        --entrance-glass-sheen: oklch(100% 0 0 / 0.66);
        --entrance-glass-reflection: oklch(100% 0 0 / 0.7);
        --entrance-glass-shadow: oklch(62% 0.025 70 / 0.1);
        --entrance-title-gradient-a: #ffffff;
        --entrance-title-gradient-b: #c9a98b;
        --entrance-title-gradient-c: #e97870;
        --entrance-title-gradient-d: #f2a05e;
        --entrance-theme-color: #fff3df;
      }

      .entrance-html {
        min-width: 320px;
        min-height: 100%;
        overflow: hidden;
        background: var(--entrance-bg);
      }

      .entrance-page {
        position: relative;
        display: grid;
        min-width: 320px;
        min-height: 100svh;
        margin: 0;
        overflow: hidden;
        grid-template-rows: auto 1fr auto;
        background: var(--entrance-bg);
        color: var(--entrance-text);
        font-family: "Noto Sans TC", "Avenir Next", Avenir, sans-serif;
        font-kerning: normal;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .entrance-page *,
      .entrance-page *::before,
      .entrance-page *::after {
        box-sizing: border-box;
      }

      .entrance-page a,
      .entrance-page button {
        -webkit-tap-highlight-color: transparent;
      }

      .skip-link {
        position: fixed;
        z-index: 80;
        top: 12px;
        left: 12px;
        padding: 10px 14px;
        transform: translateY(-150%);
        border-radius: 4px;
        background: var(--entrance-text);
        color: var(--entrance-bg);
        font-size: 0.875rem;
        text-decoration: none;
        transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .entrance-header {
        position: relative;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding:
          max(clamp(24px, 4.4vh, 46px), env(safe-area-inset-top))
          max(clamp(24px, 4.7vw, 68px), env(safe-area-inset-right))
          0
          max(clamp(24px, 4.7vw, 68px), env(safe-area-inset-left));
        pointer-events: none;
      }

      .entrance-brand,
      .entrance-header-actions {
        pointer-events: auto;
      }

      .entrance-header-actions {
        display: flex;
        align-items: center;
        gap: 4px;
      }

      /* 日文的漢字字形與繁中不同（例：解説／説），優先用系統的日文字體，
         不額外載入字檔；找不到時才退回原本的 Noto Sans TC。 */
      :root[data-lang="ja"] .entrance-page {
        font-family:
          "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic", "Yu Gothic UI", Meiryo,
          "Noto Sans JP", "Noto Sans TC", "Avenir Next", Avenir, sans-serif;
      }

      .entrance-brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        color: var(--entrance-text);
        text-decoration: none;
      }

      .brand-logo {
        position: relative;
        display: block;
        width: 40px;
        height: 40px;
        flex: 0 0 auto;
        object-fit: contain;
        transition:
          filter 220ms cubic-bezier(0.25, 1, 0.5, 1),
          transform 220ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .brand-copy {
        display: block;
        line-height: 1;
      }

      .brand-copy span {
        color: var(--entrance-text-soft);
        font-family: "Spectral", Georgia, serif;
        font-size: 0.76rem;
        font-style: italic;
        letter-spacing: 0.02em;
        white-space: nowrap;
      }

      .theme-switch {
        position: relative;
        display: grid;
        width: 44px;
        height: 44px;
        margin: -7px;
        padding: 0;
        cursor: pointer;
        place-items: center;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--entrance-text-soft);
      }

      .theme-switch::after {
        position: absolute;
        width: 28px;
        height: 28px;
        content: "";
        border-radius: 50%;
        background: var(--entrance-particle-glow);
        opacity: 0;
        transform: scale(0.72);
        transition:
          opacity 220ms cubic-bezier(0.25, 1, 0.5, 1),
          transform 220ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .theme-switch-icons {
        position: relative;
        z-index: 1;
        display: block;
        width: 21px;
        height: 21px;
      }

      .theme-icon {
        position: absolute;
        inset: 0;
        width: 21px;
        height: 21px;
        transition:
          opacity 240ms cubic-bezier(0.65, 0, 0.35, 1),
          transform 280ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      :root[data-theme="dark"] .theme-icon-moon {
        opacity: 0;
        transform: rotate(-28deg) scale(0.74);
      }

      :root[data-theme="dark"] .theme-icon-sun {
        opacity: 1;
        transform: rotate(0) scale(1);
      }

      :root[data-theme="light"] .theme-icon-moon {
        opacity: 1;
        transform: rotate(0) scale(1);
      }

      :root[data-theme="light"] .theme-icon-sun {
        opacity: 0;
        transform: rotate(28deg) scale(0.74);
      }

      .theme-switch:focus-visible,
      .hero-action:focus-visible {
        outline: 2px solid var(--entrance-focus);
        outline-offset: 5px;
      }

      /* 語言切換：圓鈕本體沿用主題鈕的尺寸與光暈，展開後在下方顯示三個選項 */
      .lang-switch {
        position: relative;
      }

      .lang-switch-button {
        position: relative;
        display: grid;
        width: 44px;
        height: 44px;
        margin: -7px;
        padding: 0;
        cursor: pointer;
        place-items: center;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--entrance-text-soft);
      }

      .lang-switch-button::after {
        position: absolute;
        width: 28px;
        height: 28px;
        content: "";
        border-radius: 50%;
        background: var(--entrance-particle-glow);
        opacity: 0;
        transform: scale(0.72);
        transition:
          opacity 220ms cubic-bezier(0.25, 1, 0.5, 1),
          transform 220ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .lang-icon {
        position: relative;
        z-index: 1;
        width: 20px;
        height: 20px;
      }

      .lang-switch-button[aria-expanded="true"] {
        color: var(--entrance-accent-bright);
      }

      .lang-switch-button[aria-expanded="true"]::after {
        opacity: 0.75;
        transform: scale(1);
      }

      .lang-menu {
        position: absolute;
        top: calc(100% + 6px);
        right: -7px;
        z-index: 30;
        display: flex;
        min-width: 148px;
        flex-direction: column;
        padding: 5px;
        gap: 1px;
        border: 1px solid var(--entrance-glass-edge);
        border-radius: 13px;
        background: var(--entrance-surface);
        box-shadow: 0 14px 32px var(--entrance-shadow);
        transform-origin: top right;
        animation: lang-menu-in 180ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .lang-menu[hidden] {
        display: none;
      }

      @keyframes lang-menu-in {
        from {
          opacity: 0;
          transform: translateY(-5px) scale(0.96);
        }
      }

      .lang-option {
        display: flex;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        padding: 8px 10px;
        cursor: pointer;
        gap: 10px;
        border: 0;
        border-radius: 9px;
        background: transparent;
        color: var(--entrance-text-soft);
        font-family: inherit;
        font-size: 0.82rem;
        letter-spacing: 0.01em;
        text-align: left;
        transition: background-color 160ms cubic-bezier(0.25, 1, 0.5, 1), color 160ms;
      }

      .lang-option[aria-checked="true"] {
        color: var(--entrance-accent-bright);
      }

      .lang-option-check {
        width: 14px;
        height: 14px;
        flex: 0 0 auto;
        opacity: 0;
      }

      .lang-option[aria-checked="true"] .lang-option-check {
        opacity: 1;
      }

      .lang-switch-button:focus-visible,
      .lang-option:focus-visible {
        outline: 2px solid var(--entrance-focus);
        outline-offset: 3px;
      }

      /* 日文語序是「品牌名 → へようこそ」，與中英文的「歡迎來到 → 品牌名」相反。
         用 grid order 對調兩行，不動 DOM 順序（h1 內的語意順序仍由 JS 依語言寫入正確文字）。
         字型也改成優先 Noto Serif JP，避免假名套用到中文（TC）的字形上。 */
      :root[data-lang="ja"] .hero-title-prefix {
        order: 2;
        font-family: "Spectral", "Noto Serif JP", "Noto Serif TC", Georgia, serif;
      }

      :root[data-lang="ja"] .hero-title em {
        order: 1;
      }

      @media (hover: hover) {
        .theme-switch:hover {
          color: var(--entrance-accent-bright);
        }

        .theme-switch:hover::after {
          opacity: 0.75;
          transform: scale(1);
        }

        .lang-switch-button:hover {
          color: var(--entrance-accent-bright);
        }

        .lang-switch-button:hover::after {
          opacity: 0.75;
          transform: scale(1);
        }

        .lang-option:hover {
          background: var(--entrance-glass-fill);
          color: var(--entrance-text);
        }

        .lang-option[aria-checked="true"]:hover {
          color: var(--entrance-accent-bright);
        }
      }

      #entrance-content {
        min-height: 0;
      }

      .entrance-stage {
        position: fixed;
        z-index: 1;
        inset: 0;
        min-width: 320px;
        overflow: hidden;
        isolation: isolate;
        background:
          radial-gradient(
            circle at 50% 33%,
            color-mix(in oklch, var(--entrance-bg-soft) 88%, transparent),
            transparent 37%
          ),
          linear-gradient(145deg, var(--entrance-bg) 0%, var(--entrance-bg-soft) 52%, var(--entrance-bg-deep) 100%);
      }

      .ambient-field {
        position: absolute;
        z-index: 1;
        inset: -30%;
        background:
          radial-gradient(
            circle at 32% 43%,
            color-mix(in oklch, var(--entrance-glow-1) 12%, transparent),
            transparent 21%
          ),
          radial-gradient(
            circle at 67% 47%,
            color-mix(in oklch, var(--entrance-glow-2) 9%, transparent),
            transparent 25%
          ),
          radial-gradient(
            circle at 54% 22%,
            color-mix(in oklch, var(--entrance-glow-3) 6%, transparent),
            transparent 18%
          );
        filter: blur(24px);
        animation: ambient-drift 22s cubic-bezier(0.65, 0, 0.35, 1) infinite alternate;
      }

      :root[data-theme="light"] .ambient-field {
        display: none;
      }

      @keyframes ambient-drift {
        0% {
          opacity: 0.74;
          transform: translate3d(-1.5%, 0.8%, 0) scale(1);
        }
        100% {
          opacity: 1;
          transform: translate3d(1.6%, -1%, 0) scale(1.025);
        }
      }

      .pointer-light {
        position: absolute;
        z-index: 4;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(
            360px circle at var(--cursor-dot-x) var(--cursor-dot-y),
            color-mix(in oklch, var(--entrance-glow-2) 8%, transparent),
            color-mix(in oklch, var(--entrance-glow-1) 2.5%, transparent) 40%,
            transparent 71%
          );
        opacity: 0.52;
      }

      .vortex-halo {
        position: absolute;
        z-index: 4;
        top: 0;
        left: 0;
        width: 270px;
        height: 270px;
        pointer-events: none;
        border-radius: 50%;
        background: conic-gradient(
          from 35deg,
          transparent,
          color-mix(in oklch, var(--entrance-glow-3) 21%, transparent),
          transparent 23%,
          transparent 66%,
          color-mix(in oklch, var(--entrance-glow-2) 15%, transparent),
          transparent
        );
        opacity: 0;
        transform: translate3d(calc(var(--cursor-dot-x) - 135px), calc(var(--cursor-dot-y) - 135px), 0);
        transition: opacity 220ms cubic-bezier(0.25, 1, 0.5, 1);
        -webkit-mask: radial-gradient(circle, transparent 0 43%, #000 49%, transparent 61%);
        mask: radial-gradient(circle, transparent 0 43%, #000 49%, transparent 61%);
        animation: halo-turn 13s linear infinite;
      }

      .entrance-page[data-pointer-active="true"] .vortex-halo {
        opacity: 0.18;
      }

      @keyframes halo-turn {
        to {
          rotate: 1turn;
        }
      }

      .orbit {
        position: absolute;
        z-index: 1;
        top: 34%;
        left: 50%;
        pointer-events: none;
        border: 1px solid var(--entrance-line);
        border-radius: 50%;
        opacity: 0.17;
      }

      .orbit-wide {
        width: min(79vw, 1080px);
        height: min(29vw, 315px);
        transform: translate(-50%, -50%) rotate(-5deg);
      }

      .orbit-tall {
        width: min(58vw, 810px);
        height: min(36vw, 410px);
        transform: translate(-50%, -50%) rotate(8deg);
        opacity: 0.1;
      }

      .particle-canvas {
        position: absolute;
        z-index: 3;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }

      .yuda-ghost {
        position: absolute;
        z-index: 2;
        top: 34%;
        left: 50%;
        color: transparent;
        font-family: "Arial Black", "Avenir Next", sans-serif;
        font-size: min(22vw, 34vh, 390px);
        font-weight: 900;
        line-height: 0.8;
        letter-spacing: -0.055em;
        opacity: 0.22;
        pointer-events: none;
        transform: translate(-50%, -50%);
        white-space: nowrap;
        -webkit-text-stroke: 0.7px var(--entrance-line);
        text-shadow: 0 0 38px color-mix(in oklch, var(--entrance-glow-3) 25%, transparent);
        animation: ghost-reveal 1100ms 120ms cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      @keyframes ghost-reveal {
        from {
          opacity: 0;
          filter: blur(14px);
          transform: translate(-50%, -50%) scale(0.97);
        }
      }

      .grain,
      .vignette {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .grain {
        z-index: 10;
        background-image:
          repeating-linear-gradient(
            100deg,
            transparent 0,
            transparent 2px,
            color-mix(in oklch, var(--entrance-text) 1.8%, transparent) 3px,
            transparent 4px
          ),
          repeating-linear-gradient(
            18deg,
            transparent 0,
            transparent 3px,
            color-mix(in oklch, var(--entrance-text) 1.3%, transparent) 4px,
            transparent 5px
          );
        opacity: 0.44;
        mix-blend-mode: soft-light;
      }

      .vignette {
        z-index: 9;
        box-shadow:
          inset 0 0 15vw color-mix(in oklch, var(--entrance-bg-deep) 72%, transparent),
          inset 0 0 4vw color-mix(in oklch, var(--entrance-bg-deep) 42%, transparent);
      }

      :root[data-theme="light"] .vignette {
        box-shadow:
          inset 0 0 13vw color-mix(in oklch, var(--entrance-bg-deep) 34%, transparent),
          inset 0 0 4vw color-mix(in oklch, var(--entrance-bg-deep) 18%, transparent);
      }

      .hero-copy {
        position: absolute;
        z-index: 7;
        top: 53%;
        left: 50%;
        width: min(88vw, 970px);
        transform: translateX(-50%);
      }

      .hero-eyebrow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: var(--entrance-text-faint);
        font-family: "DM Mono", ui-monospace, monospace;
        font-size: 0.625rem;
        line-height: 1.4;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .eyebrow-line {
        display: block;
        width: 38px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--entrance-accent-bright), transparent);
        box-shadow: 0 0 10px var(--entrance-particle-glow);
      }

      .hero-title {
        display: grid;
        margin: clamp(14px, 2.1vh, 22px) 0 0;
        color: var(--entrance-text);
        font-size: clamp(2.7rem, 5.6vw, 5.25rem);
        font-weight: 400;
        line-height: 0.98;
        row-gap: 21px;
        letter-spacing: -0.065em;
        text-align: center;
      }

      /* 「歡迎來到／Welcome to／へようこそ」：改用跟品牌名同系列但直立、非斜體的
         Spectral 襯線，安靜襯托下方的斜體漸層品牌名，不會互相搶戲；中日文沒有對應
         字符時才落回 Noto Serif TC/JP（:root[data-lang="ja"] 額外把 JP 排到 TC 前面，
         避免中文字形套用到日文假名上）。字級用 calc 從原本的比例再減 8px。 */
      .hero-title-prefix {
        font-family: "Spectral", "Noto Serif TC", Georgia, serif;
        font-size: calc(0.78em - 8px);
        font-style: normal;
        color: var(--entrance-text-soft);
        letter-spacing: -0.02em;
      }

      .hero-title em {
        margin-left: -0.03em;
        color: transparent;
        font-family: "Spectral", Georgia, serif;
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.04em;
        padding-bottom: 0.09em;
        background: linear-gradient(
          106deg,
          var(--entrance-title-gradient-a) 0%,
          var(--entrance-title-gradient-b) 31%,
          var(--entrance-title-gradient-c) 65%,
          var(--entrance-title-gradient-d) 100%
        );
        background-size: 140% 100%;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shrine-gradient-shift 10s cubic-bezier(0.65, 0, 0.35, 1) infinite alternate;
      }

      :root[data-theme="light"] .hero-title em {
        color: transparent;
        filter: drop-shadow(0 0 1.2px color-mix(in oklch, var(--entrance-accent-deep) 34%, transparent));
      }

      @keyframes shrine-gradient-shift {
        0% {
          background-position: 0% 50%;
        }
        100% {
          background-position: 34% 50%;
        }
      }

      .hero-support {
        display: grid;
        width: min(100%, 790px);
        margin: clamp(22px, 3.2vh, 34px) auto 0;
        grid-template-columns: minmax(230px, 340px) auto;
        align-items: center;
        gap: clamp(34px, 6vw, 86px);
      }

      .hero-support p {
        max-width: 38ch;
        margin: 0;
        color: var(--entrance-text-soft);
        font-size: 0.85rem;
        font-weight: 400;
        line-height: 1.65;
        text-wrap: balance;
      }

      .hero-actions {
        display: flex;
        gap: 10px;
      }

      .hero-action {
        position: relative;
        display: inline-flex;
        min-width: 168px;
        min-height: 52px;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        overflow: hidden;
        padding: 7px 8px 7px 19px;
        cursor: pointer;
        isolation: isolate;
        border: 1px solid var(--entrance-glass-edge);
        border-radius: 999px;
        background:
          linear-gradient(
            118deg,
            color-mix(in oklch, var(--entrance-glass-edge-bright) 38%, transparent) 0%,
            transparent 22%,
            transparent 70%,
            color-mix(in oklch, var(--entrance-glass-edge) 18%, transparent) 100%
          ),
          var(--entrance-glass-fill);
        color: var(--entrance-text);
        font-family: "DM Mono", ui-monospace, monospace;
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-decoration: none;
        box-shadow:
          inset 0 1px 0 var(--entrance-glass-edge-bright),
          inset 1px 0 0 color-mix(in oklch, var(--entrance-glass-edge-bright) 34%, transparent),
          inset 0 -1px 0 color-mix(in oklch, var(--entrance-glass-edge) 58%, transparent),
          0 13px 32px var(--entrance-glass-shadow);
        -webkit-backdrop-filter: blur(14px) saturate(135%) brightness(1.08);
        backdrop-filter: blur(14px) saturate(135%) brightness(1.08);
        transition:
          border-color 260ms cubic-bezier(0.25, 1, 0.5, 1),
          color 220ms cubic-bezier(0.25, 1, 0.5, 1),
          box-shadow 260ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .hero-action > span {
        position: relative;
        z-index: 1;
      }

      .hero-action::before {
        position: absolute;
        z-index: 0;
        top: -115%;
        left: -88%;
        width: 62%;
        height: 340%;
        content: "";
        background: linear-gradient(
          90deg,
          transparent 0%,
          transparent 25%,
          color-mix(in oklch, var(--entrance-glass-sheen) 82%, transparent) 46%,
          color-mix(in oklch, var(--entrance-glass-reflection) 86%, transparent) 52%,
          transparent 76%
        );
        filter: blur(1px);
        opacity: 0.32;
        pointer-events: none;
        transform: rotate(14deg) translateX(-42%);
        transition:
          opacity 220ms linear,
          transform 760ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .hero-action::after {
        position: absolute;
        z-index: 0;
        inset: 1px;
        content: "";
        pointer-events: none;
        border-radius: inherit;
        background:
          radial-gradient(
            100% 120% at 6% -36%,
            color-mix(in oklch, var(--entrance-glass-sheen) 78%, transparent),
            transparent 43%
          ),
          linear-gradient(
            180deg,
            color-mix(in oklch, var(--entrance-glass-sheen) 28%, transparent),
            transparent 43%
          );
        opacity: 0.7;
        transition: opacity 220ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .hero-action-primary,
      .hero-action-secondary {
        background-color: transparent;
      }

      .action-icon {
        display: grid;
        position: relative;
        width: 34px;
        height: 34px;
        flex: 0 0 auto;
        place-items: center;
        overflow: hidden;
        border: 1px solid color-mix(in oklch, var(--entrance-glass-edge) 86%, transparent);
        border-radius: 50%;
        background:
          linear-gradient(
            145deg,
            color-mix(in oklch, var(--entrance-glass-edge-bright) 28%, transparent),
            transparent 48%
          ),
          color-mix(in oklch, var(--entrance-glass-fill) 88%, transparent);
        color: var(--entrance-accent-bright);
        box-shadow:
          inset 0 1px 0 color-mix(in oklch, var(--entrance-glass-edge-bright) 78%, transparent),
          inset 0 -1px 0 color-mix(in oklch, var(--entrance-glass-edge) 55%, transparent);
        -webkit-backdrop-filter: blur(8px) saturate(125%);
        backdrop-filter: blur(8px) saturate(125%);
      }

      :root[data-theme="light"] .action-icon {
        color: var(--entrance-accent-deep);
      }

      .action-symbol {
        position: absolute;
        inset: 50% auto auto 50%;
        width: 16px;
        height: 16px;
        transform: translate(-50%, -50%);
        transition:
          opacity 180ms cubic-bezier(0.25, 1, 0.5, 1),
          transform 240ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .action-symbol-hover {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.66) rotate(-10deg);
      }

      .action-symbol-favicon {
        width: 14px;
        height: 18px;
        object-fit: contain;
      }

      .action-symbol-youtube {
        width: 17px;
        height: 17px;
      }

      @media (hover: hover) {
        .hero-action:hover {
          border-color: var(--entrance-glass-edge-bright);
          box-shadow:
            inset 0 1px 0 color-mix(in oklch, var(--entrance-glass-edge-bright) 94%, transparent),
            inset 1px 0 0 color-mix(in oklch, var(--entrance-glass-edge-bright) 52%, transparent),
            inset 0 -1px 0 color-mix(in oklch, var(--entrance-glass-edge) 70%, transparent),
            0 15px 36px var(--entrance-glass-shadow);
        }

        .hero-action:hover::before {
          opacity: 0.98;
          transform: rotate(14deg) translateX(360%);
        }

        .hero-action:hover::after {
          opacity: 1;
        }

        .hero-action:hover .action-symbol-default {
          opacity: 0;
          transform: translate(-50%, -50%) scale(0.68) rotate(10deg);
        }

        .hero-action:hover .action-symbol-hover {
          opacity: 1;
          transform: translate(-50%, -50%) scale(1) rotate(0);
        }
      }

      .hero-action:active {
        box-shadow:
          inset 0 1px 0 color-mix(in oklch, var(--entrance-glass-edge-bright) 70%, transparent),
          inset 0 -1px 0 color-mix(in oklch, var(--entrance-glass-edge) 70%, transparent),
          0 8px 22px var(--entrance-glass-shadow);
      }

      .entrance-footer {
        position: relative;
        z-index: 20;
        align-self: end;
        padding:
          0 max(clamp(24px, 4.7vw, 68px), env(safe-area-inset-right))
          max(clamp(22px, 3.7vh, 39px), env(safe-area-inset-bottom))
          max(clamp(24px, 4.7vw, 68px), env(safe-area-inset-left));
        pointer-events: none;
      }

      .entrance-footer p {
        margin: 0;
        color: var(--entrance-text-faint);
        font-family: "DM Mono", ui-monospace, monospace;
        font-size: 0.58rem;
        line-height: 1.5;
        letter-spacing: 0.1em;
        text-align: center;
      }

      .entrance-reveal {
        animation: entrance-rise 760ms cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      .entrance-reveal-1 {
        animation-delay: 580ms;
      }

      .entrance-reveal-2 {
        animation-delay: 670ms;
      }

      .entrance-reveal-3 {
        animation-delay: 780ms;
      }

      .entrance-reveal-4 {
        animation-delay: 900ms;
      }

      @keyframes entrance-rise {
        from {
          opacity: 0;
          transform: translate3d(0, 16px, 0);
        }
      }

      .custom-cursor {
        position: fixed;
        z-index: 60;
        top: 0;
        left: 0;
        display: none;
        pointer-events: none;
        will-change: transform;
      }

      .cursor-dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--entrance-accent-bright);
        box-shadow: 0 0 12px var(--entrance-accent);
        transform: translate3d(calc(var(--cursor-dot-x) - 2px), calc(var(--cursor-dot-y) - 2px), 0);
      }

      .cursor-ring {
        width: 36px;
        height: 36px;
        border: 1px solid var(--entrance-line-strong);
        border-radius: 50%;
        opacity: 0.78;
        transform: translate3d(calc(var(--cursor-x) - 18px), calc(var(--cursor-y) - 18px), 0) scale(var(--cursor-scale));
        transition:
          opacity 160ms linear,
          border-color 180ms linear;
      }

      @media (pointer: fine) and (hover: hover) {
        .custom-cursor {
          display: block;
        }

        .entrance-page,
        .entrance-page a,
        .entrance-page button {
          cursor: none;
        }
      }

      @media (max-height: 760px) and (min-width: 721px) {
        .orbit,
        .yuda-ghost {
          top: 29%;
        }

        .hero-copy {
          top: 45.5%;
        }

        .hero-title {
          margin-top: 10px;
          font-size: clamp(2.55rem, 5.1vw, 4rem);
        }

        .hero-support {
          margin-top: 18px;
        }

        .hero-action {
          min-height: 48px;
        }
      }

      @media (max-width: 720px) {
        .custom-cursor {
          display: none !important;
        }

        .entrance-page,
        .entrance-page a,
        .entrance-page button {
          cursor: auto;
        }

        .entrance-page a,
        .entrance-page button {
          cursor: pointer;
        }

        .entrance-header {
          padding-top: max(20px, env(safe-area-inset-top));
          padding-inline: max(20px, env(safe-area-inset-left));
        }

        .brand-logo {
          width: 36px;
          height: 36px;
        }

        .brand-copy span {
          font-size: 0.66rem;
          letter-spacing: 0.01em;
        }

        .entrance-stage {
          background:
            radial-gradient(
              circle at 50% 25%,
              color-mix(in oklch, var(--entrance-bg-soft) 92%, transparent),
              transparent 32%
            ),
            linear-gradient(155deg, var(--entrance-bg) 0%, var(--entrance-bg-soft) 54%, var(--entrance-bg-deep) 100%);
        }

        .orbit,
        .yuda-ghost {
          top: 26.5%;
        }

        .orbit-wide {
          width: 112vw;
          height: 42vw;
        }

        .orbit-tall {
          width: 88vw;
          height: 54vw;
        }

        .yuda-ghost {
          font-size: min(23vw, 18vh);
        }

        .hero-copy {
          top: 42.5%;
          width: calc(100% - 40px);
        }

        .hero-eyebrow {
          justify-content: flex-start;
          gap: 9px;
          font-size: 0.56rem;
          letter-spacing: 0.12em;
        }

        .eyebrow-line {
          width: 27px;
        }

        .hero-title {
          margin-top: 13px;
          font-size: clamp(2.55rem, 12.2vw, 4rem);
          line-height: 1.01;
          text-align: left;
        }

        .hero-title-prefix {
          font-size: calc(0.75em - 8px);
        }

        .hero-support {
          display: block;
          width: 100%;
          margin-top: 20px;
        }

        .hero-support p {
          max-width: 35ch;
          font-size: 0.8rem;
          line-height: 1.62;
          text-wrap: pretty;
        }

        .hero-actions {
          width: 100%;
          margin-top: 58px;
        }

        .hero-action {
          min-width: 0;
          min-height: 50px;
          flex: 1 1 0;
          gap: 8px;
          padding-left: 15px;
          font-size: 0.62rem;
        }

        .action-icon {
          width: 32px;
          height: 32px;
        }

        .entrance-footer {
          padding-inline: 20px;
          padding-bottom: max(18px, env(safe-area-inset-bottom));
        }

        .entrance-footer p {
          max-width: 35ch;
          margin-inline: auto;
          font-size: 0.52rem;
          line-height: 1.65;
          letter-spacing: 0.075em;
        }

        .vortex-halo {
          width: 180px;
