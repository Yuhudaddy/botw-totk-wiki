           解開後播放語音、左上角 Logo 亮起光暈並變成通往海島版入口的連結。
           狀態不落地（每次進頁重置）、僅英文標題有效、按錯默默從頭來。 */
        var SECRET_SEQUENCE = ["y", "u", "D", "a"];
        var SECRET_TITLE = "Dazotikuy Shrine";
        // 對應 SECRET_TITLE 中的字元索引：D=0、a=1、u=7、y=8
        var SECRET_INDICES = { D: 0, a: 1, u: 7, y: 8 };
        var secretBrand = document.querySelector(".entrance-brand");
        var secretTitle = document.querySelector(".hero-title");
        var secretProgress = 0;
        var secretUnlocked = false;
        var secretAudio = null;
        var secretLetterClips = {};

        function rebuildSecretLetters() {
          if (!secretTitle) return;
          var oldLayer = secretTitle.querySelector(".secret-layer");
          if (oldLayer) oldLayer.remove();
          secretProgress = 0;
          if (secretUnlocked) return;
          if (root.getAttribute("data-lang") !== "en") return;

          var em = secretTitle.querySelector("em");
          var textNode = em && em.firstChild;
          // 防呆：標題文字必須正好是英文版原文，索引才有意義
          if (!textNode || textNode.nodeType !== 3 || textNode.nodeValue !== SECRET_TITLE) return;

          var layer = document.createElement("span");
          layer.className = "secret-layer";
          layer.setAttribute("aria-hidden", "true");

          var titleRect = secretTitle.getBoundingClientRect();
          // Range rect 的高度是字體的 em box（Spectral 內建行距約 1.52），
          // 但標題行盒被 line-height: 0.98 壓得比它矮，字形以行盒為中心
          // 上下溢出。覆蓋字母的盒子是自己的行盒（同樣 0.98），若直接用
          // rect.top 對齊 em box，字形會整體偏高約 (emBox − 行盒)/2。
          // 這裡把 top 補回這段差值，讓兩邊的「行盒」對齊＝字形對齊。
          var emLineHeight = parseFloat(window.getComputedStyle(em).lineHeight);
          SECRET_SEQUENCE.forEach(function (ch) {
            var range = document.createRange();
            range.setStart(textNode, SECRET_INDICES[ch]);
            range.setEnd(textNode, SECRET_INDICES[ch] + 1);
            var rect = range.getBoundingClientRect();
            var baselineFix = emLineHeight > 0 ? (rect.height - emLineHeight) / 2 : 0;
            var letter = document.createElement("span");
            letter.className = "secret-letter";
            letter.dataset.ch = ch;
            letter.textContent = ch;
            letter.style.left = rect.left - titleRect.left + "px";
            letter.style.top = rect.top - titleRect.top + baselineFix + "px";
            layer.appendChild(letter);
          });
          secretTitle.appendChild(layer);
          // 熱區建好＝彩蛋在這個語系下是活的，順便把 4 個字母音效預先建立、
          // 開始背景下載，避免使用者點第一個字母（通常是 y）時才臨時抓檔案，
          // 感覺特別卡（見 playLetterSound 的原本寫法：點到才 new Audio）
          prepareLetterSoundClips();
        }

        function prepareSecretAudio() {
          if (secretAudio || !secretBrand) return;
          var src = secretBrand.getAttribute("data-secret-voice");
          if (!src) return;
          secretAudio = new Audio(src);
          secretAudio.preload = "auto";
        }

        // 4 個字母音效統一在這裡建立（見 rebuildSecretLetters 呼叫處），
        // playLetterSound 只負責找已經建好的 clip 來播；找不到才當保險網現場建立
        function prepareLetterSoundClips() {
          if (!secretTitle) return;
          Object.keys(SECRET_INDICES).forEach(function (ch) {
            if (secretLetterClips[ch]) return;
            var src = secretTitle.dataset["sound" + ch.toUpperCase()];
            if (!src) return;
            var audio = new Audio(src);
            audio.preload = "auto";
            audio.volume = 0.45;
            secretLetterClips[ch] = audio;
          });
        }

        // 序列輸入過程中，每點對一個字母就播一段短音效（跟解鎖瞬間的
        // mitsukachattane 語音是兩回事，音量刻意壓低，不搶最後的語音）
        function playLetterSound(ch) {
          if (!secretTitle) return;
          var audio = secretLetterClips[ch];
          if (!audio) {
            var src = secretTitle.dataset["sound" + ch.toUpperCase()];
            if (!src) return;
            audio = new Audio(src);
            audio.preload = "auto";
            audio.volume = 0.45;
            secretLetterClips[ch] = audio;
          }
          try {
            audio.currentTime = 0;
            audio.play();
          } catch (error) {}
        }

        // 使用者第一次跟頁面互動時（不限定點在哪），偷播一次靜音音效讓瀏覽器
        // 把音訊輸出管線熱機——這筆初始化成本通常只在分頁生命週期第一次真正
        // 播放聲音時才會發生，跟個別檔案有沒有載入完成是兩回事，prepareLetterSoundClips
        // 只能省下下載時間，省不了這筆。掛在 pointerdown 而非 click 是因為就算
        // 使用者第一次點擊就直接點在 y 上，pointerdown 也會早於 click 觸發，
        // 讓熱機的 play() 搶先一步開始，不會跟真正的播放完全撞在一起。
        // 不用 { once: true }：如果使用者第一次互動發生在字型還沒載完、
        // secretLetterClips 還沒建好之前，直接移除監聽會讓熱機永遠沒機會發生，
        // 改成只有真正熱機成功才移除，之前的 pointerdown 就先靜靜略過。
        function warmUpAudioPipeline() {
          var probe = secretLetterClips.y;
          if (!probe) return;
          document.removeEventListener("pointerdown", warmUpAudioPipeline);
          var vol = probe.volume;
          probe.volume = 0;
          var playing = probe.play();
          if (playing && playing.then) {
            playing.then(
              function () {
                probe.pause();
                probe.currentTime = 0;
                probe.volume = vol;
              },
              function () { probe.volume = vol; }
            );
          }
        }
        document.addEventListener("pointerdown", warmUpAudioPipeline, { passive: true });

        function clearSecretHits() {
          if (!secretTitle) return;
          secretTitle.querySelectorAll(".secret-letter.is-hit").forEach(function (el) {
            el.classList.remove("is-hit");
          });
        }

        function unlockSecret() {
          secretUnlocked = true;
          if (secretBrand) {
            var target = secretBrand.getAttribute("data-secret-href");
            if (target) secretBrand.setAttribute("href", target);
            secretBrand.classList.add("is-secret-unlocked");
            var t = I18N[currentLang()] || I18N.en;
            secretBrand.setAttribute("aria-label", t.brandLink);
            secretBrand.dataset.secretState = "unlocked";
          }
          if (secretAudio) {
            secretAudio.currentTime = 0;
            var playing = secretAudio.play();
            if (playing && playing.then) {
              playing.then(
                function () { if (secretBrand) secretBrand.dataset.secretAudio = "played"; },
                function () { if (secretBrand) secretBrand.dataset.secretAudio = "blocked"; }
              );
            }
          }
          // 四個字母亮著停一拍，再一起淡回原樣，最後整層拆掉
          window.setTimeout(function () {
            clearSecretHits();
            window.setTimeout(function () {
              var layer = secretTitle && secretTitle.querySelector(".secret-layer");
              if (layer) layer.remove();
            }, 420);
          }, 1100);
        }

        if (secretTitle && secretBrand) {
          // 按錯的定義是「點了下一個該點的字母以外的任何地方」，不只是
          // 點錯另一個字母——點在標題其他文字、頁面其他角落都算，所以
          // 監聽要掛在 document 上，而不是只掛在 secretTitle 底下。
          document.addEventListener("click", function (event) {
            if (secretUnlocked) return;
            var target = event.target;
            var letter = target && target.closest ? target.closest(".secret-letter") : null;
            var ch = letter ? letter.dataset.ch : null;
            if (ch && ch === SECRET_SEQUENCE[secretProgress]) {
              letter.classList.add("is-hit");
              playLetterSound(ch);
              secretProgress += 1;
              if (secretProgress === 1) prepareSecretAudio();
              if (secretProgress === SECRET_SEQUENCE.length) unlockSecret();
            } else {
              // 按錯：全部熄滅、無任何提示；若按的正好是序列開頭，直接當新的開始
              clearSecretHits();
              if (ch === SECRET_SEQUENCE[0]) {
                letter.classList.add("is-hit");
                playLetterSound(ch);
                secretProgress = 1;
                prepareSecretAudio();
              } else {
                secretProgress = 0;
              }
            }
          });

          // 字母座標是實量出來的，任何會改變排版的事都要重量一次：
          // 字體載入完成（字寬變）、視窗縮放（字級 clamp 變）。
          // ResizeObserver 直接盯標題尺寸，比 window resize 更貼近「排版真的變了」；
          // 兩者都掛是雙保險，rebuild 本身冪等而且便宜。
          // rebuild 會順便歸零進度——彩蛋精神是無提示，中斷就重來。
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(rebuildSecretLetters);
          }
          var secretResizeTimer = 0;
          function queueSecretRebuild() {
            window.clearTimeout(secretResizeTimer);
            secretResizeTimer = window.setTimeout(rebuildSecretLetters, 160);
          }
          window.addEventListener("resize", queueSecretRebuild);
          if (typeof ResizeObserver === "function") {
            new ResizeObserver(queueSecretRebuild).observe(secretTitle);
          }
        }

        applyLang(currentLang());

        if (themeButton) {
          themeButton.addEventListener("click", function () {
            var next = currentTheme() === "dark" ? "light" : "dark";
            root.setAttribute("data-theme", next);
            root.style.colorScheme = next;
            try {
              localStorage.setItem("wiki-theme", next);
            } catch (error) {}
            syncThemeControl();
            window.dispatchEvent(new CustomEvent("wiki-theme-change", { detail: next }));
          });
          themeButton.addEventListener("pointerup", function () {
            themeButton.blur();
          });
        }

        var canvas = document.getElementById("yuda-particles");
        if (!(canvas instanceof HTMLCanvasElement)) return;

        var context = canvas.getContext("2d", { alpha: true });
        if (!context) return;

        var reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        var palettes = {
          // 深色模式：乳白 / 暖灰 / 英傑藍 / 希卡土。
          // 深色模式用 "lighter" 疊加，顏色越亮堆疊效果越明顯。
          dark: [
            [255, 253, 230],
            [176, 170, 155],
            [88, 148, 235],
            [220, 191, 124],
          ],
          // 淺色模式用 "source-over" 畫在白底上，必須反過來取深色，
          // 照抄深色那組會整片消失。
          light: [
            [22, 80, 150],
            [122, 94, 40],
            [115, 110, 100],
            [160, 140, 105],
          ],
        };

        var width = 0;
        var height = 0;
        var dpr = 1;
        var particles = [];
        var dust = [];
        var resizeTimer = 0;
        var lastFrame = performance.now();
        var cursorTargetX = window.innerWidth / 2;
        var cursorTargetY = window.innerHeight / 2;
        var cursorRingX = cursorTargetX;
        var cursorRingY = cursorTargetY;
        var pointer = {
          x: cursorTargetX,
          y: cursorTargetY,
          smoothX: cursorTargetX,
          smoothY: cursorTargetY,
          moveX: 0,
          moveY: 0,
          speed: 0,
          active: false,
          lastX: cursorTargetX,
          lastY: cursorTargetY,
        };

        function clamp(value, min, max) {
          return Math.max(min, Math.min(max, value));
        }

        function seededRandom(seed) {
          return function () {
            seed |= 0;
            seed = (seed + 0x6d2b79f5) | 0;
            var value = Math.imul(seed ^ (seed >>> 15), 1 | seed);
            value = (value + Math.imul(value ^ (value >>> 7), 61 | value)) ^ value;
            return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
          };
        }

        function shuffle(items, random) {
          for (var index = items.length - 1; index > 0; index -= 1) {
            var swapIndex = Math.floor(random() * (index + 1));
            var temporary = items[index];
            items[index] = items[swapIndex];
            items[swapIndex] = temporary;
          }
          return items;
        }

        function maskCenterY() {
          if (width <= 720) return height * (height <= 700 ? 0.235 : 0.265);
          if (height <= 760) return height * 0.29;
          return height * 0.34;
        }

        function createMaskTargets() {
          var random = seededRandom(2026);
          var mask = document.createElement("canvas");
          mask.width = width;
          mask.height = height;
          var maskContext = mask.getContext("2d", { willReadFrequently: true });
          if (!maskContext) return [];

          var fontSize = Math.min(width * 0.22, height * 0.34, 390);
          if (width <= 720) {
            fontSize = Math.min(width * 0.28, height * 0.19);
          } else if (height <= 760) {
            fontSize = Math.min(width * 0.22, height * 0.3, 310);
          }

          maskContext.font = "900 " + fontSize + 'px "Arial Black", "Avenir Next", Arial, sans-serif';
          var measuredWidth = maskContext.measureText("YUDA").width;
          var maxWordWidth = width * (width <= 720 ? 0.86 : 0.74);
          if (measuredWidth > maxWordWidth) {
            fontSize *= maxWordWidth / measuredWidth;
            maskContext.font = "900 " + fontSize + 'px "Arial Black", "Avenir Next", Arial, sans-serif';
          }

          maskContext.fillStyle = "#fff";
          maskContext.textAlign = "center";
          maskContext.textBaseline = "middle";
          maskContext.fillText("YUDA", width / 2, maskCenterY());

          var image = maskContext.getImageData(0, 0, width, height);
          var points = [];
          var step = width <= 720 ? 3 : 6;
          var offset = Math.floor(step / 2);

          for (var y = offset; y < height; y += step) {
            for (var x = offset; x < width; x += step) {
              var alpha = image.data[(y * width + x) * 4 + 3];
              if (alpha > 80 && random() > 0.055) {
                points.push({
                  x: x + (random() - 0.5) * step * 0.45,
                  y: y + (random() - 0.5) * step * 0.45,
                });
              }
            }
          }

          return shuffle(points, random);
        }

        function createParticles() {
          var random = seededRandom(2026);
          var targets = createMaskTargets();
          if (!targets.length) {
            particles = [];
            return;
          }

          var desiredCount =
            width <= 720
              ? clamp(Math.floor((width * height) / 500), 640, 960)
              : clamp(Math.floor((width * height) / 610), 1250, 2200);
          var count = Math.min(desiredCount, targets.length);
          var centreX = width / 2;
          var centreY = maskCenterY();
          var startSettled = reducedMotion.matches;

          particles = [];
          for (var index = 0; index < count; index += 1) {
            var target = targets[Math.floor((index / count) * targets.length)];
            var angle = random() * Math.PI * 2;
            var radius = Math.max(width, height) * (0.24 + random() * 0.76);
            var startX = startSettled ? target.x + (random() - 0.5) * 28 : centreX + Math.cos(angle) * radius;
            var startY = startSettled ? target.y + (random() - 0.5) * 28 : centreY + Math.sin(angle) * radius;

            particles.push({
              x: startX,
              y: startY,
              tx: target.x,
              ty: target.y,
              vx: (random() - 0.5) * 1.8,
              vy: (random() - 0.5) * 1.8,
              size:
                width <= 720
                  ? 0.48 + random() * 1.08
                  : 0.6 + random() * 1.35,
              depth: 0.25 + random() * 0.75,
              phase: random() * Math.PI * 2,
              color: Math.floor(random() * 4),
              orbitSpeed: 0.46 + random() * 0.74,
            });
          }
        }

        function createDust() {
          var random = seededRandom(704);
          var count = width <= 720 ? 48 : 105;
          dust = [];
          for (var index = 0; index < count; index += 1) {
            dust.push({
              x: random() * width,
              y: random() * height,
              speed: 0.03 + random() * 0.1,
              size: 0.35 + random() * 1.1,
              alpha: 0.09 + random() * 0.3,
              depth: 0.2 + random() * 0.8,
            });
          }
        }

        function resizeCanvas() {
          width = Math.max(320, window.innerWidth);
          height = Math.max(480, window.innerHeight);
          dpr = Math.min(window.devicePixelRatio || 1, 1.6);
          canvas.width = Math.round(width * dpr);
          canvas.height = Math.round(height * dpr);
          canvas.style.width = width + "px";
          canvas.style.height = height + "px";
          context.setTransform(dpr, 0, 0, dpr, 0, 0);
          createParticles();
          createDust();
        }

        function setPointerPosition(clientX, clientY, movementX, movementY) {
          var deltaX = typeof movementX === "number" ? movementX : clientX - pointer.lastX;
          var deltaY = typeof movementY === "number" ? movementY : clientY - pointer.lastY;
          pointer.x = clientX;
          pointer.y = clientY;
          pointer.lastX = clientX;
          pointer.lastY = clientY;
          pointer.moveX = pointer.moveX * 0.45 + deltaX * 0.55;
          pointer.moveY = pointer.moveY * 0.45 + deltaY * 0.55;
          pointer.speed = clamp(Math.hypot(pointer.moveX, pointer.moveY), 0, 42);
          pointer.active = true;
          cursorTargetX = clientX;
          cursorTargetY = clientY;
          if (page) page.setAttribute("data-pointer-active", "true");
        }

        window.addEventListener(
          "pointermove",
          function (event) {
            setPointerPosition(event.clientX, event.clientY, event.movementX, event.movementY);
          },
          { passive: true, capture: true }
        );

        window.addEventListener(
          "touchmove",
          function (event) {
            if (!event.touches.length) return;
            var touch = event.touches[0];
            setPointerPosition(touch.clientX, touch.clientY);
          },
          { passive: true }
        );

        function deactivatePointer() {
          pointer.active = false;
          pointer.moveX = 0;
          pointer.moveY = 0;
          pointer.speed = 0;
          if (page) page.setAttribute("data-pointer-active", "false");
        }

        document.documentElement.addEventListener("mouseleave", deactivatePointer);
        window.addEventListener("blur", deactivatePointer);
        window.addEventListener(
          "touchend",
          function () {
            window.setTimeout(deactivatePointer, 160);
          },
          { passive: true }
        );

        document.addEventListener(
          "pointerover",
          function (event) {
            var target = event.target;
            var interactive =
              target instanceof Element && target.closest("a, button");
            root.style.setProperty("--cursor-scale", interactive ? "1.5" : "1");
          },
          { passive: true }
        );

        function updateCursor() {
          cursorRingX += (cursorTargetX - cursorRingX) * 0.16;
          cursorRingY += (cursorTargetY - cursorRingY) * 0.16;
          root.style.setProperty("--cursor-x", cursorRingX + "px");
          root.style.setProperty("--cursor-y", cursorRingY + "px");
          root.style.setProperty("--cursor-dot-x", cursorTargetX + "px");
          root.style.setProperty("--cursor-dot-y", cursorTargetY + "px");
        }

        function renderDust(delta, palette, lightMode) {
          var dustPath = new Path2D();
          for (var index = 0; index < dust.length; index += 1) {
            var mote = dust[index];
            mote.y -= mote.speed * mote.depth * delta;
            mote.x += Math.sin(mote.y * 0.006 + index) * 0.012 * delta;
            if (mote.y < -8) {
              mote.y = height + 8;
            }
            dustPath.moveTo(mote.x + mote.size, mote.y);
            dustPath.arc(mote.x, mote.y, mote.size, 0, Math.PI * 2);
          }
          context.globalCompositeOperation = lightMode ? "source-over" : "lighter";
          context.globalAlpha = lightMode ? 0.18 : 0.28;
          context.fillStyle =
            "rgb(" + palette[1][0] + " " + palette[1][1] + " " + palette[1][2] + ")";
          context.fill(dustPath);
          context.globalAlpha = 1;
        }

        function animate(frameTime) {
          var delta = clamp((frameTime - lastFrame) / 16.6667, 0.35, 1.8);
          lastFrame = frameTime;
          var time = frameTime * 0.001;
          var theme = currentTheme();
          var palette = palettes[theme];
          var lightMode = theme === "light";
          var motionScale = reducedMotion.matches ? 0.34 : 1;
          var vortexScale = reducedMotion.matches ? 0.66 : 1;
          var influence = width <= 720 ? 160 : 270;
          var spring = reducedMotion.matches ? 0.026 : 0.021;
          var damping = 0.9;
          var trails = [new Path2D(), new Path2D(), new Path2D(), new Path2D()];
          var dots = [new Path2D(), new Path2D(), new Path2D(), new Path2D()];
          var glows = [new Path2D(), new Path2D(), new Path2D(), new Path2D()];

          pointer.smoothX += (pointer.x - pointer.smoothX) * 0.14;
          pointer.smoothY += (pointer.y - pointer.smoothY) * 0.14;
          pointer.moveX *= 0.94;
          pointer.moveY *= 0.94;
          pointer.speed *= 0.96;
          updateCursor();

          context.clearRect(0, 0, width, height);
          renderDust(delta, palette, lightMode);

          for (var index = 0; index < particles.length; index += 1) {
            var particle = particles[index];
            var idleRadius = (1.7 + particle.depth * 4.4) * motionScale;
            var idleAngle = time * particle.orbitSpeed + particle.phase;
            var floatX = Math.cos(idleAngle) * idleRadius;
            var floatY = Math.sin(idleAngle * 0.86) * idleRadius * 0.76;
            var flow =
              (0.009 +
                particle.depth *
                  0.014 *
                  Math.sin(time * 0.54 + particle.phase)) *
              motionScale;
            var vortexStrength = 0;
            var localSpring = spring;

            particle.vx +=
              Math.sin(particle.y * 0.011 + time * 0.72 + particle.phase) *
              flow *
              delta;
            particle.vy +=
              Math.cos(particle.x * 0.009 - time * 0.61 + particle.phase) *
              flow *
              delta;

            if (pointer.active) {
              var dx = particle.x - pointer.smoothX;
              var dy = particle.y - pointer.smoothY;
              var distance = Math.hypot(dx, dy);

              if (distance < influence && distance > 0.1) {
                vortexStrength =
                  Math.pow((influence - distance) / influence, 1.18) *
                  vortexScale;
                localSpring = spring * (1 - vortexStrength * 0.965);

                var unitX = dx / distance;
                var unitY = dy / distance;
                var tangentX = -unitY;
                var tangentY = unitX;
                var orbitRadius =
                  43 + particle.depth * 35 + Math.min(pointer.speed, 24) * 0.9;
                var radialForce =
                  (orbitRadius - distance) * 0.039 * vortexStrength;
                var swirlForce =
                  (1.9 + particle.depth * 3.1 + pointer.speed * 0.075) *
                  vortexStrength;

                particle.vx +=
                  (unitX * radialForce +
                    tangentX * swirlForce +
                    pointer.moveX * vortexStrength * 0.013) *
                  delta;
                particle.vy +=
                  (unitY * radialForce +
                    tangentY * swirlForce +
                    pointer.moveY * vortexStrength * 0.013) *
                  delta;
              }
            }

            particle.vx +=
              (particle.tx + floatX - particle.x) * localSpring * delta;
            particle.vy +=
              (particle.ty + floatY - particle.y) * localSpring * delta;

            var localDamping = damping + vortexStrength * 0.045;
            particle.vx *= Math.pow(localDamping, delta);
            particle.vy *= Math.pow(localDamping, delta);

            var velocity = Math.hypot(particle.vx, particle.vy);
            var maxVelocity = 15 + pointer.speed * 0.08;
            if (velocity > maxVelocity) {
              var velocityScale = maxVelocity / velocity;
              particle.vx *= velocityScale;
              particle.vy *= velocityScale;
              velocity = maxVelocity;
            }

            particle.x += particle.vx * delta;
            particle.y += particle.vy * delta;

            if (!reducedMotion.matches && velocity > 0.48) {
              var trailScale = Math.min(3.1, 1.25 + velocity * 0.13);
              trails[particle.color].moveTo(particle.x, particle.y);
              trails[particle.color].lineTo(
                particle.x - particle.vx * trailScale,
                particle.y - particle.vy * trailScale
              );
            }

            var shimmer =
              0.9 + Math.sin(time * 1.8 + particle.phase) * 0.12;
            var radius = particle.size * shimmer;
            dots[particle.color].moveTo(particle.x + radius, particle.y);
            dots[particle.color].arc(
              particle.x,
              particle.y,
              radius,
              0,
              Math.PI * 2
            );

            if (particle.size > 1.55) {
              var glowRadius = particle.size * 3.8;
              glows[particle.color].moveTo(particle.x + glowRadius, particle.y);
              glows[particle.color].arc(
                particle.x,
                particle.y,
                glowRadius,
                0,
                Math.PI * 2
              );
            }
          }

          context.globalCompositeOperation = lightMode ? "source-over" : "lighter";
          context.lineCap = "round";
          context.lineWidth = 0.72;

          for (var colorIndex = 0; colorIndex < palette.length; colorIndex += 1) {
            var color = palette[colorIndex];
            var colorValue = color[0] + " " + color[1] + " " + color[2];

            if (!reducedMotion.matches) {
              context.globalAlpha = lightMode ? 0.14 : 0.13;
              context.strokeStyle = "rgb(" + colorValue + ")";
              context.stroke(trails[colorIndex]);
            }

            context.globalAlpha = lightMode ? 0.075 : 0.07;
            context.fillStyle = "rgb(" + colorValue + ")";
            context.fill(glows[colorIndex]);

            context.globalAlpha = lightMode ? 0.82 : 0.9;
            context.fillStyle = "rgb(" + colorValue + ")";
            context.fill(dots[colorIndex]);
          }

          context.globalAlpha = 1;
          context.globalCompositeOperation = "source-over";
          window.requestAnimationFrame(animate);
        }

        window.addEventListener(
          "resize",
          function () {
            window.clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(resizeCanvas, 120);
          },
          { passive: true }
        );

        resizeCanvas();
        window.requestAnimationFrame(animate);
      })();
    </script>
  </body>
</html>
