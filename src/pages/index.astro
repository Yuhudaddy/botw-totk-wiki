---
import { SITE } from "../data/site";
import { href } from "../lib/url";

// 入口頁本身就在 "/"，兩顆按鈕與站內導引一律指向攻略首頁 "/home"
const wikiHomeUrl = href("/home");
// 進站按鈕的目的地跟著入口頁選的語言走：日文 → 日文站，中文／英文 → 中文站
// （站內目前沒有英文版，英文選項先併入中文站）。href 屬性本身仍是 wikiHomeUrl
// （SSR 首繪、JS 未執行時的保底值），applyLang() 會依 data-lang 覆寫成對應語言。
const wikiHomeUrlJa = href("/home", "ja");
// 左上角 Logo 是通往 entrance-ocean 的隱藏門：預設不可點，
// 解開標題彩蛋（依序點擊 Dazotikuy 的 y→u→D→a，倒拼出 Yuda）後才會亮起、變成連結
const oceanEntranceUrl = href("/entrance-ocean");
// 彩蛋解開瞬間播放的語音（原檔名「みつかちゃったね」，改用 ASCII 檔名避免
// macOS NFD／GitHub Pages 之間的 Unicode 正規化差異造成 404）
const secretVoiceUrl = href("/entrance-voice/mitsukachattane.mp3");
// 序列輸入過程中，每點對一個字母（y/u/D/a）就播放的短音效
const secretLetterVoices = {
  y: href("/entrance-voice/y.wav"),
  u: href("/entrance-voice/u.wav"),
  D: href("/entrance-voice/D.wav"),
  a: href("/entrance-voice/a.wav"),
};

// 入口頁不走 BaseLayout（它有自己的整頁版面），所以社群分享標籤要在這裡各補一份。
// 這頁是網址最短、最常被貼出去分享的一頁，缺了縮圖影響最大。
const entranceDescription =
  "Advanced game guides and mechanics for The Legend of Zelda, Super Smash Bros., and beyond.";
const canonicalUrl = new URL(href("/"), Astro.site).href;
const ogImageUrl = new URL(href("/og-image.jpg"), Astro.site).href;

// 搜尋結果與瀏覽器分頁上顯示的名稱。神廟名稱擺最前面——這是站的招牌，
// 也是使用者希望在 Google 上被看到的名字。這串不影響畫面上的任何文字。
//
// ※ 這頁的標題會被頁尾的語言切換 script 依語言覆寫（見下方 i18n 的 docTitle），
//   所以這裡改了、那邊三個語言版本也要一起改，否則載入後又被蓋回舊字串。
//   靜態值用英文版，因為入口頁預設語言就是英文。
const entranceTitle = `${SITE.shortTitle} · Yuda's Channel Game Wiki`;
---

<!doctype html>
<html lang="en" class="entrance-html">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={entranceDescription} />
    {/* Google Search Console 的擁有權驗證。這串不是機密（本來就公開在原始碼裡），
        但不能刪——刪掉 Google 會判定驗證失效，Search Console 的資料就斷了。 */}
    <meta name="google-site-verification" content="WZrHSF2yf3HQZ-aEsslluBQvRXB3zK6FG0TjTfy_63o" />
    <meta name="theme-color" content="#0f0304" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{entranceTitle}</title>

    <meta property="og:title" content={entranceTitle} />
    <meta property="og:description" content={entranceDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={entranceTitle} />
    <meta name="twitter:description" content={entranceDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;600&family=Noto+Serif+TC:wght@400&family=Noto+Serif+JP:wght@400&family=Spectral:ital,wght@0,400;0,500;1,400;1,500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        var theme = "dark";
        try {
          var saved = localStorage.getItem("wiki-theme");
          if (saved === "light" || saved === "dark") {
            theme = saved;
          } else {
            theme = window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
          }
        } catch (error) {
          theme = "dark";
        }
        document.documentElement.setAttribute("data-theme", theme);
        document.documentElement.style.colorScheme = theme;

        // 入口頁語言：預設一律英文，不依瀏覽器語言判斷；使用者從右上角手動選過
        // 之後才會記住那個選擇（存在 localStorage）。在 head 就決定並寫上 data-lang，
        // 讓日文標題的語序（CSS order）與字體在首次繪製前就定案，避免先閃一下英文版排版。
        // 實際文字替換在 body 末端的 script。
        var lang = "en";
        try {
          var savedLang = localStorage.getItem("entrance-lang");
          if (savedLang === "zh" || savedLang === "en" || savedLang === "ja") {
            lang = savedLang;
          }
        } catch (error) {
          lang = "en";
        }
        document.documentElement.setAttribute("data-lang", lang);
        document.documentElement.setAttribute(
          "lang",
          lang === "zh" ? "zh-Hant-TW" : lang === "ja" ? "ja" : "en"
        );
      })();
    </script>
  </head>

  <body class="entrance-page">
    <a class="skip-link" href="#entrance-content">Skip to main content</a>

    <header class="entrance-header">
      {/* Logo 平常只是圖，不是連結：沒有 href 的 <a> 不可點、不進 Tab 順序、
          也不會被讀屏當成連結。解開標題彩蛋後由 JS 補上 href（指向海島版入口）
          並加上 is-secret-unlocked 的光暈。進站本身一律走下方的 Enter Shrine 按鈕。 */}
      <a
        class="entrance-brand"
        data-secret-href={oceanEntranceUrl}
        data-secret-voice={secretVoiceUrl}
      >
        <picture class="brand-logo-pic">
          <source srcset={href("/logo/yuda-logo.webp")} type="image/webp" />
          <img class="brand-logo" src={href("/logo/yuda-logo.png")} alt="" />
        </picture>
        <span class="brand-copy">
          <span>Dazotikuy Shrine</span>
        </span>
      </a>

      <div class="entrance-header-actions">
        {/* 語言切換：只影響入口頁的文案，站內其他頁面維持中文 */}
        <div class="lang-switch" id="entrance-lang-switch">
          <button
            class="lang-switch-button"
            id="entrance-lang-button"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="entrance-lang-menu"
            aria-label="Change language"
          >
            <svg class="lang-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.45" />
              <path
                d="M3.3 9.6h17.4M3.3 14.4h17.4"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
              />
              <path
                d="M12 3a14.4 14.4 0 0 1 0 18 14.4 14.4 0 0 1 0-18Z"
                stroke="currentColor"
                stroke-width="1.3"
              />
            </svg>
          </button>

          <div class="lang-menu" id="entrance-lang-menu" role="menu" aria-label="Language" hidden>
            <button class="lang-option" type="button" role="menuitemradio" aria-checked="false" data-lang-option="zh">
              <span class="lang-option-label">繁體中文</span>
              <svg class="lang-option-check" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12.5 10 17.5 19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button class="lang-option" type="button" role="menuitemradio" aria-checked="false" data-lang-option="en">
              <span class="lang-option-label">English</span>
              <svg class="lang-option-check" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12.5 10 17.5 19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button class="lang-option" type="button" role="menuitemradio" aria-checked="false" data-lang-option="ja">
              <span class="lang-option-label">日本語</span>
              <svg class="lang-option-check" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12.5 10 17.5 19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>

        <button
          class="theme-switch"
          id="entrance-theme-switch"
          type="button"
          aria-label="Switch to light theme"
        >
          <span class="theme-switch-icons" aria-hidden="true">
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none">
            <path
              d="M19.6 15.2A8.2 8.2 0 0 1 8.8 4.4a8.25 8.25 0 1 0 10.8 10.8Z"
              stroke="currentColor"
              stroke-width="1.45"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path d="M16.7 5.2v2.3M15.55 6.35h2.3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
          </svg>
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="3.75" stroke="currentColor" stroke-width="1.45" />
            <path
              d="M12 2.8v2.1M12 19.1v2.1M21.2 12h-2.1M4.9 12H2.8M18.5 5.5 17 7M7 17l-1.5 1.5M18.5 18.5 17 17M7 7 5.5 5.5"
              stroke="currentColor"
              stroke-width="1.45"
              stroke-linecap="round"
            />
            </svg>
          </span>
        </button>
      </div>
    </header>

    <main id="entrance-content">
      <section class="entrance-stage" aria-labelledby="entrance-heading">
        <div class="ambient-field" aria-hidden="true"></div>
        <div class="pointer-light" aria-hidden="true"></div>
        <div class="vortex-halo" aria-hidden="true"></div>
        <div class="orbit orbit-wide" aria-hidden="true"></div>
        <div class="orbit orbit-tall" aria-hidden="true"></div>
        <canvas id="yuda-particles" class="particle-canvas" aria-hidden="true"></canvas>
        <div class="yuda-ghost" aria-hidden="true">YUDA</div>
        <div class="grain" aria-hidden="true"></div>
        <div class="vignette" aria-hidden="true"></div>

        <div class="hero-copy">
          <div class="hero-eyebrow entrance-reveal entrance-reveal-1">
            <span>Yuda's Channel</span>
            <span class="eyebrow-line" aria-hidden="true"></span>
            <span>Game Wiki</span>
          </div>

          <h1
            id="entrance-heading"
            class="hero-title entrance-reveal entrance-reveal-2"
            data-sound-y={secretLetterVoices.y}
            data-sound-u={secretLetterVoices.u}
            data-sound-d={secretLetterVoices.D}
            data-sound-a={secretLetterVoices.a}
          >
            <span class="hero-title-prefix">Welcome to</span>
            <em>Dazotikuy Shrine</em>
          </h1>

          <div class="hero-support entrance-reveal entrance-reveal-3">
            <p>
              Advanced game guides and mechanics for The Legend of Zelda,
              Super Smash Bros., and beyond.
            </p>

            <div class="hero-actions" aria-label="Entrance actions">
              <a
                class="hero-action hero-action-primary magnetic"
                href={wikiHomeUrl}
                data-href-zh={wikiHomeUrl}
                data-href-ja={wikiHomeUrlJa}
              >
                <span>Enter Shrine</span>
                <span class="action-icon" aria-hidden="true">
                  <svg class="action-symbol action-symbol-default" viewBox="0 0 24 24" fill="none">
                    <path d="M6 18 18 6M9 6h9v9" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <img class="action-symbol action-symbol-hover action-symbol-favicon" src={href("/favicon.svg")} alt="" />
                </span>
              </a>

              <a
                class="hero-action hero-action-secondary magnetic"
                href={SITE.youtube}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Visit Channel</span>
                <span class="action-icon" aria-hidden="true">
                  <svg class="action-symbol action-symbol-default" viewBox="0 0 24 24" fill="none">
                    <path d="M7 12h10M13.5 8.5 17 12l-3.5 3.5" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <svg class="action-symbol action-symbol-hover action-symbol-youtube" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
                  </svg>
                </span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="entrance-footer entrance-reveal entrance-reveal-4">
      <p>© 2026 Yuhudaddy - Content Curated from Personal YouTube Channel</p>
    </footer>

    <div class="custom-cursor cursor-dot" aria-hidden="true"></div>
    <div class="custom-cursor cursor-ring" aria-hidden="true"></div>

    <style is:global>
      :root,
      :root[data-theme="dark"] {
        color-scheme: dark;
        /* 希卡色系：底色走深棕（hue ~30、低彩度，BotW 官網同族），
           中性文字帶乳白暖調，互動強調用英傑藍（hue ~255）。 */
        --entrance-bg: oklch(13% 0.018 30);
        --entrance-bg-deep: oklch(9% 0.02 25);
        --entrance-bg-soft: oklch(17% 0.025 30);
        --entrance-surface: oklch(23% 0.03 30);
        --entrance-text: oklch(96% 0.03 100);
        --entrance-text-soft: oklch(78% 0.03 90);
        --entrance-text-faint: oklch(65% 0.025 85);
        --entrance-line: oklch(65% 0.04 85 / 0.28);
        --entrance-line-strong: oklch(74% 0.07 90 / 0.46);
        --entrance-accent: oklch(66% 0.17 255);
        --entrance-accent-bright: oklch(75% 0.14 250);
        --entrance-accent-deep: oklch(52% 0.17 258);
        /* YUDA 密碼字母命中：亮英傑藍——點中字母像啟動神廟，休眠銘文
           轉為喚醒的藍光。標題漸層現在是乳白→希卡土的暖色系，
           藍色命中在色相上跟標題完全分開，不會再混在一起。 */
        --entrance-secret-hit: oklch(75% 0.15 250);
        /* 背景環境光暈專用（YUDA 粒子周圍的大片朦朧光），與上面三個
           --entrance-accent* 分開，不影響按鈕圖示、游標、對焦框等 UI 強調色。
           深色模式：純白霧（chroma 0，不帶任何色相）；淺色模式見下方 light 區塊。 */
        --entrance-glow-1: oklch(93% 0 0);
        --entrance-glow-2: oklch(96% 0 0);
        --entrance-glow-3: oklch(98% 0 0);
        --entrance-button-primary: oklch(26% 0.045 35);
        --entrance-button-primary-text: oklch(96% 0.03 100);
        --entrance-button-secondary: oklch(18% 0.025 30);
        --entrance-focus: oklch(75% 0.14 250);
        --entrance-particle-glow: oklch(74% 0.12 255 / 0.25);
        --entrance-shadow: oklch(5% 0.01 30 / 0.4);
        --entrance-glass-fill: oklch(96% 0.01 90 / 0.065);
        --entrance-glass-edge: oklch(80% 0.06 90 / 0.42);
        --entrance-glass-edge-bright: oklch(98% 0.008 90 / 0.5);
        --entrance-glass-sheen: oklch(100% 0 0 / 0.28);
        --entrance-glass-reflection: oklch(100% 0 0 / 0.22);
        --entrance-glass-shadow: oklch(4% 0.01 30 / 0.34);
        /* 標題漸層：白 → 乳白 → 淡希卡土 → 希卡土（ZELDA logo 的暖乳白族） */
        --entrance-title-gradient-a: #ffffff;
        --entrance-title-gradient-b: #fffde6;
        --entrance-title-gradient-c: #efd9a8;
        --entrance-title-gradient-d: #dcbf7c;
        --entrance-theme-color: #0f0304;
        --cursor-x: -100px;
        --cursor-y: -100px;
        --cursor-dot-x: -100px;
        --cursor-dot-y: -100px;
        --cursor-scale: 1;
      }

      :root[data-theme="light"] {
        color-scheme: light;
        --entrance-bg: #fff;
        --entrance-bg-deep: #fff;
        --entrance-bg-soft: #fff;
        --entrance-surface: #fff;
        --entrance-text: oklch(28% 0.02 35);
        --entrance-text-soft: oklch(43% 0.02 40);
        --entrance-text-faint: oklch(51% 0.02 45);
        --entrance-line: oklch(55% 0.04 80 / 0.26);
        --entrance-line-strong: oklch(50% 0.06 85 / 0.4);
        --entrance-accent: oklch(48% 0.16 255);
        --entrance-accent-bright: oklch(58% 0.15 252);
        --entrance-accent-deep: oklch(40% 0.15 258);
        /* 淺色底命中同樣走英傑藍，取加深版才有對比 */
        --entrance-secret-hit: oklch(50% 0.17 255);
        /* 淺色模式的光暈跟深色模式方向相反：深色是白霧疊在暗底上，
           淺色底是白的，白霧會完全看不見。改用中深的希卡金——
           休眠神廟的暖光，與深色模式的白霧成日夜對照。 */
        --entrance-glow-1: oklch(52% 0.1 80);
        --entrance-glow-2: oklch(64% 0.11 85);
        --entrance-glow-3: oklch(75% 0.09 90);
        --entrance-button-primary: oklch(93% 0.04 90);
        --entrance-button-primary-text: oklch(32% 0.06 40);
        --entrance-button-secondary: #fff;
        --entrance-focus: oklch(45% 0.16 255);
        --entrance-particle-glow: oklch(55% 0.09 85 / 0.17);
        --entrance-shadow: oklch(45% 0.03 60 / 0.14);
        --entrance-glass-fill: oklch(100% 0 0 / 0.12);
        --entrance-glass-edge: oklch(78% 0.03 85 / 0.38);
        --entrance-glass-edge-bright: oklch(100% 0 0 / 0.82);
        --entrance-glass-sheen: oklch(100% 0 0 / 0.66);
        --entrance-glass-reflection: oklch(100% 0 0 / 0.7);
        --entrance-glass-shadow: oklch(62% 0.02 70 / 0.1);
        /* 標題漸層在淺色模式必須自己一組：深色那組以純白起頭，
           疊在白底上等於看不見。改為由深到淺的銅棕（休眠銘文的顏色）。 */
        --entrance-title-gradient-a: #4a3520;
        --entrance-title-gradient-b: #6b4e28;
        --entrance-title-gradient-c: #8f6d25;
        --entrance-title-gradient-d: #b8923a;
        --entrance-theme-color: #f6f6f4;
      }

      .entrance-html {
        min-width: 320px;
        min-height: 100%;
        overflow: hidden;
        background: var(--entrance-bg);
      }

      .entrance-page {
        position: relative;
        display: grid;
        min-width: 320px;
        min-height: 100svh;
        margin: 0;
        overflow: hidden;
        grid-template-rows: auto 1fr auto;
        background: var(--entrance-bg);
        color: var(--entrance-text);
        font-family: "Noto Sans TC", "Avenir Next", Avenir, sans-serif;
        font-kerning: normal;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .entrance-page *,
      .entrance-page *::before,
      .entrance-page *::after {
        box-sizing: border-box;
      }

      .entrance-page a,
      .entrance-page button {
        -webkit-tap-highlight-color: transparent;
      }

      .skip-link {
        position: fixed;
        z-index: 80;
        top: 12px;
        left: 12px;
        padding: 10px 14px;
        transform: translateY(-150%);
        border-radius: 4px;
        background: var(--entrance-text);
        color: var(--entrance-bg);
        font-size: 0.875rem;
        text-decoration: none;
        transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .entrance-header {
        position: relative;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding:
          max(clamp(24px, 4.4vh, 46px), env(safe-area-inset-top))
          max(clamp(24px, 4.7vw, 68px), env(safe-area-inset-right))
          0
          max(clamp(24px, 4.7vw, 68px), env(safe-area-inset-left));
        pointer-events: none;
      }

      .entrance-brand,
      .entrance-header-actions {
        pointer-events: auto;
      }

      .entrance-header-actions {
        display: flex;
        align-items: center;
        gap: 4px;
      }

      /* 日文的漢字字形與繁中不同（例：解説／説），優先用系統的日文字體，
         不額外載入字檔；找不到時才退回原本的 Noto Sans TC。 */
      :root[data-lang="ja"] .entrance-page {
        font-family:
          "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic", "Yu Gothic UI", Meiryo,
          "Noto Sans JP", "Noto Sans TC", "Avenir Next", Avenir, sans-serif;
      }

      .entrance-brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        color: var(--entrance-text);
        text-decoration: none;
      }

      /* <picture> 才是 flex 項目，尺寸與不縮放的規則掛在它身上；
         裡面的 <img> 只負責填滿。 */
      .brand-logo-pic {
        position: relative;
        display: block;
        width: 40px;
        height: 40px;
        flex: 0 0 auto;
      }

      .brand-logo {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition:
          filter 220ms cubic-bezier(0.25, 1, 0.5, 1),
          transform 220ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .entrance-brand:focus-visible {
        outline: 2px solid var(--entrance-text);
        outline-offset: 6px;
        border-radius: 6px;
      }

      /* hover 效果只在解鎖（有 href）後出現：鎖定狀態下 Logo 只是圖，
         滑過去若會放大反而洩漏「這裡可以互動」 */
      @media (hover: hover) {
        .entrance-brand[href]:hover .brand-logo {
          transform: scale(1.06);
          filter: brightness(1.06);
        }
      }

      /* 彩蛋解鎖後的 Logo 光暈：微微脈衝的外圍暈光，脈衝掛在 <picture> 上，
         讓 <img> 自己的 hover brightness 不會被 filter 動畫蓋掉 */
      .entrance-brand.is-secret-unlocked .brand-logo-pic {
        animation: brand-secret-pulse 2.8s ease-in-out infinite alternate;
      }

      @keyframes brand-secret-pulse {
        from {
          filter: drop-shadow(0 0 3px color-mix(in oklch, white 55%, transparent));
        }
        to {
          filter: drop-shadow(0 0 10px color-mix(in oklch, white 85%, transparent));
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .entrance-brand.is-secret-unlocked .brand-logo-pic {
          animation: none;
          filter: drop-shadow(0 0 7px color-mix(in oklch, white 70%, transparent));
        }
      }

      .brand-copy {
        display: block;
        line-height: 1;
      }

      .brand-copy span {
        color: var(--entrance-text-soft);
        font-family: "Spectral", Georgia, serif;
        font-size: 0.76rem;
        font-style: italic;
        letter-spacing: 0.02em;
        white-space: nowrap;
      }

      .theme-switch {
        position: relative;
        display: grid;
        width: 44px;
        height: 44px;
        margin: -7px;
        padding: 0;
        cursor: pointer;
        place-items: center;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--entrance-text-soft);
      }

      .theme-switch::after {
        position: absolute;
        width: 28px;
        height: 28px;
        content: "";
        border-radius: 50%;
        background: var(--entrance-particle-glow);
        opacity: 0;
        transform: scale(0.72);
        transition:
          opacity 220ms cubic-bezier(0.25, 1, 0.5, 1),
          transform 220ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .theme-switch-icons {
        position: relative;
        z-index: 1;
        display: block;
        width: 21px;
        height: 21px;
      }

      .theme-icon {
        position: absolute;
        inset: 0;
        width: 21px;
        height: 21px;
        transition:
          opacity 240ms cubic-bezier(0.65, 0, 0.35, 1),
          transform 280ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      :root[data-theme="dark"] .theme-icon-moon {
        opacity: 0;
        transform: rotate(-28deg) scale(0.74);
      }

      :root[data-theme="dark"] .theme-icon-sun {
        opacity: 1;
        transform: rotate(0) scale(1);
      }

      :root[data-theme="light"] .theme-icon-moon {
        opacity: 1;
        transform: rotate(0) scale(1);
      }

      :root[data-theme="light"] .theme-icon-sun {
        opacity: 0;
        transform: rotate(28deg) scale(0.74);
      }

      .theme-switch:focus-visible,
      .hero-action:focus-visible {
        outline: 2px solid var(--entrance-focus);
        outline-offset: 5px;
      }

      /* 語言切換：圓鈕本體沿用主題鈕的尺寸與光暈，展開後在下方顯示三個選項 */
      .lang-switch {
        position: relative;
      }

      .lang-switch-button {
        position: relative;
        display: grid;
        width: 44px;
        height: 44px;
        margin: -7px;
        padding: 0;
        cursor: pointer;
        place-items: center;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--entrance-text-soft);
      }

      .lang-switch-button::after {
        position: absolute;
        width: 28px;
        height: 28px;
        content: "";
        border-radius: 50%;
        background: var(--entrance-particle-glow);
        opacity: 0;
        transform: scale(0.72);
        transition:
          opacity 220ms cubic-bezier(0.25, 1, 0.5, 1),
          transform 220ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .lang-icon {
        position: relative;
        z-index: 1;
        width: 20px;
        height: 20px;
      }

      .lang-switch-button[aria-expanded="true"] {
        color: var(--entrance-accent-bright);
      }

      .lang-switch-button[aria-expanded="true"]::after {
        opacity: 0.75;
        transform: scale(1);
      }

      .lang-menu {
        position: absolute;
        top: calc(100% + 6px);
        right: -7px;
        z-index: 30;
        display: flex;
        min-width: 148px;
        flex-direction: column;
        padding: 5px;
        gap: 1px;
        border: 1px solid var(--entrance-glass-edge);
        border-radius: 13px;
        background: var(--entrance-surface);
        box-shadow: 0 14px 32px var(--entrance-shadow);
        transform-origin: top right;
        animation: lang-menu-in 180ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .lang-menu[hidden] {
        display: none;
      }

      @keyframes lang-menu-in {
        from {
          opacity: 0;
          transform: translateY(-5px) scale(0.96);
        }
      }

      .lang-option {
        display: flex;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        padding: 8px 10px;
        cursor: pointer;
        gap: 10px;
        border: 0;
        border-radius: 9px;
        background: transparent;
        color: var(--entrance-text-soft);
        font-family: inherit;
        font-size: 0.82rem;
        letter-spacing: 0.01em;
        text-align: left;
        transition: background-color 160ms cubic-bezier(0.25, 1, 0.5, 1), color 160ms;
      }

      .lang-option[aria-checked="true"] {
        color: var(--entrance-accent-bright);
      }

      .lang-option-check {
        width: 14px;
        height: 14px;
        flex: 0 0 auto;
        opacity: 0;
      }

      .lang-option[aria-checked="true"] .lang-option-check {
        opacity: 1;
      }

      .lang-switch-button:focus-visible,
      .lang-option:focus-visible {
        outline: 2px solid var(--entrance-focus);
        outline-offset: 3px;
      }

      /* 日文語序是「品牌名 → へようこそ」，與中英文的「歡迎來到 → 品牌名」相反。
         用 grid order 對調兩行，不動 DOM 順序（h1 內的語意順序仍由 JS 依語言寫入正確文字）。
         字型也改成優先 Noto Serif JP，避免假名套用到中文（TC）的字形上。 */
      :root[data-lang="ja"] .hero-title-prefix {
        order: 2;
        font-family: "Spectral", "Noto Serif JP", "Noto Serif TC", Georgia, serif;
      }

      :root[data-lang="ja"] .hero-title em {
        order: 1;
        /* background-clip: text 的漸層只畫到 padding-box 範圍內；line-height 0.98
           比字體本身還矮，日文濁音（如「ダ」的濁点）超出這個範圍的部分因為沒有
           背景可以透出來，視覺上就像被切掉。中英文沒有濁音符號不受影響，所以
           只加在日文版，不動全域 line-height（會牽動中英文已經調好的緊湊排版）。 */
        padding-top: 0.3em;
      }

      @media (hover: hover) {
        .theme-switch:hover {
          color: var(--entrance-accent-bright);
        }

        .theme-switch:hover::after {
          opacity: 0.75;
          transform: scale(1);
        }

        .lang-switch-button:hover {
          color: var(--entrance-accent-bright);
        }

        .lang-switch-button:hover::after {
          opacity: 0.75;
          transform: scale(1);
        }

        .lang-option:hover {
          background: var(--entrance-glass-fill);
          color: var(--entrance-text);
        }

        .lang-option[aria-checked="true"]:hover {
          color: var(--entrance-accent-bright);
        }
      }

      #entrance-content {
        min-height: 0;
      }

      .entrance-stage {
        position: fixed;
        z-index: 1;
        inset: 0;
        min-width: 320px;
        overflow: hidden;
        isolation: isolate;
        background:
          radial-gradient(
            circle at 50% 33%,
            color-mix(in oklch, var(--entrance-bg-soft) 88%, transparent),
            transparent 37%
          ),
          linear-gradient(145deg, var(--entrance-bg) 0%, var(--entrance-bg-soft) 52%, var(--entrance-bg-deep) 100%);
      }

      .ambient-field {
        position: absolute;
        z-index: 1;
        inset: -30%;
        background:
          radial-gradient(
            circle at 32% 43%,
            color-mix(in oklch, var(--entrance-glow-1) 12%, transparent),
            transparent 21%
          ),
          radial-gradient(
            circle at 67% 47%,
            color-mix(in oklch, var(--entrance-glow-2) 9%, transparent),
            transparent 25%
          ),
          radial-gradient(
            circle at 54% 22%,
            color-mix(in oklch, var(--entrance-glow-3) 6%, transparent),
            transparent 18%
          );
        filter: blur(24px);
        animation: ambient-drift 22s cubic-bezier(0.65, 0, 0.35, 1) infinite alternate;
      }

      :root[data-theme="light"] .ambient-field {
        display: none;
      }

      @keyframes ambient-drift {
        0% {
          opacity: 0.74;
          transform: translate3d(-1.5%, 0.8%, 0) scale(1);
        }
        100% {
          opacity: 1;
          transform: translate3d(1.6%, -1%, 0) scale(1.025);
        }
      }

      .pointer-light {
        position: absolute;
        z-index: 4;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(
            360px circle at var(--cursor-dot-x) var(--cursor-dot-y),
            color-mix(in oklch, var(--entrance-glow-2) 8%, transparent),
            color-mix(in oklch, var(--entrance-glow-1) 2.5%, transparent) 40%,
            transparent 71%
          );
        opacity: 0.52;
      }

      .vortex-halo {
        position: absolute;
        z-index: 4;
        top: 0;
        left: 0;
        width: 270px;
        height: 270px;
        pointer-events: none;
        border-radius: 50%;
        background: conic-gradient(
          from 35deg,
          transparent,
          color-mix(in oklch, var(--entrance-glow-3) 21%, transparent),
          transparent 23%,
          transparent 66%,
          color-mix(in oklch, var(--entrance-glow-2) 15%, transparent),
          transparent
        );
        opacity: 0;
        transform: translate3d(calc(var(--cursor-dot-x) - 135px), calc(var(--cursor-dot-y) - 135px), 0);
        transition: opacity 220ms cubic-bezier(0.25, 1, 0.5, 1);
        -webkit-mask: radial-gradient(circle, transparent 0 43%, #000 49%, transparent 61%);
        mask: radial-gradient(circle, transparent 0 43%, #000 49%, transparent 61%);
        animation: halo-turn 13s linear infinite;
      }

      .entrance-page[data-pointer-active="true"] .vortex-halo {
        opacity: 0.18;
      }

      @keyframes halo-turn {
        to {
          rotate: 1turn;
        }
      }

      .orbit {
        position: absolute;
        z-index: 1;
        top: 34%;
        left: 50%;
        pointer-events: none;
        border: 1px solid var(--entrance-line);
        border-radius: 50%;
        opacity: 0.17;
      }

      .orbit-wide {
        width: min(79vw, 1080px);
        height: min(29vw, 315px);
        transform: translate(-50%, -50%) rotate(-5deg);
      }

      .orbit-tall {
        width: min(58vw, 810px);
        height: min(36vw, 410px);
        transform: translate(-50%, -50%) rotate(8deg);
        opacity: 0.1;
      }

      .particle-canvas {
        position: absolute;
        z-index: 3;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }

      .yuda-ghost {
        position: absolute;
        z-index: 2;
        top: 34%;
        left: 50%;
        color: transparent;
        font-family: "Arial Black", "Avenir Next", sans-serif;
        font-size: min(22vw, 34vh, 390px);
        font-weight: 900;
        line-height: 0.8;
        letter-spacing: -0.055em;
        opacity: 0.22;
        pointer-events: none;
        transform: translate(-50%, -50%);
        white-space: nowrap;
        -webkit-text-stroke: 0.7px var(--entrance-line);
        text-shadow: 0 0 38px color-mix(in oklch, var(--entrance-glow-3) 25%, transparent);
        animation: ghost-reveal 1100ms 120ms cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      @keyframes ghost-reveal {
        from {
          opacity: 0;
          filter: blur(14px);
          transform: translate(-50%, -50%) scale(0.97);
        }
      }

      .grain,
      .vignette {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .grain {
        z-index: 10;
        background-image:
          repeating-linear-gradient(
            100deg,
            transparent 0,
            transparent 2px,
            color-mix(in oklch, var(--entrance-text) 1.8%, transparent) 3px,
            transparent 4px
          ),
          repeating-linear-gradient(
            18deg,
            transparent 0,
            transparent 3px,
            color-mix(in oklch, var(--entrance-text) 1.3%, transparent) 4px,
            transparent 5px
          );
        opacity: 0.44;
        mix-blend-mode: soft-light;
      }

      .vignette {
        z-index: 9;
        box-shadow:
          inset 0 0 15vw color-mix(in oklch, var(--entrance-bg-deep) 72%, transparent),
          inset 0 0 4vw color-mix(in oklch, var(--entrance-bg-deep) 42%, transparent);
      }

      :root[data-theme="light"] .vignette {
        box-shadow:
          inset 0 0 13vw color-mix(in oklch, var(--entrance-bg-deep) 34%, transparent),
          inset 0 0 4vw color-mix(in oklch, var(--entrance-bg-deep) 18%, transparent);
      }

      .hero-copy {
        position: absolute;
        z-index: 7;
        top: 53%;
        left: 50%;
        width: min(88vw, 970px);
        transform: translateX(-50%);
      }

      .hero-eyebrow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: var(--entrance-text-faint);
        font-family: "DM Mono", ui-monospace, monospace;
        font-size: 0.625rem;
        line-height: 1.4;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .eyebrow-line {
        display: block;
        width: 38px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--entrance-accent-bright), transparent);
        box-shadow: 0 0 10px var(--entrance-particle-glow);
      }

      .hero-title {
        display: grid;
        margin: clamp(14px, 2.1vh, 22px) 0 0;
        color: var(--entrance-text);
        font-size: clamp(2.7rem, 5.6vw, 5.25rem);
        font-weight: 400;
        line-height: 0.98;
        row-gap: 21px;
        letter-spacing: -0.065em;
        text-align: center;
      }

      /* 「歡迎來到／Welcome to／へようこそ」：改用跟品牌名同系列但直立、非斜體的
         Spectral 襯線，安靜襯托下方的斜體漸層品牌名，不會互相搶戲；中日文沒有對應
         字符時才落回 Noto Serif TC/JP（:root[data-lang="ja"] 額外把 JP 排到 TC 前面，
         避免中文字形套用到日文假名上）。字級用 calc 從原本的比例再減 8px。 */
      .hero-title-prefix {
        font-family: "Spectral", "Noto Serif TC", Georgia, serif;
        font-size: calc(0.78em - 8px);
        font-style: normal;
        color: var(--entrance-text-soft);
        letter-spacing: -0.02em;
      }

      .hero-title em {
        margin-left: -0.03em;
        color: transparent;
        font-family: "Spectral", Georgia, serif;
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.04em;
        padding-bottom: 0.09em;
        background: linear-gradient(
          106deg,
          var(--entrance-title-gradient-a) 0%,
          var(--entrance-title-gradient-b) 31%,
          var(--entrance-title-gradient-c) 65%,
          var(--entrance-title-gradient-d) 100%
        );
        background-size: 140% 100%;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shrine-gradient-shift 10s cubic-bezier(0.65, 0, 0.35, 1) infinite alternate;
      }

      :root[data-theme="light"] .hero-title em {
        color: transparent;
        filter: drop-shadow(0 0 1.2px color-mix(in oklch, var(--entrance-accent-deep) 34%, transparent));
      }

      @keyframes shrine-gradient-shift {
        0% {
          background-position: 0% 50%;
        }
        100% {
          background-position: 34% 50%;
        }
      }

      /* ── 標題彩蛋（y→u→D→a）─────────────────────────────────────────
         熱區不塞進 <em>：em 開著 background-clip:text，任何塞進去的字都會
         被算進漸層的文字遮罩，位置稍有偏差就會多出一層鬼影。改成掛在 h1
         上的獨立覆蓋層，內放與底下字母同字形的複製字，平常全透明（視覺
         零改變），點對時上色蓋住底下的漸層字母。座標由 JS 用 Range 實量。 */
      .hero-title {
        position: relative;
      }

      .secret-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .secret-letter {
        position: absolute;
        pointer-events: auto;
        color: transparent;
        font-family: "Spectral", Georgia, serif;
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.04em;
        user-select: none;
        -webkit-user-select: none;
        transition: color 300ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .secret-letter.is-hit {
        /* 字母本身閃明暗反差色（白/墨），光暈用綠——反差來自明暗，
           不引入第二個跟綠競爭的色相 */
        color: var(--entrance-secret-hit);
        text-shadow:
          0 0 16px color-mix(in oklch, var(--entrance-accent-bright) 70%, transparent),
          0 0 4px color-mix(in oklch, var(--entrance-secret-hit) 50%, transparent);
      }

      .hero-support {
        display: grid;
        width: min(100%, 790px);
        margin: clamp(22px, 3.2vh, 34px) auto 0;
        grid-template-columns: minmax(230px, 340px) auto;
        align-items: center;
        gap: clamp(34px, 6vw, 86px);
      }

      .hero-support p {
        max-width: 38ch;
        margin: 0;
        color: var(--entrance-text-soft);
        font-size: 0.85rem;
        font-weight: 400;
        line-height: 1.65;
        text-wrap: balance;
      }

      .hero-actions {
        display: flex;
        gap: 10px;
      }

      .hero-action {
        position: relative;
        display: inline-flex;
        min-width: 168px;
        min-height: 52px;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        overflow: hidden;
        padding: 7px 8px 7px 19px;
        cursor: pointer;
        isolation: isolate;
        border: 1px solid var(--entrance-glass-edge);
        border-radius: 999px;
        background:
          linear-gradient(
            118deg,
            color-mix(in oklch, var(--entrance-glass-edge-bright) 38%, transparent) 0%,
            transparent 22%,
            transparent 70%,
            color-mix(in oklch, var(--entrance-glass-edge) 18%, transparent) 100%
          ),
          var(--entrance-glass-fill);
        color: var(--entrance-text);
        font-family: "DM Mono", ui-monospace, monospace;
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-decoration: none;
        box-shadow:
          inset 0 1px 0 var(--entrance-glass-edge-bright),
          inset 1px 0 0 color-mix(in oklch, var(--entrance-glass-edge-bright) 34%, transparent),
          inset 0 -1px 0 color-mix(in oklch, var(--entrance-glass-edge) 58%, transparent),
          0 13px 32px var(--entrance-glass-shadow);
        -webkit-backdrop-filter: blur(14px) saturate(135%) brightness(1.08);
        backdrop-filter: blur(14px) saturate(135%) brightness(1.08);
        transition:
          border-color 260ms cubic-bezier(0.25, 1, 0.5, 1),
          color 220ms cubic-bezier(0.25, 1, 0.5, 1),
          box-shadow 260ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .hero-action > span {
        position: relative;
        z-index: 1;
      }

      .hero-action::before {
        position: absolute;
        z-index: 0;
        top: -115%;
        left: -88%;
        width: 62%;
        height: 340%;
        content: "";
        background: linear-gradient(
          90deg,
          transparent 0%,
          transparent 25%,
          color-mix(in oklch, var(--entrance-glass-sheen) 82%, transparent) 46%,
          color-mix(in oklch, var(--entrance-glass-reflection) 86%, transparent) 52%,
          transparent 76%
