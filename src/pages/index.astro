  {/* 水波紋元素由 JS 動態插入，拿不到 Astro scoped 樣式屬性，須放在 global 樣式 */}
  <style is:global>
    .home-nav-ripple {
      position: absolute;
      z-index: 2;
      border-radius: 50%;
      pointer-events: none;
      transform: scale(0);
      animation: home-nav-ripple 560ms ease-out forwards;
    }

    .home-nav-ripple-botw {
      background: radial-gradient(circle, rgba(111, 195, 247, 0.5) 0%, rgba(59, 130, 196, 0.24) 55%, transparent 78%);
    }

    .home-nav-ripple-totk {
      background: radial-gradient(circle, rgba(111, 227, 196, 0.48) 0%, rgba(42, 169, 139, 0.22) 55%, transparent 78%);
    }

    @keyframes home-nav-ripple {
      to {
        transform: scale(1);
        opacity: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .home-nav-ripple {
        display: none;
      }
    }
  </style>

  <script>
    // 物件地圖卡片：點擊水波紋（限卡片範圍內），播放片刻後再跳轉
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.querySelectorAll<HTMLAnchorElement>(".home-nav-zone").forEach((zone) => {
      zone.addEventListener("click", (event) => {
        // 修飾鍵（另開分頁等）或非左鍵：交給瀏覽器預設行為
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;

        const card = zone.closest<HTMLElement>(".home-nav-card-multi");
        if (!card || reduceMotion) return;

        event.preventDefault();

        const rect = card.getBoundingClientRect();
        const size = Math.max(rect.width, rect.height) * 2.1;
        // 鍵盤觸發（Enter）沒有座標，改由卡片中心擴散
        const originX = event.clientX || rect.left + rect.width / 2;
        const originY = event.clientY || rect.top + rect.height / 2;

        const ripple = document.createElement("span");
        ripple.className = "home-nav-ripple";
        if (zone.dataset.tone) ripple.classList.add(`home-nav-ripple-${zone.dataset.tone}`);
        ripple.style.width = `${size}px`;
        ripple.style.height = `${size}px`;
        ripple.style.left = `${originX - rect.left - size / 2}px`;
        ripple.style.top = `${originY - rect.top - size / 2}px`;
        card.appendChild(ripple);

        window.setTimeout(() => {
          window.location.href = zone.href;
        }, 300);
      });
    });
  </script>
