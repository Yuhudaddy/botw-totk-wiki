---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { href } from "../../lib/url";
import { GAME_LOGOS } from "../../data/gameLogos";
import { existsSync, readdirSync } from "node:fs";
import { extname, join, parse } from "node:path";

interface Schematic {
  id: string;
  number: string;
  title: string;
  qrImage: string;
  description: string;
  author: string;
}

interface SchematicCategory {
  id: string;
  label: string;
  en: string;
  folderNames: string[];
  items: Schematic[];
}

const imageExtensions = new Set([".jpg", ".jpeg", ".png", ".webp", ".gif"]);
const qrRoot = join(process.cwd(), "public", "totk-qrcode");

const categoryConfig = [
  {
    id: "practical",
    label: "實用",
    en: "Practical",
    folderNames: ["Pratical", "Practical"],
  },
  {
    id: "playful",
    label: "有趣",
    en: "Playful",
    folderNames: ["Playful"],
  },
];

const blueprintMetadata: Record<string, { number: string; title: string; description: string; author: string }> = {
  "新藍圖 01_Zelda Notes.jpg": {
    number: "01",
    title: "人馬剋星帆",
    description: "人馬會無法消滅帆而持續吼叫",
    author: "Yuda",
  },
  "新藍圖 02_Zelda Notes.jpg": {
    number: "02",
    title: "免電上升器",
    description: "在鍋子正下方往上爬就可以升空",
    author: "Kleric（Adjusted by Yuda）",
  },
  "新藍圖 03_Zelda Notes.jpg": {
    number: "03",
    title: "鍋神",
    description: "除了大型魔物外都能秒殺",
    author: "Yuda",
  },
  "新藍圖 04_Zelda Notes.jpg": {
    number: "04",
    title: "神廟升降機",
    description: "不受地圖碰撞、可載運林克和NPC",
    author: "Yuda",
  },
  "新藍圖 05_Zelda Notes.jpg": {
    number: "05",
    title: "洞穴採集藍圖",
    description: "可在洞穴內快速搜集材料",
    author: "Yuda",
  },
  "新藍圖 06_Zelda Notes.jpg": {
    number: "06",
    title: "瞬爆器",
    description: "一展開就能瞬間爆炸",
    author: "Yuda",
  },
  "脈衝雷射車_にょろ.jpg": {
    number: "07",
    title: "脈衝雷射車",
    description: "間斷性光線有高速傷害",
    author: "にょろ",
  },
  "小型隨身鳥望台_Yuda.jpg": {
    number: "08",
    title: "隨身鳥望台",
    description: "適用 Switch 2",
    author: "Yuda",
  },
  "巨大化左納烏組01_takkun.jpg": {
    number: "09",
    title: "巨大左納烏組",
    description: "巨大化左納烏組01",
    author: "takkun",
  },
  "巨大化左納烏組02_takkun.jpg": {
    number: "10",
    title: "巨大電池組",
    description: "巨大化左納烏組02",
    author: "takkun",
  },
  "巨大拳擊機_cross.jpg": {
    number: "11",
    title: "巨大拳擊機",
    description: "巨大拳擊機",
    author: "cross",
  },
  "巨大MK2_NeatJungle.jpg": {
    number: "12",
    title: "巨大MK2",
    description: "巨大MK2",
    author: "NeatJungle",
  },
  "全範圍光掃射機_cross.jpg": {
    number: "13",
    title: "激光掃射器",
    description: "全範圍光掃射機",
    author: "cross",
  },
  "血月機_Kleric.jpg": {
    number: "14",
    title: "血月機",
    description: "血月機",
    author: "Kleric",
  },
  "拳擊機_cross.jpg": {
    number: "15",
    title: "拳擊機",
    description: "拳擊機",
    author: "cross",
  },
  "脈衝雷射手_cross.jpg": {
    number: "16",
    title: "脈衝雷射手",
    description: "脈衝雷射手",
    author: "cross",
  },
  "脈衝雷射柱_Yuda.jpg": {
    number: "17",
    title: "脈衝雷射柱",
    description: "脈衝雷射柱",
    author: "Yuda",
  },
  "馬車_たはた.jpg": {
    number: "18",
    title: "馬車",
    description: "馬車",
    author: "たはた",
  },
  "高速馬車組合_dr. pu.jpg": {
    number: "19",
    title: "高速馬車組合",
    description: "高速馬車組合",
    author: "dr. pu",
  },
  "無電池抬舉飛行器_ぶれねこ.jpg": {
    number: "20",
    title: "抬舉飛行器",
    description: "重複抬舉就能飛上去",
    author: "ぶれねこ",
  },
  // 以下兩張的敘述與標題不同，需另外指定；其餘鯨魚系列的敘述沿用標題，
  // 由 titleAndAuthorFromFile() 自動從檔名解析，不必列在這裡。
  "雪兔號_Yuda.jpg": {
    number: "21",
    title: "雪兔號",
    description: "須裝備防凍",
    author: "Yuda",
  },
  "小鯨魚尾骨_Yuda.jpg": {
    number: "22",
    title: "小鯨魚尾骨",
    description: "推 NPC 神器",
    author: "Yuda",
  },
};

function titleAndAuthorFromFile(fileName: string) {
  const baseName = parse(fileName).name;
  const splitAt = baseName.lastIndexOf("_");

  if (splitAt === -1) {
    return { title: baseName, author: "製作者待補" };
  }

  return {
    title: baseName.slice(0, splitAt),
    author: baseName.slice(splitAt + 1),
  };
}

function readCategoryItems(category: (typeof categoryConfig)[number]): Schematic[] {
  const folderName = category.folderNames.find((name) => existsSync(join(qrRoot, name)));
  if (!folderName) return [];

  return readdirSync(join(qrRoot, folderName))
    .filter((fileName) => imageExtensions.has(extname(fileName).toLowerCase()))
    .sort((a, b) => {
      const aNumber = blueprintMetadata[a]?.number;
      const bNumber = blueprintMetadata[b]?.number;
      if (aNumber && bNumber) return aNumber.localeCompare(bNumber, "en");
      if (aNumber) return -1;
      if (bNumber) return 1;
      return a.localeCompare(b, "zh-Hant");
    })
    .map((fileName, index) => {
      const metadata = blueprintMetadata[fileName];
      const parsed = titleAndAuthorFromFile(fileName);
      return {
        id: `${category.id}-${index + 1}`,
        number: metadata?.number ?? String(index + 1).padStart(2, "0"),
        title: metadata?.title ?? parsed.title,
        description: metadata?.description ?? parsed.title,
        author: metadata?.author ?? parsed.author,
        qrImage: `/totk-qrcode/${folderName}/${encodeURIComponent(fileName)}`,
      };
    });
}

const categories: SchematicCategory[] = categoryConfig.map((category) => ({
  ...category,
  items: readCategoryItems(category),
}));

const schematicCount = categories.reduce((total, category) => total + category.items.length, 0);
const schematicsPerPage = 12;
---

<BaseLayout
  title="藍圖分享"
  description="《薩爾達傳說 王國之淚》藍圖 QR Code 分享庫，依實用與有趣分類整理。"
  active="resources"
>
  <div class="schematics-page">
    <section class="schematics-hero" aria-labelledby="schematics-title">
      <div class="schematics-scanner" aria-hidden="true">
        <div class="schematics-grid"></div>
        <span class="finder finder-a"></span>
        <span class="finder finder-b"></span>
        <span class="finder finder-c"></span>
        <span class="scan-line"></span>
        <div class="scanner-label">
          <span>SCHEMATIC ARCHIVE</span>
          <strong>READY TO INDEX</strong>
        </div>
      </div>

      <div class="schematics-hero-inner">
        <nav class="schematics-breadcrumb" aria-label="麵包屑">
          <a href={href("/")}>首頁</a>
          <span>/</span>
          <a href={href("/resources#totk")}>資料網站</a>
          <span>/</span>
          <span aria-current="page">藍圖分享</span>
        </nav>

        <div class="schematics-hero-grid">
          <div class="schematics-copy">
            <div class="schematics-kicker">
              <svg viewBox={GAME_LOGOS.totk.viewBox} aria-hidden="true" set:html={GAME_LOGOS.totk.svg} />
              <span>Tears of the Kingdom · Blueprint Gallery</span>
            </div>
            <h1 id="schematics-title">藍圖分享</h1>
            <p>把值得留下的建造收進同一座資料庫。每張藍圖保留 QR Code、名稱與製作者，查找時不必再翻遍散落的圖片。</p>
            <div class="schematics-meta" aria-label="藍圖資料欄位">
              <span>QR Code</span>
              <span>敘述</span>
              <span>製作者</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="schematics-index-bar">
      <div>
        <span>ARCHIVE / TOTK</span>
        <strong>{String(schematicCount).padStart(2, "0")} BLUEPRINTS</strong>
      </div>
      <a href={href("/resources#totk")}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        回到王國之淚資料
      </a>
    </div>

    <section class="schematics-library" aria-labelledby="library-title" data-view="grid">
      <header class="schematics-library-heading">
        <div>
          <span>QR BLUEPRINT LIBRARY</span>
          <h2 id="library-title">藍圖分享庫</h2>
        </div>
        <p>依「實用」與「有趣」分開整理，保留 QR Code、藍圖名稱與製作者，之後新增圖片時也會沿用同一套欄位。</p>
      </header>

      <div class="schematics-toolbar">
        {/* 分類切換：滑動膠囊表示選中，桌面 hover 時中文換成英文漸層字 */}
        <div class="schematics-tabs" role="tablist" aria-label="藍圖分類" data-schematics-tabs data-active={categories[0].id}>
          <span class="schematics-thumb" aria-hidden="true"></span>
          {
            categories.map((category, index) => (
              <button
                type="button"
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`schematics-panel-${category.id}`}
                id={`schematics-tab-${category.id}`}
                data-schematics-tab={category.id}
              >
                <span class="schematics-tab-zh">{category.label}</span>
                <span class={`schematics-tab-en schematics-tab-en-${category.id}`} aria-hidden="true">{category.en}</span>
                <em>{String(category.items.length).padStart(2, "0")}</em>
              </button>
            ))
          }
        </div>

        <div class="schematics-view-toggle" aria-label="圖片展示方式" data-schematics-view-toggle data-active="grid">
          <span class="schematics-view-thumb" aria-hidden="true"></span>
          <button type="button" aria-pressed="true" data-schematics-view="grid" aria-label="圖塊展示">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" />
            </svg>
          </button>
          <button type="button" aria-pressed="false" data-schematics-view="list" aria-label="列表展示">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 5h5v5H4zM4 14h5v5H4zM12 7h8M12 16h8" />
            </svg>
          </button>
        </div>
      </div>

      <div class="schematics-search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          type="text"
          id="schematics-search-input"
          placeholder="搜尋標題…"
          autocomplete="off"
          aria-label="搜尋藍圖標題"
        />
      </div>

      {
        categories.map((category, categoryIndex) => (
          <div
            class="schematics-panel"
            id={`schematics-panel-${category.id}`}
            role="tabpanel"
            aria-labelledby={`schematics-tab-${category.id}`}
            data-schematics-panel={category.id}
            hidden={categoryIndex !== 0}
          >
            {
              category.items.length > 0 ? (
                <div class="schematics-list">
                  {category.items.map((item, index) => (
                    <article class="schematic-card" data-schematic-card data-schematic-title={item.title} data-schematic-page={Math.floor(index / schematicsPerPage) + 1} hidden={index >= schematicsPerPage}>
                      <div class="schematic-card-head">
                        <span>{item.number}</span>
                        <h3>{item.title}</h3>
                      </div>
                      <button
                        type="button"
                        class="schematic-qr"
                        data-preview-src={href(item.qrImage)}
                        data-preview-title={item.title}
                        aria-label={`放大預覽 ${item.title} QR Code`}
                      >
                        <img src={href(item.qrImage)} alt={`${item.title} QR Code`} loading="lazy" />
                        <span aria-hidden="true"></span>
                      </button>
                      <dl>
                        <div>
                          <dt>敘述</dt>
                          <dd>{item.description}</dd>
                        </div>
                        <div>
                          <dt>製作者</dt>
                          <dd>{item.author}</dd>
                        </div>
                      </dl>
                    </article>
                  ))}
                  {category.items.length > schematicsPerPage && (
                    <nav class="schematics-pagination" aria-label={`${category.label}藍圖分頁`} data-schematics-pagination>
                      <button type="button" data-page-action="prev" aria-label="上一頁">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                      </button>
                      <div class="pagination-pages">
                        {Array.from({ length: Math.ceil(category.items.length / schematicsPerPage) }, (_, pageIndex) => (
                          <button
                            type="button"
                            data-page-number={pageIndex + 1}
                            aria-current={pageIndex === 0 ? "page" : undefined}
                          >
                            {String(pageIndex + 1).padStart(2, "0")}
                          </button>
                        ))}
                      </div>
                      <button type="button" data-page-action="next" aria-label="下一頁">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                      </button>
                    </nav>
                  )}
                </div>
              ) : null
            }
            {
              category.items.length > 0 && (
                <div class="schematics-search-empty" data-schematics-search-empty hidden>
                  找不到符合「<strong data-schematics-search-empty-query></strong>」的藍圖標題，換個關鍵字試試？
                </div>
              )
            }
            {
              category.items.length === 0 && (
                <div class="schematics-empty">
                  <div class="empty-mark" aria-hidden="true">
                    <span></span><span></span><span></span>
                  </div>
                  <div>
                    <span>{category.en.toUpperCase()}</span>
                    <h3>藍圖準備中</h3>
                    <p>這個分類加入 QR Code 後，會在這裡依序顯示名稱與製作者。</p>
                  </div>
                </div>
              )
            }
          </div>
        ))
      }
    </section>

    <div class="schematic-lightbox" data-schematic-lightbox hidden>
      {/* 遮罩點擊可關閉，但不進入鍵盤循環：它與右上角關閉鈕功能重複，
          留在 Tab 順序裡只會讓讀屏連續唸兩次「關閉預覽」。鍵盤使用者
          改用關閉鈕或 Esc。aria-hidden 避免它被當成獨立控制項朗讀。 */}
      <button
        class="lightbox-backdrop"
        type="button"
        data-lightbox-close
        tabindex="-1"
        aria-hidden="true"
      ></button>
      <div class="lightbox-dialog" role="dialog" aria-modal="true" aria-labelledby="lightbox-title">
        <div class="lightbox-head">
          <div>
            <span>QR PREVIEW</span>
            <h2 id="lightbox-title">藍圖預覽</h2>
          </div>
          <button type="button" data-lightbox-close aria-label="關閉預覽">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m6 6 12 12M18 6 6 18" />
            </svg>
          </button>
        </div>
        <div class="lightbox-image">
          <img src="" alt="" data-lightbox-image />
        </div>
      </div>
    </div>
  </div>

  <style>
    .schematics-page {
      --schematic-green: #4f826f;
      --schematic-green-soft: #dce8df;
      --schematic-line: color-mix(in srgb, var(--schematic-green) 30%, var(--border-soft));
      color: var(--text);
    }

    [data-theme="dark"] .schematics-page {
      --schematic-green: #7ba994;
      --schematic-green-soft: #24372f;
      --schematic-line: color-mix(in srgb, var(--schematic-green) 28%, var(--border-soft));
    }

    .schematics-hero {
      position: relative;
      min-height: 430px;
      isolation: isolate;
      overflow: hidden;
      border-bottom: 1px solid var(--border-soft);
      background: var(--bg);
      color: var(--ink);
      transition: background-color 420ms ease, color 420ms ease;
    }

    .schematics-hero-inner,
    .schematics-index-bar,
    .schematics-library {
      width: min(calc(100% - 64px), 1180px);
      margin-inline: auto;
    }

    .schematics-hero-inner {
      position: relative;
      z-index: 2;
      min-height: 430px;
      display: flex;
      flex-direction: column;
      padding-block: 28px 38px;
    }

    .schematics-breadcrumb {
      display: flex;
      gap: 9px;
      align-items: center;
      color: var(--muted);
      font-size: 12px;
    }

    .schematics-breadcrumb a {
      color: inherit;
      text-decoration: none;
    }

    .schematics-breadcrumb a:hover,
    .schematics-breadcrumb a:focus-visible {
      color: var(--ink);
    }

    .schematics-hero-grid {
      display: block;
      margin-block: auto;
      padding-block: 34px;
    }

    .schematics-copy {
      position: relative;
      z-index: 2;
      max-width: 620px;
    }

    .schematics-kicker {
      display: flex;
      gap: 10px;
      align-items: center;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 1.4px;
      text-transform: uppercase;
    }

    .schematics-kicker svg {
      width: 22px;
      height: 22px;
      fill: currentColor;
    }

    .schematics-copy h1 {
      margin: 16px 0 0;
      color: var(--ink);
      font-family: var(--font-serif);
      font-size: clamp(34px, 4vw, 48px);
      font-weight: 500;
      line-height: 1.12;
      letter-spacing: 0;
    }

    .schematics-copy > p {
      max-width: 36rem;
      margin: 22px 0 0;
      color: var(--text);
      font-size: 14px;
      line-height: 1.85;
    }

    .schematics-meta {
      display: flex;
      gap: 0;
      margin-top: 30px;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .schematics-meta span + span::before {
      content: "/";
      margin-inline: 16px;
      color: var(--accent);
    }

    .schematics-scanner {
      position: absolute;
      z-index: 0;
      top: 50%;
      right: max(18px, calc((100% - 1180px) / 2));
      width: min(42vw, 430px);
      aspect-ratio: 1;
      overflow: hidden;
      border: 1px solid var(--schematic-line);
      background: color-mix(in srgb, var(--surface) 68%, transparent);
      opacity: 0.72;
      transform: translateY(-48%);
      transition: opacity 420ms ease, border-color 420ms ease, background-color 420ms ease;
    }

    [data-theme="dark"] .schematics-scanner {
      opacity: 0.5;
      background: color-mix(in srgb, var(--surface) 42%, transparent);
    }

    .schematics-grid {
      position: absolute;
      inset: 0;
      opacity: 0.55;
      background-image:
        linear-gradient(var(--schematic-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--schematic-line) 1px, transparent 1px);
      background-size: 24px 24px;
      -webkit-mask-image: linear-gradient(to bottom right, #000 25%, transparent 88%);
      mask-image: linear-gradient(to bottom right, #000 25%, transparent 88%);
    }

    .finder {
      position: absolute;
      width: 76px;
      height: 76px;
      border: 11px solid var(--ink);
      box-shadow: inset 0 0 0 8px var(--surface), inset 0 0 0 17px var(--ink);
      opacity: 0.82;
    }

    .finder-a { top: 42px; left: 42px; }
    .finder-b { top: 42px; right: 42px; }
    .finder-c { bottom: 42px; left: 42px; }

    .scan-line {
      position: absolute;
      left: 26px;
      right: 26px;
      top: 50%;
      height: 1px;
      background: var(--accent);
      box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 54%, transparent);
      animation: schematic-scan 3.6s ease-in-out infinite;
    }

    .scanner-label {
      position: absolute;
      right: 24px;
      bottom: 24px;
      display: grid;
      gap: 3px;
      padding-left: 12px;
      border-left: 1px solid var(--accent);
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 1px;
      text-align: right;
      color: var(--muted);
    }

    .scanner-label strong {
      color: var(--accent);
      font-size: 10px;
      font-weight: 500;
    }

    .schematics-index-bar {
      display: flex;
      min-height: 68px;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border-strong);
    }

    .schematics-index-bar > div {
      display: flex;
      align-items: baseline;
      gap: 15px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1px;
    }

    .schematics-index-bar > div span { color: var(--accent); }
    .schematics-index-bar > div strong { color: var(--muted); font-weight: 500; }

    .schematics-index-bar a {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      gap: 7px;
      color: var(--text);
      font-size: 12px;
      text-decoration: none;
    }

    .schematics-index-bar a:hover,
    .schematics-index-bar a:focus-visible { color: var(--accent); }

    .schematics-index-bar svg {
      width: 15px;
      height: 15px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .schematics-library { padding-block: 82px 110px; }

    .schematics-library-heading {
      display: grid;
      grid-template-columns: 1fr minmax(260px, 0.72fr);
      gap: 48px;
      align-items: end;
      margin-bottom: 42px;
    }

    .schematics-library-heading span {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 1.5px;
    }

    .schematics-library-heading h2 {
      margin: 11px 0 0;
      color: var(--ink);
      font-family: var(--font-serif);
      font-size: 28px;
      font-weight: 500;
      line-height: 1.2;
    }

    .schematics-library-heading p {
      margin: 0;
      font-size: 13px;
      line-height: 1.75;
    }

    .schematics-toolbar {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 28px;
    }

    .schematics-tabs {
      position: relative;
      display: inline-grid;
      grid-template-columns: repeat(2, minmax(150px, 1fr));
      gap: 0;
      overflow: hidden;
      border: 1px solid var(--border-strong);
      border-radius: 12px;
      background: var(--surface);
    }

    /* 選中狀態＝滑動填色膠囊（寬度剛好是自身寬，故 translateX(100%) 正好對齊右格） */
    .schematics-thumb {
      position: absolute;
      z-index: 0;
      top: 3px;
      bottom: 3px;
      left: 3px;
      width: calc(50% - 3px);
      border-radius: 9px;
      background: var(--surface-2);
      transition: transform 240ms cubic-bezier(0.22, 0.8, 0.36, 1);
    }

    .schematics-tabs[data-active="playful"] .schematics-thumb {
      transform: translateX(100%);
    }

    .schematics-tabs button {
      position: relative;
      z-index: 1;
      display: grid;
      min-height: 54px;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 0 14px;
      padding: 12px 16px;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: var(--text);
      text-align: left;
      cursor: pointer;
    }

    /* 中文與英文疊在同一格，hover 時互換 */
    .schematics-tab-zh,
    .schematics-tab-en {
      grid-row: 1;
      grid-column: 1;
      transition: opacity 220ms ease, transform 220ms ease;
    }

    .schematics-tab-zh {
      color: var(--text);
      font-size: 15px;
      font-weight: 500;
    }

    .schematics-tabs button[aria-selected="true"] .schematics-tab-zh {
      color: var(--ink);
    }

    .schematics-tab-en {
      font-family: var(--font-mono);
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      opacity: 0;
      transform: translateY(6px);
      pointer-events: none;
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
    }

    .schematics-tab-en-practical {
      background-image: linear-gradient(105deg, #6fae95 0%, #4f826f 55%, #3a6153 100%);
    }

    .schematics-tab-en-playful {
      background-image: linear-gradient(105deg, #e0997c 0%, #c96442 55%, #a44c2f 100%);
    }

    /* 深色主題用較亮的漸層，避免深色端沉進背景 */
    [data-theme="dark"] .schematics-tab-en-practical {
      background-image: linear-gradient(105deg, #a5d9c4 0%, #7ba994 55%, #5c8a75 100%);
    }

    [data-theme="dark"] .schematics-tab-en-playful {
      background-image: linear-gradient(105deg, #f0a689 0%, #d97757 55%, #b85a3c 100%);
    }

    .schematics-tabs em {
      grid-row: 1;
      grid-column: 2;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 12px;
      font-style: normal;
      font-weight: 500;
      letter-spacing: 1px;
      transition: color 180ms ease;
    }

    .schematics-tabs button[aria-selected="true"] em {
      color: var(--accent);
    }

    /* 中／英互換只在有滑鼠的裝置啟用；觸控裝置維持中文＋數字 */
    @media (hover: hover) and (pointer: fine) {
      .schematics-tabs button:hover .schematics-tab-zh,
      .schematics-tabs button:focus-visible .schematics-tab-zh {
        opacity: 0;
        transform: translateY(-6px);
      }

      .schematics-tabs button:hover .schematics-tab-en,
      .schematics-tabs button:focus-visible .schematics-tab-en {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .schematics-panel[hidden] {
      display: none;
    }

    .schematics-view-toggle {
      position: relative;
      display: inline-flex;
      overflow: hidden;
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      background: var(--surface);
    }

    .schematics-view-thumb {
      position: absolute;
      z-index: 0;
      top: 3px;
      bottom: 3px;
      left: 3px;
      width: calc(50% - 3px);
      border-radius: 5px;
      background: color-mix(in srgb, var(--accent) 11%, transparent);
      transition: transform 240ms cubic-bezier(0.22, 0.8, 0.36, 1);
    }

    .schematics-view-toggle[data-active="list"] .schematics-view-thumb {
      transform: translateX(100%);
    }

    .schematics-view-toggle button {
      position: relative;
      z-index: 1;
      display: grid;
      width: 44px;
      height: 44px;
      place-items: center;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      transition: color 180ms ease;
    }

    .schematics-view-toggle button[aria-pressed="true"] {
      color: var(--accent);
    }

    .schematics-view-toggle svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .schematics-search {
      display: flex;
      align-items: center;
      gap: 10px;
      max-width: 360px;
      height: 44px;
      margin-bottom: 24px;
      padding: 0 14px;
      border: 1px solid var(--border-strong);
      border-radius: 10px;
      background: var(--surface);
      transition: border-color 0.2s ease;
    }

    .schematics-search:focus-within {
      border-color: var(--accent);
    }

    .schematics-search svg {
      flex: none;
      width: 16px;
      height: 16px;
      fill: none;
      stroke: var(--muted);
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: stroke 0.2s ease;
    }

    .schematics-search:focus-within svg {
      stroke: var(--accent);
    }

    .schematics-search input {
      flex: 1;
      min-width: 0;
      border: 0;
      background: transparent;
      color: var(--ink);
      font-size: 14px;
      outline: none;
    }

    .schematics-search input::placeholder {
      color: var(--muted);
    }

    .schematics-search-empty {
      margin-bottom: 18px;
      padding: 16px 18px;
      border: 1px solid var(--border-strong);
      background: color-mix(in srgb, var(--surface) 74%, var(--schematic-green-soft));
      color: var(--muted);
      font-size: 13px;
      line-height: 1.75;
    }

    .schematics-search-empty[hidden] {
      display: none;
    }

    .schematics-search-empty strong {
      color: var(--ink);
      font-weight: 500;
    }

    .schematics-list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }

    .schematic-card {
      overflow: hidden;
      border: 1px solid var(--border-strong);
      border-radius: 16px;
      background: var(--surface);
    }

    .schematic-card-head {
      display: flex;
      min-height: 52px;
      align-items: center;
      gap: 11px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-soft);
    }

    .schematic-card-head > span {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 10px;
    }

    .schematic-card h3 {
      margin: 0;
      color: var(--ink);
      font-family: var(--font-serif);
      font-size: 16px;
      font-weight: 500;
      line-height: 1.35;
    }

    .schematic-qr {
      position: relative;
      display: block;
      width: calc(100% - 28px);
      aspect-ratio: 3 / 4;
      margin: 14px;
      padding: 0;
      overflow: hidden;
      border: 0;
      border-radius: 0;
      background: #fff;
      cursor: zoom-in;
    }

    .schematic-qr img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: contain;
    }

    .schematic-qr > span {
      position: absolute;
      inset: 8px;
      border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
      pointer-events: none;
    }

    .schematic-card dl { margin: 0; border-top: 1px solid var(--border-soft); }

    .schematic-card dl > div {
      display: grid;
      grid-template-columns: 54px 1fr;
      gap: 8px;
      align-items: baseline;
      padding: 9px 16px;
    }

    .schematic-card dl > div + div { border-top: 1px solid var(--border-soft); }
    .schematic-card dl > div:last-child { padding-bottom: 12px; }
    .schematic-card dt { color: var(--accent); font-size: 11px; font-weight: 500; line-height: 1.4; }
    .schematic-card dd { margin: 0; color: var(--text); font-size: 12px; line-height: 1.4; }

    .schematics-library[data-view="list"] .schematics-list {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    /* 卡片高度由內容與內距決定。先前用 QR 的 aspect-ratio 把高度鎖在 128px，
       但內容只需約 69px，多出來的空間被 grid 預設的 align-content: stretch
       平均分給 head 與 meta 兩列，間距因此變得不規則且整體偏下。 */
    .schematics-library[data-view="list"] .schematic-card {
      display: grid;
      grid-template-columns: 118px minmax(0, 1fr);
      grid-template-areas:
        "qr head"
        "qr meta";
      align-content: start;
      align-items: stretch;
    }

    .schematics-library[data-view="list"] .schematic-card-head {
      grid-area: head;
      min-height: 0;
      padding: 12px 16px 11px;
      border-right: 0;
      border-bottom: 1px solid var(--border-soft);
    }

    /* 取消基礎樣式的 aspect-ratio: 3/4，否則 118px 寬會換算成 157px 高並反過來撐開整張卡 */
    .schematics-library[data-view="list"] .schematic-qr {
      grid-area: qr;
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: auto;
      margin: 0;
      background: var(--ink);
    }

    /* 絕對定位讓圖片不參與列高計算，卡片高度純粹由右側文字欄決定 */
    .schematics-library[data-view="list"] .schematic-qr img {
      position: absolute;
      inset: 0;
      object-fit: cover;
      object-position: center 32%;
      transform: scale(1.55);
      transform-origin: center 32%;
    }

    .schematics-library[data-view="list"] .schematic-qr > span {
      inset: 5px;
    }

    .schematics-library[data-view="list"] .schematic-card dl {
      grid-area: meta;
      display: grid;
      grid-template-columns: 1fr;
      border-top: 0;
    }

    .schematics-library[data-view="list"] .schematic-card dl > div {
      align-items: baseline;
      border-left: 0;
      padding: 9px 16px;
    }

    .schematics-library[data-view="list"] .schematic-card dl > div + div {
      border-top: 1px solid var(--border-soft);
    }

    .schematics-library[data-view="list"] .schematic-card dl > div:last-child {
      padding-bottom: 12px;
    }

    .schematics-pagination {
      grid-column: 1 / -1;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
    }

    .schematics-pagination button {
      display: inline-flex;
      width: 42px;
      height: 42px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      background: var(--surface);
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 11px;
      cursor: pointer;
      transition: border-color 180ms ease, color 180ms ease, background-color 180ms ease;
    }

    .schematics-pagination button:hover,
    .schematics-pagination button[aria-current="page"] {
      border-color: color-mix(in srgb, var(--accent) 58%, var(--border-strong));
      background: color-mix(in srgb, var(--accent) 12%, var(--surface));
      color: var(--accent);
    }

    .schematics-pagination button:disabled {
      cursor: default;
      opacity: 0.38;
    }

    .schematics-pagination svg {
      width: 16px;
      height: 16px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* 頁碼群組不再另外包一圈邊框：按鈕本身已有邊框與選中底色，
       外層再加會變成雙層框。間距與外層 .schematics-pagination 的 gap 對齊。 */
    .pagination-pages {
      display: flex;
      gap: 8px;
    }

    .schematics-empty {
      display: grid;
      grid-template-columns: 190px 1fr;
      min-height: 270px;
      align-items: center;
      gap: 48px;
      padding: 38px 9%;
      border: 1px solid var(--border-strong);
      background: color-mix(in srgb, var(--surface) 74%, var(--schematic-green-soft));
    }

    .empty-mark {
      position: relative;
      width: 160px;
      aspect-ratio: 1;
      border: 1px solid var(--schematic-line);
      background-image:
        linear-gradient(var(--schematic-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--schematic-line) 1px, transparent 1px);
      background-size: 16px 16px;
    }

    .empty-mark span {
      position: absolute;
      width: 36px;
      height: 36px;
      border: 6px solid var(--muted);
      opacity: 0.45;
    }

    .empty-mark span:nth-child(1) { top: 18px; left: 18px; }
    .empty-mark span:nth-child(2) { top: 18px; right: 18px; }
    .empty-mark span:nth-child(3) { bottom: 18px; left: 18px; }

    .schematics-empty > div:last-child > span {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.5px;
    }

    .schematics-empty h3 {
      margin: 10px 0 0;
      color: var(--ink);
      font-family: var(--font-serif);
      font-size: 24px;
      font-weight: 500;
    }

    .schematics-empty p { margin: 12px 0 0; font-size: 13px; line-height: 1.75; }

    .schematic-lightbox[hidden] {
      display: none;
    }

    .schematic-lightbox {
      position: fixed;
      z-index: 80;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 24px;
    }

    .lightbox-backdrop {
      position: absolute;
      inset: 0;
      border: 0;
      background: color-mix(in srgb, var(--bg) 74%, #000);
      opacity: 0.92;
      cursor: zoom-out;
    }

    .lightbox-dialog {
      position: relative;
      z-index: 1;
      width: min(92vw, 620px, calc((88vh - 68px) * 0.75));
      overflow: hidden;
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      background: var(--surface);
      box-shadow: 0 24px 70px color-mix(in srgb, #000 32%, transparent);
    }

    .lightbox-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border-soft);
    }

    .lightbox-head span {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 1.4px;
    }

    .lightbox-head h2 {
      margin: 4px 0 0;
      color: var(--ink);
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 500;
      line-height: 1.2;
    }

    .lightbox-head button {
      display: grid;
      flex: 0 0 auto;
      width: 38px;
      height: 38px;
      place-items: center;
      border: 1px solid var(--border-soft);
      border-radius: 999px;
      background: transparent;
      color: var(--text);
      cursor: pointer;
    }

    .lightbox-head svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
    }

    .lightbox-image {
      display: grid;
      aspect-ratio: 3 / 4;
      place-items: center;
      background: #fff;
    }

    .lightbox-image img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: contain;
    }

    .schematics-page :is(a, button):focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    @keyframes schematic-scan {
      0%, 100% { transform: translateY(-108px); opacity: 0; }
      18%, 82% { opacity: 0.9; }
      50% { transform: translateY(108px); opacity: 0.9; }
    }

    @media (max-width: 900px) {
      .schematics-hero { min-height: 400px; }
      .schematics-hero-inner { min-height: 400px; }
      .schematics-scanner {
        right: 18px;
        width: min(42vw, 360px);
        opacity: 0.42;
      }
      .schematics-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    @media (max-width: 700px) {
      .schematics-hero-inner,
      .schematics-index-bar,
      .schematics-library { width: min(calc(100% - 40px), 1180px); }

      .schematics-hero { min-height: 330px; }
      .schematics-hero-inner { min-height: 330px; padding-block: 20px 34px; }
      .schematics-hero-grid { margin-block: 0; padding-block: 42px 8px; }
      .schematics-copy h1 { font-size: 32px; }
      .schematics-copy > p { margin-top: 18px; font-size: 13px; }
      .schematics-scanner {
        top: 58%;
        right: -78px;
        width: min(78vw, 330px);
        opacity: 0.18;
        transform: translateY(-48%);
      }
      [data-theme="dark"] .schematics-scanner { opacity: 0.16; }
      .finder { width: 58px; height: 58px; border-width: 8px; box-shadow: inset 0 0 0 6px var(--surface), inset 0 0 0 13px var(--ink); }
      .finder-a { top: 30px; left: 30px; }
      .finder-b { top: 30px; right: 30px; }
      .finder-c { bottom: 30px; left: 30px; }
      .schematics-index-bar { min-height: 62px; }
      .schematics-index-bar > div strong { display: none; }
      .schematics-index-bar a { font-size: 11px; }
      .schematics-library { padding-block: 62px 82px; }
      .schematics-library-heading { grid-template-columns: 1fr; gap: 18px; margin-bottom: 30px; }
      .schematics-library-heading h2 { font-size: 24px; }
      .schematics-toolbar {
        display: flex;
        align-items: flex-end;
        gap: 10px;
      }
      .schematics-tabs {
        flex: 1 1 auto;
        width: auto;
        min-width: 0;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .schematics-tabs button {
        min-height: 50px;
        gap: 0 8px;
        padding: 10px 13px;
      }
      .schematics-tab-zh { font-size: 13px; }
      .schematics-tabs em { font-size: 11px; }
      .schematics-view-toggle {
        flex: 0 0 auto;
        align-self: flex-end;
      }
      .schematics-search {
        max-width: none;
        margin-bottom: 20px;
      }
      .schematics-library:not([data-view="list"]) .schematic-card-head {
        padding-top: 14px;
        padding-bottom: 10px;
      }
      .schematics-library:not([data-view="list"]) .schematic-card h3 {
        font-size: 14px;
      }
      .schematics-library:not([data-view="list"]) .schematic-card dl > div {
        grid-template-columns: 1fr;
        gap: 2px;
      }
      .schematics-library:not([data-view="list"]) .schematic-card dd {
        padding-left: 10px;
      }
      .schematics-library:not([data-view="list"]) .schematic-card dl > div:last-child {
        padding-top: 7px;
        padding-bottom: 14px;
      }
      .schematics-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: start;
      }
      .schematics-library[data-view="list"] .schematic-card {
        grid-template-columns: 96px 1fr;
        min-height: 110px;
      }
      .schematics-library[data-view="list"] .schematic-card dl {
        grid-template-columns: 1fr;
        border-top: 0;
      }
      .schematics-library[data-view="list"] .schematic-card dl > div {
        border-left: 0;
        padding: 4px 14px;
      }
      .schematics-library[data-view="list"] .schematic-card dl > div:first-child {
        padding-top: 2px;
      }
      .schematics-library[data-view="list"] .schematic-card dl > div:last-child {
        padding-bottom: 10px;
      }
      .schematics-library[data-view="list"] .schematic-qr {
        height: 100%;
        min-height: 0;
        aspect-ratio: 96 / 110;
      }
      .schematics-library[data-view="list"] .schematic-qr img {
        object-position: center 30%;
        transform-origin: center 30%;
      }
      .schematics-pagination {
        justify-content: center;
        margin-top: 8px;
      }
      .schematics-pagination button {
        width: 38px;
        height: 38px;
      }
      .schematics-empty { grid-template-columns: 1fr; gap: 26px; padding: 30px; }
      .empty-mark { width: 128px; }
    }

    @media (max-width: 430px) {
      .schematics-library[data-view="list"] .schematic-card {
        grid-template-columns: 86px 1fr;
        min-height: 110px;
      }

      .schematics-library[data-view="list"] .schematic-card-head {
        padding-inline: 12px;
      }

      .schematics-library[data-view="list"] .schematic-qr {
        aspect-ratio: 86 / 110;
      }

      .schematics-library[data-view="list"] .schematic-card dl > div {
        grid-template-columns: 54px minmax(0, 1fr);
        gap: 8px;
        padding-inline: 12px;
      }

      .schematic-lightbox {
        padding: 14px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .scan-line { animation: none; transform: none; }
    }
  </style>

  <script>
    const schematicTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-schematics-tab]"));
    const schematicTabsRoot = document.querySelector<HTMLElement>("[data-schematics-tabs]");
    const viewToggleRoot = document.querySelector<HTMLElement>("[data-schematics-view-toggle]");
    const schematicPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-schematics-panel]"));
    const schematicsLibrary = document.querySelector<HTMLElement>(".schematics-library");
    const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-schematics-view]"));
    const previewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-preview-src]"));
    const lightbox = document.querySelector<HTMLElement>("[data-schematic-lightbox]");
    const lightboxImage = document.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const lightboxTitle = document.getElementById("lightbox-title");
    const closeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-lightbox-close]"));
    const schematicsSearchInput = document.getElementById("schematics-search-input") as HTMLInputElement | null;
    let lastPreviewButton: HTMLButtonElement | null = null;
    const schematicsPerPage = 12;

    function updateSchematicPage(panel: HTMLElement, page: number) {
      const cards = Array.from(panel.querySelectorAll<HTMLElement>("[data-schematic-card]"));
      const totalPages = Math.max(1, Math.ceil(cards.length / schematicsPerPage));
      const currentPage = Math.min(Math.max(page, 1), totalPages);
      const pageButtons = Array.from(panel.querySelectorAll<HTMLButtonElement>("[data-page-number]"));
      const previousButton = panel.querySelector<HTMLButtonElement>('[data-page-action="prev"]');
      const nextButton = panel.querySelector<HTMLButtonElement>('[data-page-action="next"]');

      panel.dataset.currentPage = String(currentPage);

      cards.forEach((card) => {
        card.hidden = Number(card.dataset.schematicPage ?? "1") !== currentPage;
      });

      pageButtons.forEach((button) => {
        if (Number(button.dataset.pageNumber) === currentPage) {
          button.setAttribute("aria-current", "page");
        } else {
          button.removeAttribute("aria-current");
        }
      });

      if (previousButton) previousButton.disabled = currentPage === 1;
      if (nextButton) nextButton.disabled = currentPage === totalPages;
    }

    schematicPanels.forEach((panel) => {
      updateSchematicPage(panel, 1);

      panel.querySelector("[data-schematics-pagination]")?.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button");
        if (!button) return;

        const currentPage = Number(panel.dataset.currentPage ?? "1");
        const page = button.dataset.pageNumber
          ? Number(button.dataset.pageNumber)
          : button.dataset.pageAction === "next"
            ? currentPage + 1
            : currentPage - 1;

        updateSchematicPage(panel, page);
      });
    });

    function applySchematicSearch(rawQuery: string) {
      const query = rawQuery.trim().toLowerCase();
      const isSearching = query.length > 0;

      schematicPanels.forEach((panel) => {
        const cards = Array.from(panel.querySelectorAll<HTMLElement>("[data-schematic-card]"));
        const pagination = panel.querySelector<HTMLElement>("[data-schematics-pagination]");
        const emptyState = panel.querySelector<HTMLElement>("[data-schematics-search-empty]");

        if (!isSearching) {
          if (pagination) pagination.hidden = false;
          if (emptyState) emptyState.hidden = true;
          updateSchematicPage(panel, Number(panel.dataset.currentPage ?? "1"));
          return;
        }

        let matchCount = 0;
        cards.forEach((card) => {
          const title = (card.dataset.schematicTitle ?? "").toLowerCase();
          const isMatch = title.includes(query);
          card.hidden = !isMatch;
          if (isMatch) matchCount += 1;
        });

        if (pagination) pagination.hidden = true;

        if (emptyState) {
          emptyState.hidden = matchCount !== 0;
          const queryTarget = emptyState.querySelector("[data-schematics-search-empty-query]");
          if (queryTarget) queryTarget.textContent = rawQuery.trim();
        }
      });
    }

    schematicsSearchInput?.addEventListener("input", () => {
      applySchematicSearch(schematicsSearchInput.value);
    });

    schematicTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.schematicsTab;

        schematicTabs.forEach((button) => {
          button.setAttribute("aria-selected", String(button.dataset.schematicsTab === target));
        });

        schematicPanels.forEach((panel) => {
          panel.hidden = panel.dataset.schematicsPanel !== target;
        });

        // 驅動滑動膠囊的位置
        if (schematicTabsRoot && target) schematicTabsRoot.dataset.active = target;
      });
    });

    viewButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const view = button.dataset.schematicsView ?? "grid";
        if (schematicsLibrary) schematicsLibrary.dataset.view = view;

        viewButtons.forEach((viewButton) => {
          viewButton.setAttribute("aria-pressed", String(viewButton.dataset.schematicsView === view));
        });

        if (viewToggleRoot) viewToggleRoot.dataset.active = view;
      });
    });

    function closeLightbox() {
      if (!lightbox || !lightboxImage) return;

      lightbox.hidden = true;
      lightboxImage.src = "";
      lightboxImage.alt = "";
      document.documentElement.style.overflow = "";
      lastPreviewButton?.focus();
    }

    previewButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!lightbox || !lightboxImage || !lightboxTitle) return;

        const title = button.dataset.previewTitle ?? "藍圖預覽";
        const src = button.dataset.previewSrc ?? "";
        lastPreviewButton = button;
        lightboxTitle.textContent = title;
        lightboxImage.src = src;
        lightboxImage.alt = `${title} QR Code`;
        lightbox.hidden = false;
        document.documentElement.style.overflow = "hidden";
        // 限定在對話框內找關閉鈕：closeButtons 也包含遮罩，
        // 而遮罩是 aria-hidden，焦點落在上面等於落進讀屏讀不到的地方。
        lightbox
          .querySelector<HTMLButtonElement>(".lightbox-dialog [data-lightbox-close]")
          ?.focus();
      });
    });

    closeButtons.forEach((button) => {
      button.addEventListener("click", closeLightbox);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && lightbox && !lightbox.hidden) {
        closeLightbox();
      }
    });

    // 焦點鎖在對話框內：燈箱宣告了 aria-modal="true"，若 Tab 能跑到背景，
    // 鍵盤使用者會在看不見的元素上操作，與「背景不存在」的宣告矛盾。
    lightbox?.addEventListener("keydown", (event) => {
      if (event.key !== "Tab" || lightbox.hidden) return;

      // 每次都重新查詢，並用 tabIndex >= 0 過濾。
      // 不能只靠 CSS 的 :not([tabindex="-1"])——那是 OR 條件，
      // 遮罩仍會被前面的 button 選擇器命中而混進循環。
      const focusables = Array.from(
        lightbox.querySelectorAll<HTMLElement>("button, a[href], [tabindex]")
      ).filter(
        (el) =>
          el.tabIndex >= 0 &&
          !(el as HTMLButtonElement).disabled &&
          el.offsetParent !== null
      );
      if (focusables.length === 0) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  </script>
</BaseLayout>
