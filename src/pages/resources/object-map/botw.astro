---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { href } from "../../../lib/url";
import { GAME_LOGOS } from "../../../data/gameLogos";

const MAP_URL = "https://objmap.zeldamods.org/";

const queryExamples = [
  {
    label: "基本名稱",
    query: "Bokoblin",
    description: "同時搜尋顯示名稱與遊戲內部資料。",
  },
  {
    label: "完整片語",
    query: '"Blue Bokoblin"',
    description: "用引號包住完整名稱，避免拆成多個關鍵字。",
  },
  {
    label: "同時符合",
    query: 'Lizalfos "Royal Bow"',
    description: "空格等同 AND，只留下同時符合兩個條件的結果。",
  },
  {
    label: "排除結果",
    query: 'Lynel NOT "Lynel Bow"',
    description: "保留萊尼爾，但排除含有 Lynel Bow 的項目。",
  },
  {
    label: "萬用字元",
    query: "TBox_* hard:0",
    description: "搜尋一般模式中的 TBox 系列寶箱物件。",
  },
];

const fieldFilters = [
  { field: "map", value: "MainField/E-4", use: "限定地圖或地圖單位" },
  { field: "static", value: "1", use: "1 為 Static，0 為 Dynamic" },
  { field: "actor", value: "Weapon_Sword_001", use: "依遊戲內部 Actor 名稱搜尋" },
  { field: "name", value: '"Traveler\'s Sword"', use: "依玩家看見的物件名稱搜尋" },
  { field: "data", value: "IsGet_", use: "搜尋物件內部資料" },
  { field: "drop", value: "Arrow", use: "搜尋掉落物或寶箱內容" },
  { field: "equip", value: "Bow", use: "搜尋敵人持有的裝備" },
  { field: "onehit", value: "1", use: "限定一擊必殺之劍挑戰物件" },
  { field: "lastboss", value: "1", use: "限定進入城堡主殿後的物件" },
  { field: "hard", value: "0", use: "排除大師模式專屬物件" },
  { field: "no_rankup", value: "1", use: "不會隨世界等級升級" },
  { field: "scale", value: "0", use: "不會隨世界等級變化" },
  { field: "bonus", value: "2", use: "指定最低附加效果等級" },
];

const mapTools = [
  {
    no: "01",
    title: "Add to map",
    text: "搜尋完成後，把整組結果加入地圖。不同搜尋可以保留為不同顏色的群組。",
  },
  {
    no: "02",
    title: "Filter",
    text: "控制地名、神廟、塔、商店、克洛格與可見地圖區域，降低畫面上的資訊量。",
  },
  {
    no: "03",
    title: "Go to coordinates",
    text: "輸入座標直接前往目標位置，適合搭配遊戲內座標或研究資料使用。",
  },
  {
    no: "04",
    title: "Object Display",
    text: "可切換內部 Actor 名稱、Hash ID、高度、位置與物件卸載範圍等進階資訊。",
  },
];
---

<BaseLayout
  title="Léo 曠野物件地圖使用指南"
  description="BotW Object Map 搜尋語法、欄位篩選與地圖工具使用指南。"
  active="resources"
>
  <main class="obj-guide">
    <div class="obj-hero-shell">
      <div class="obj-hero-canvas" aria-hidden="true">
        <img
          class="obj-hero-map"
          src={href("/resource-guides/botw-object-map.jpg")}
          alt=""
          width="960"
          height="332"
          fetchpriority="high"
        />
        <div class="obj-hero-shade"></div>
      </div>

    <section class="obj-hero" aria-labelledby="guide-title">
      <div class="obj-scan" aria-hidden="true">
        <span class="obj-scan-ring obj-scan-ring-a"></span>
        <span class="obj-scan-ring obj-scan-ring-b"></span>
        <span class="obj-scan-cross obj-scan-cross-x"></span>
        <span class="obj-scan-cross obj-scan-cross-y"></span>
        <span class="obj-scan-dot"></span>
      </div>

      <div class="obj-hero-inner">
        <nav class="obj-breadcrumb" aria-label="麵包屑">
          <a href={href("/")}>首頁</a>
          <span>/</span>
          <a href={href("/resources#botw")}>資料網站</a>
          <span>/</span>
          <span aria-current="page">物件地圖</span>
        </nav>

        <div class="obj-hero-content">
          <div class="obj-kicker">
            <svg viewBox={GAME_LOGOS.botw.viewBox} aria-hidden="true" set:html={GAME_LOGOS.botw.svg} />
            <span>Breath of the Wild · Object Map Guide</span>
          </div>
          <h1 id="guide-title">Léo 曠野物件地圖</h1>
          <p>不只搜尋名稱。用欄位、條件與布林語法，把海拉魯縮小成你真正需要的答案。</p>

          <div class="obj-hero-meta">
            <span>Created by Léo Lam</span>
            <span>English interface</span>
            <span>Advanced object data</span>
          </div>

          <div class="obj-hero-actions">
            <a class="obj-primary-action" href={MAP_URL} target="_blank" rel="noopener">
              <span>開啟曠野物件地圖</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 5h5v5M19 5l-8 8M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
              </svg>
            </a>
            <a class="obj-secondary-action" href={href("/resources#botw")}>回到資料網站</a>
          </div>
        </div>

        <div class="obj-coordinate" aria-hidden="true">
          <span>SCAN AREA</span>
          <strong>MAIN FIELD</strong>
          <span>X 0000 · Z 0000</span>
        </div>
      </div>
    </section>

    <nav class="obj-section-nav" aria-label="本頁章節">
      <div class="obj-section-nav-inner">
        <span class="obj-section-nav-label">GUIDE / 01</span>
        <a href="#start">快速開始</a>
        <a href="#syntax">搜尋語法</a>
        <a href="#filters">欄位篩選</a>
        <a href="#tools">地圖工具</a>
        <a href="#notes">注意事項</a>
      </div>
    </nav>
    </div>

    <section id="start" class="obj-section obj-section-intro obj-reveal">
      <div class="obj-wrap">
        <div class="obj-section-heading">
          <span>START HERE · 快速開始</span>
          <h2>先會三件事，就能開始查。</h2>
        </div>

        <div class="obj-start-grid">
          <article>
            <span class="obj-step-no">01</span>
            <h3>輸入名稱</h3>
            <p>可輸入英文顯示名稱，也可以直接輸入遊戲內部 Actor 名稱。</p>
            <code>Bokoblin</code>
          </article>
          <article>
            <span class="obj-step-no">02</span>
            <h3>加入條件</h3>
            <p>使用 <code>欄位:內容</code>，把結果限定在地圖、模式或物件屬性。</p>
            <code>scale:0</code>
          </article>
          <article>
            <span class="obj-step-no">03</span>
            <h3>放上地圖</h3>
            <p>確認搜尋結果後按下 Add to map，標記才會固定顯示在地圖上。</p>
            <code>Add to map</code>
          </article>
        </div>
      </div>
    </section>

    <section id="syntax" class="obj-section obj-section-lab obj-reveal">
      <div class="obj-wrap obj-lab-layout">
        <div class="obj-lab-copy">
          <div class="obj-section-heading">
            <span>QUERY LAB · 搜尋式組合器</span>
            <h2>搜尋不是猜字，是組條件。</h2>
          </div>
          <p>
            以 <code>Lynel</code> 為起點，切換右側條件看看搜尋式如何變化。空格代表 AND，
            <code>NOT</code> 會排除符合的結果。
          </p>

          <div class="obj-query-output" aria-live="polite">
            <span>SEARCH QUERY</span>
            <code id="query-output">Lynel</code>
            <button id="copy-query" type="button" data-copy-target="query-output">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="8" y="8" width="11" height="11" rx="2"></rect>
                <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
              </svg>
              <span>複製搜尋式</span>
            </button>
          </div>
        </div>

        <div class="obj-query-controls" aria-label="搜尋條件">
          <div>
            <span class="obj-control-label">基本關鍵字</span>
            <code>Lynel</code>
          </div>
          <button type="button" class="obj-token" data-query-token={'NOT "Lynel Bow"'} aria-pressed="false">
            <span>排除弓箭結果</span>
            <code>NOT "Lynel Bow"</code>
          </button>
          <button type="button" class="obj-token" data-query-token="scale:0" aria-pressed="false">
            <span>不隨世界等級變化</span>
            <code>scale:0</code>
          </button>
          <button type="button" class="obj-token" data-query-token="hard:0" aria-pressed="false">
            <span>排除大師模式專屬</span>
            <code>hard:0</code>
          </button>
        </div>
      </div>
    </section>

    <section class="obj-section obj-reveal" aria-labelledby="recipes-title">
      <div class="obj-wrap">
        <div class="obj-section-heading obj-heading-row">
          <div>
            <span>SEARCH RECIPES · 常用查詢</span>
            <h2 id="recipes-title">先從可直接使用的語法開始。</h2>
          </div>
          <p>點擊每列右側圖示即可複製，再貼進物件地圖的搜尋框。</p>
        </div>

        <div class="obj-recipe-list">
          {queryExamples.map((item, index) => (
            <article class="obj-recipe" style={`--i:${index}`}>
              <span class="obj-recipe-label">{item.label}</span>
              <code>{item.query}</code>
              <p>{item.description}</p>
              <button type="button" class="obj-copy-icon" data-copy={item.query} aria-label={`複製「${item.query}」`} title="複製搜尋式">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="8" y="8" width="11" height="11" rx="2"></rect>
                  <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
                </svg>
              </button>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="filters" class="obj-section obj-section-filters obj-reveal">
      <div class="obj-wrap obj-filter-layout">
        <div class="obj-section-heading obj-filter-intro">
          <span>COLUMN FILTERS · 欄位篩選</span>
          <h2>把「找得到」變成「只剩要找的」。</h2>
          <p>
            欄位語法固定使用 <code>COLUMN:QUERY</code>。不同欄位可以放在同一條搜尋式中，逐步縮小結果。
          </p>
          <div class="obj-filter-formula">
            <code>^Bokoblin scale:0 hard:0</code>
            <span>名稱開頭符合 + 不升級 + 一般模式</span>
          </div>
        </div>

        <div class="obj-filter-list">
          {fieldFilters.map((item) => (
            <details>
              <summary>
                <code>{item.field}:</code>
                <span>{item.use}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </summary>
              <div>
                <span>範例</span>
                <code>{item.field}:{item.value}</code>
                <button type="button" data-copy={`${item.field}:${item.value}`}>複製</button>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="tools" class="obj-section obj-reveal">
      <div class="obj-wrap">
        <div class="obj-section-heading">
          <span>MAP WORKFLOW · 地圖工具</span>
          <h2>搜尋完成後，才是地圖工作的開始。</h2>
        </div>

        <div class="obj-tools-list">
          {mapTools.map((tool) => (
            <article>
              <span>{tool.no}</span>
              <h3>{tool.title}</h3>
              <p>{tool.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="notes" class="obj-section obj-section-notes obj-reveal">
      <div class="obj-wrap obj-notes-layout">
        <div>
          <span class="obj-note-mark">FIELD NOTES</span>
          <h2>使用前注意</h2>
        </div>
        <ul>
          <li>物件地圖會顯示未探索地區、內部名稱與任務物件，可能包含劇情或探索上的雷。</li>
          <li>搜尋結果預設有顯示數量上限；條件太寬時，請加入欄位或關鍵字再搜尋。</li>
          <li>名稱中含有單引號時，請用雙引號包住整個名稱，例如 <code>"Traveler's Shield"</code>。</li>
          <li>Master Mode、LastBoss Mode 等顯示設定不一定會改變搜尋結果，仍應在搜尋式中加入對應欄位。</li>
        </ul>
      </div>
    </section>

    <section class="obj-final-cta obj-reveal">
      <div class="obj-wrap">
        <span>READY TO SEARCH</span>
        <h2>帶著搜尋式，回到海拉魯。</h2>
        <a href={MAP_URL} target="_blank" rel="noopener">
          開啟曠野物件地圖
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 5h5v5M19 5l-8 8M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <style>
    .obj-guide {
      --guide-line: color-mix(in srgb, var(--accent) 42%, var(--border-strong));
      --hero-base: var(--surface);
      --hero-ink: var(--ink);
      --hero-ink-soft: color-mix(in srgb, var(--ink) 80%, transparent);
      --hero-ink-muted: color-mix(in srgb, var(--ink) 56%, transparent);
      --hero-accent: var(--brand);
      --hero-frame: color-mix(in srgb, var(--ink) 12%, transparent);
      --hero-overlay:
        linear-gradient(
          to bottom,
          color-mix(in srgb, var(--surface) 96%, transparent) 0%,
          color-mix(in srgb, var(--surface) 68%, transparent) 16%,
          color-mix(in srgb, var(--bg) 12%, transparent) 46%,
          color-mix(in srgb, var(--bg) 54%, transparent) 78%,
          var(--bg) 100%
        ),
        linear-gradient(
          90deg,
          color-mix(in srgb, var(--surface) 88%, transparent) 0%,
          color-mix(in srgb, var(--surface) 62%, transparent) 44%,
          color-mix(in srgb, var(--surface) 20%, transparent) 100%
        );
      --hero-map-opacity: 0.6;
      --hero-map-filter: saturate(0.42) contrast(0.96) brightness(1.12);
      --hero-canvas-height: calc(min(620px, calc(100svh - 120px)) + 55px);
      --hero-nav-bg: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--bg) 78%, transparent),
        var(--bg)
      );
      overflow: clip;
    }

    :global([data-theme="dark"]) .obj-guide {
      --hero-base: #171713;
      --hero-ink: #faf9f5;
      --hero-ink-soft: rgba(250, 249, 245, 0.82);
      --hero-ink-muted: rgba(250, 249, 245, 0.56);
      --hero-accent: #ef9779;
      --hero-frame: rgba(250, 249, 245, 0.18);
      --hero-overlay: color-mix(in srgb, #141413 74%, transparent);
      --hero-map-opacity: 1;
      --hero-map-filter: saturate(0.72) contrast(1.08) brightness(0.72);
      --hero-nav-bg: var(--bg);
    }

    .obj-wrap,
    .obj-hero-inner,
    .obj-section-nav-inner {
      width: min(1180px, calc(100% - 64px));
      margin-inline: auto;
    }

    .obj-hero-shell {
      position: relative;
      isolation: isolate;
      overflow: clip;
    }

    .obj-hero-shell::after {
      content: "";
      position: absolute;
      inset: 18px 18px 0;
      border: 1px solid var(--hero-frame);
      border-bottom: 0;
      pointer-events: none;
      z-index: 31;
    }

    .obj-hero-canvas {
      position: absolute;
      inset: 0 0 auto;
      z-index: 0;
      height: var(--hero-canvas-height);
      overflow: hidden;
      pointer-events: none;
      background: var(--hero-base);
    }

    .obj-hero {
      position: relative;
      height: min(620px, calc(100svh - 120px));
      min-height: 480px;
      overflow: hidden;
      background: transparent;
      color: var(--hero-ink);
      isolation: isolate;
      transition: color 240ms ease;
    }

    .obj-hero-map,
    .obj-hero-shade {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .obj-hero-map {
      object-fit: cover;
      object-position: center;
      filter: var(--hero-map-filter);
      opacity: var(--hero-map-opacity);
      transform: scale(1.035);
      animation: obj-map-settle 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .obj-hero-shade {
      background: var(--hero-overlay);
      z-index: 1;
    }

    .obj-hero-inner {
      position: relative;
      z-index: 4;
      height: 100%;
      display: flex;
      flex-direction: column;
      padding-block: 28px 42px;
    }

    .obj-breadcrumb {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 12px;
      color: var(--hero-ink-muted);
    }

    .obj-breadcrumb a {
      color: inherit;
      text-decoration: none;
    }

    .obj-breadcrumb a:hover {
      color: var(--hero-ink);
    }

    .obj-hero-content {
      max-width: 720px;
      margin-block: auto;
      padding-block: 24px;
    }

    .obj-kicker {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
      color: #ef9779;
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 1.4px;
      text-transform: uppercase;
    }

    .obj-kicker svg {
      width: 22px;
      height: 22px;
      fill: currentColor;
    }

    .obj-hero h1 {
      max-width: none;
      margin: 0;
      font-family: var(--font-serif);
      font-size: 44px;
      font-weight: 500;
      line-height: 1.08;
      letter-spacing: 0;
      white-space: nowrap;
      opacity: 0;
      transform: translateY(18px);
      animation: obj-rise 0.72s 0.12s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .obj-hero-content > p {
      max-width: 41rem;
      margin: 22px 0 0;
      color: var(--hero-ink-soft);
      font-size: 17px;
      line-height: 1.85;
      opacity: 0;
      transform: translateY(14px);
      animation: obj-rise 0.68s 0.24s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .obj-hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      margin-top: 22px;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--hero-ink-muted);
      text-transform: uppercase;
    }

    .obj-hero-meta span + span::before {
      content: "/";
      margin-right: 18px;
      color: var(--hero-accent);
    }

    .obj-hero-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px 22px;
      margin-top: 30px;
    }

    .obj-primary-action,
    .obj-final-cta a {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 0 20px;
      background: #c96442;
      color: #faf9f5;
      border: 1px solid #d97757;
      border-radius: 7px;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      transition: background-color 180ms, border-color 180ms, transform 120ms;
    }

    .obj-primary-action svg,
    .obj-final-cta svg {
      width: 17px;
      height: 17px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .obj-primary-action:hover,
    .obj-final-cta a:hover {
      background: #d97757;
      border-color: #ef9779;
    }

    .obj-primary-action:active,
    .obj-final-cta a:active {
      transform: translateY(1px);
    }

    .obj-secondary-action {
      padding-block: 12px;
      color: var(--hero-ink-soft);
      font-size: 14px;
      text-underline-offset: 4px;
    }

    .obj-coordinate {
      position: absolute;
      right: 0;
      bottom: 42px;
      display: grid;
      gap: 3px;
      min-width: 158px;
      padding-left: 16px;
      border-left: 1px solid color-mix(in srgb, var(--hero-ink) 24%, transparent);
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 1px;
      color: var(--hero-ink-muted);
      text-align: left;
    }

    .obj-coordinate strong {
      color: var(--hero-accent);
      font-size: 11px;
      font-weight: 500;
    }

    .obj-scan {
      position: absolute;
      top: 50%;
      right: 17%;
      width: 260px;
      height: 260px;
      transform: translate(50%, -50%);
      z-index: 3;
      pointer-events: none;
    }

    .obj-scan-ring,
    .obj-scan-cross,
    .obj-scan-dot {
      position: absolute;
      display: block;
    }

    .obj-scan-ring {
      inset: 0;
