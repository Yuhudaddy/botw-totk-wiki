          langOptions.forEach(function (option, index) {
            option.addEventListener("click", function () {
              var next = option.getAttribute("data-lang-option");
              applyLang(next);
              try { localStorage.setItem("entrance-lang", next); } catch (error) {}
              closeLangMenu(true);
            });

            option.addEventListener("keydown", function (event) {
              if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
              event.preventDefault();
              var step = event.key === "ArrowDown" ? 1 : -1;
              var target = langOptions[(index + step + langOptions.length) % langOptions.length];
              if (target) target.focus();
            });
          });

          document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") closeLangMenu(true);
          });

          document.addEventListener("pointerdown", function (event) {
            if (langSwitch && !langSwitch.contains(event.target)) closeLangMenu(false);
          });
        }

        applyLang(currentLang());

        if (themeButton) {
          themeButton.addEventListener("click", function () {
            var current = currentTheme();
            var next = current === "dark" ? "light" : "dark";
            if (themeButton.disabled) return;

            var reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (reducedMotion) {
              commitTheme(next);
              return;
            }

            var sourceDisc = themeButton.querySelector(current === "dark" ? ".moon-disc" : ".sun-disc");
            var targetDisc = themeButton.querySelector(next === "dark" ? ".moon-disc" : ".sun-disc");
            var glow = themeButton.querySelector(".celestial-glow");
            var fadeTransition = "opacity 260ms cubic-bezier(0.65, 0, 0.35, 1)";
            var revealTransition = "opacity 650ms cubic-bezier(0.65, 0, 0.35, 1)";

            themeButton.disabled = true;
            themeButton.classList.add("is-switching");
            [sourceDisc, targetDisc, glow].forEach(function (node) {
              if (!node) return;
              node.style.transition = fadeTransition;
              node.style.opacity = "0";
            });

            // 先讓目前位置的圖示完整淡出，再讓父層換到另一個主題的位置。
            window.setTimeout(function () {
              commitTheme(next);
              themeButton.classList.add("is-relocating");
              themeButton.classList.remove("is-switching");

              window.requestAnimationFrame(function () {
                if (targetDisc) {
                  targetDisc.style.transition = revealTransition;
                  targetDisc.style.opacity = "1";
                }
                if (glow) {
                  glow.style.transition = revealTransition;
                  glow.style.removeProperty("opacity");
                }

                window.setTimeout(function () {
                  [sourceDisc, targetDisc, glow].forEach(function (node) {
                    if (!node) return;
                    node.style.removeProperty("opacity");
                    node.style.removeProperty("transition");
                  });
                  themeButton.classList.remove("is-relocating");
                  themeButton.disabled = false;
                }, 760);
              });
            }, 320);
          });
          themeButton.addEventListener("pointerup", function () { themeButton.blur(); });
        }

        document.addEventListener("visibilitychange", function () {
          if (page) page.classList.toggle("is-paused", document.hidden);
        });

        var reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        var finePointer = window.matchMedia("(pointer: fine)");
        var pointerFrame = 0;

        window.addEventListener("pointermove", function (event) {
          if (reducedMotion.matches || !finePointer.matches || pointerFrame) return;
          pointerFrame = window.requestAnimationFrame(function () {
            var x = (event.clientX / window.innerWidth - 0.5) * 2;
            var y = (event.clientY / window.innerHeight - 0.5) * 2;
            root.style.setProperty("--scene-x", (x * 1.5).toFixed(2) + "px");
            root.style.setProperty("--scene-y", (y * 1).toFixed(2) + "px");
            pointerFrame = 0;
          });
        }, { passive: true });
      })();
    </script>
  </body>
</html>
