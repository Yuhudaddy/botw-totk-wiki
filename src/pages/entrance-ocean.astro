---
import { SITE } from "../data/site";
import { href } from "../lib/url";

const wikiHomeUrl = href("/home");
---

<!doctype html>
<html lang="en" class="ocean-html">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="Advanced game guides and mechanics for The Legend of Zelda, Super Smash Bros., and beyond."
    />
    <meta name="theme-color" content="#dce5ec" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <title>Yuda's Channel · Game Wiki</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Noto+Sans+TC:wght@400;500;600&family=Noto+Serif+JP:wght@400;500&family=Noto+Serif+TC:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        var theme = "dark";
        try {
          var saved = localStorage.getItem("wiki-theme");
          if (saved === "light" || saved === "dark") {
            theme = saved;
          } else {
            theme = window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
          }
        } catch (error) {
          theme = "dark";
        }
        document.documentElement.setAttribute("data-theme", theme);
        document.documentElement.style.colorScheme = theme;

        var lang = "en";
        try {
          var savedLang = localStorage.getItem("entrance-lang");
          if (savedLang === "zh" || savedLang === "en" || savedLang === "ja") {
            lang = savedLang;
          }
        } catch (error) {
          lang = "en";
        }
        document.documentElement.setAttribute("data-lang", lang);
        document.documentElement.setAttribute(
          "lang",
          lang === "zh" ? "zh-Hant-TW" : lang === "ja" ? "ja" : "en"
        );
      })();
    </script>
  </head>

  <body class="ocean-page">
    <a class="skip-link" href="#ocean-content">Skip to main content</a>

    <div class="scene" aria-hidden="true">
      <picture class="scene-art scene-art-day">
        <source
          media="(max-width: 767px)"
          type="image/avif"
          srcset={href("/entrance-ocean/island-coast-dazotikuy-v2-mobile.avif")}
        />
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset={href("/entrance-ocean/island-coast-dazotikuy-v2-mobile.webp")}
        />
        <source
          type="image/avif"
          srcset={href("/entrance-ocean/island-coast-dazotikuy-v2.avif")}
        />
        <img
          src={href("/entrance-ocean/island-coast-dazotikuy-v2.webp")}
          alt=""
          width="1672"
          height="941"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <picture class="scene-art scene-art-night">
        <source
          media="(max-width: 767px)"
          type="image/avif"
          srcset={href("/entrance-ocean/island-coast-dazotikuy-v2-night-mobile.avif")}
        />
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset={href("/entrance-ocean/island-coast-dazotikuy-v2-night-mobile.webp")}
        />
        <source
          type="image/avif"
          srcset={href("/entrance-ocean/island-coast-dazotikuy-v2-night.avif")}
        />
        <img
          src={href("/entrance-ocean/island-coast-dazotikuy-v2-night.webp")}
          alt=""
          width="1672"
          height="941"
          decoding="async"
        />
      </picture>
      <div class="scene-lighting scene-lighting-day"></div>
      <div class="scene-lighting scene-lighting-night"></div>
      <div class="scene-lighting scene-night-depth"></div>
      <div class="scene-lighting scene-night-moonlight"></div>
      <div class="sky"></div>
      <div class="stars stars-far"></div>
      <div class="stars stars-near"></div>

      <svg class="cloud-layer cloud-layer-far ambient-motion" viewBox="0 0 1600 440" preserveAspectRatio="none">
        <path d="M-90 138C82 95 206 113 337 148c115 31 229 17 356-21 154-47 274-30 390 9 150 51 281 23 433-15 93-23 157-13 216 12v126H-90Z" />
        <path d="M140 47c121-30 238-14 341 15 124 35 238 29 339-3 100-32 198-24 298 9 100 32 190 34 283 8v104H140Z" />
      </svg>
      <svg class="cloud-layer cloud-layer-near ambient-motion" viewBox="0 0 1600 400" preserveAspectRatio="none">
        <path d="M-120 230c146-88 302-69 424-15 108 48 225 59 355 10 130-49 281-47 401 2 127 52 240 52 391-14 90-40 183-26 268 17v120H-120Z" />
      </svg>

      <div class="haze haze-one ambient-motion"></div>
      <div class="haze haze-two ambient-motion"></div>

      <svg class="distant-islands" viewBox="0 0 1600 220" preserveAspectRatio="none">
        <path class="island-far" d="M0 186c128-4 235-9 355-6 93 2 152-7 231-31 47-15 83-8 126 11 39 17 89 23 147 22 85-1 169-23 240-26 109-4 214 25 501 27v37H0Z" />
        <path class="island-mist" d="M0 197c217-17 315-12 476-6 142 5 236-13 354-7 160 9 308 0 486 5 107 4 200 8 284 7v24H0Z" />
      </svg>

      <svg class="main-island" viewBox="0 0 780 390">
        <defs>
          <filter id="island-texture" x="-8%" y="-8%" width="116%" height="116%">
            <feTurbulence type="fractalNoise" baseFrequency="0.009 0.025" numOctaves="2" seed="18" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" />
          </filter>
          <linearGradient id="cliff-light" x1="0" y1="0" x2="0.8" y2="1">
            <stop offset="0" class="cliff-stop-one" />
            <stop offset="0.55" class="cliff-stop-two" />
            <stop offset="1" class="cliff-stop-three" />
          </linearGradient>
          <linearGradient id="grass-light" x1="0" y1="0" x2="1" y2="0.8">
            <stop offset="0" class="grass-stop-one" />
            <stop offset="1" class="grass-stop-two" />
          </linearGradient>
        </defs>

        <g filter="url(#island-texture)">
          <path class="island-back" d="M100 248c57-54 117-91 188-103 66-11 111-52 170-48 63 5 90 62 136 78 59 20 99 26 134 68l21 79H53Z" />
          <path fill="url(#cliff-light)" d="M59 264c79-17 121-62 198-72 61-8 114 2 175-24 47-20 91-17 130 14 37 30 89 28 150 72l29 96H38Z" />
          <path class="cliff-shadow" d="M153 262c56 0 88-31 131-32 41-2 67 22 111 13 52-11 62-42 112-33 42 7 49 39 109 41 31 1 58 14 91 36l27 63H87c23-27 30-63 66-88Z" />
          <path class="cliff-ridge" d="M89 304c81-24 140-9 211-27 61-15 88 4 141-8 63-14 96-4 147 12 47 15 85 15 133 34l12 35H67Z" />
          <path fill="url(#grass-light)" d="M78 263c48-15 90-66 164-76 65-9 112 1 174-27 42-19 83-12 122 12 40 25 92 40 152 70-57-13-104-7-145-28-39-19-72-20-112-4-59 23-103 11-162 18-84 11-106 45-193 57Z" />
          <path class="shore-rock" d="M49 335c92-24 128-17 211-3 82 14 132 1 220-10 83-10 166-4 257 18l9 22H34Z" />
        </g>

        <g class="temple">
          <path class="temple-back" d="M408 150h105l17 67H391Z" />
          <path class="temple-roof" d="m387 151 70-41 73 42-8 13H397Z" />
          <path class="temple-roof-mark" d="m429 143 29-18 29 18Z" />
          <path class="temple-wall" d="M404 160h108v67H404Z" />
          <path class="temple-column" d="M415 162h13v65h-13Zm35 0h14v65h-14Zm36 0h13v65h-13Z" />
          <path class="temple-door" d="M450 184h14v43h-14Z" />
          <path class="temple-light" d="M452 186h10v35h-10Z" />
          <path class="temple-line" d="M397 174h124M397 220h124" />
        </g>

        <g class="trees tree-back">
          <path d="m196 195-14-48 27 40-4-59 19 57 12-46 3 55Z" />
          <path d="m572 213-6-58 22 46 9-59 9 58 27-46-17 64Z" />
          <path d="m326 181-10-47 24 36 5-55 11 51 23-38-13 53Z" />
        </g>
        <g class="trees tree-front">
          <path d="m137 263-17-61 31 47 2-69 16 65 28-48-17 66Z" />
          <path d="m282 239-12-58 27 45 6-63 12 59 27-45-15 63Z" />
          <path d="m547 258-13-69 29 54 8-72 12 68 33-51-21 71Z" />
          <path d="m641 278-15-62 31 47 3-68 15 64 29-43-17 63Z" />
        </g>
        <g class="tree-trunks">
          <path d="M158 247v26m-1-25-13-16m15 17 16-18M304 225v23m0-22-12-13m13 13 14-15M570 241v24m1-22-15-17m16 18 16-20M664 263v21m0-21-12-14m13 14 13-15" />
        </g>
      </svg>

      <div class="sea">
        <div class="sea-depth"></div>
        <div class="light-path ambient-motion"></div>
        <svg class="wave-lines wave-lines-far ambient-motion" viewBox="0 0 1600 180" preserveAspectRatio="none">
          <path d="M-40 41c113-16 185 14 287 1 94-12 169-4 257 7 132 17 252-17 373-9 118 8 224 32 350 13 124-18 245-6 413 1" />
          <path d="M-20 92c105-13 199 14 296 2 137-17 204 13 336 6 123-6 211-26 324-9 119 19 227 10 350-2 108-10 197 9 334 8" />
          <path d="M34 137c118-13 216 11 322 0 127-14 241 16 352 4 116-12 212-20 329-2 132 20 236-11 355-4 77 4 137 11 208 7" />
        </svg>
        <svg class="wave-lines wave-lines-near ambient-motion" viewBox="0 0 1600 260" preserveAspectRatio="none">
          <path d="M-60 71c184-31 269 27 442 4 151-20 260 4 418 17 180 14 300-43 472-22 124 15 224 18 388-8" />
          <path d="M-30 177c142-23 274 28 423 3 157-26 282 26 435 3 178-26 282-5 423 9 138 14 248-16 409-7" />
          <path d="M30 236c170-28 270 14 430-3 151-17 267 29 410 5 167-28 271 5 422 8 135 2 227-12 335-8" />
        </svg>
      </div>

      <svg class="shore" viewBox="0 0 650 260" preserveAspectRatio="none">
        <path class="shore-sand-shadow" d="M-50 253C74 152 163 165 244 182c83 18 154 21 242-4 75-21 119-13 184 11v71H-50Z" />
        <path class="shore-sand" d="M-70 253c125-79 230-66 314-46 86 20 149 17 237-5 76-20 127-11 190 13v45H-70Z" />
        <path class="shore-foam" d="M-44 232c134-53 212-43 298-22 92 23 150 20 238-2 69-17 116-10 170 6" />
      </svg>

      <svg class="birds ambient-motion" viewBox="0 0 90 32">
        <path d="M2 18c6-6 11-6 17 0 6-6 11-6 17 0M49 7c4-4 8-4 12 0 4-4 8-4 12 0" />
      </svg>

      <div class="scene-grain"></div>
      <div class="edge-vignette"></div>
    </div>

    <header class="ocean-header">
      <div class="ocean-brand">
        <img class="brand-logo" src={href("/logo/yuda-logo.png")} alt="" />
        <span class="brand-copy">Dazotikuy Shrine</span>
      </div>

      <div class="lang-switch" id="entrance-lang-switch">
        <button
          class="lang-switch-button"
          id="entrance-lang-button"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="entrance-lang-menu"
          aria-label="Change language"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.35" />
            <path d="M3.4 9.5h17.2M3.4 14.5h17.2" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
            <path d="M12 3a14.4 14.4 0 0 1 0 18 14.4 14.4 0 0 1 0-18Z" stroke="currentColor" stroke-width="1.25" />
          </svg>
        </button>

        <div class="lang-menu" id="entrance-lang-menu" role="menu" aria-label="Language" hidden>
          <button class="lang-option" type="button" role="menuitemradio" aria-checked="false" data-lang-option="zh">
            <span>繁體中文</span><span class="lang-check" aria-hidden="true">✓</span>
          </button>
          <button class="lang-option" type="button" role="menuitemradio" aria-checked="false" data-lang-option="en">
            <span>English</span><span class="lang-check" aria-hidden="true">✓</span>
          </button>
          <button class="lang-option" type="button" role="menuitemradio" aria-checked="false" data-lang-option="ja">
            <span>日本語</span><span class="lang-check" aria-hidden="true">✓</span>
          </button>
        </div>
      </div>
    </header>

    <button
      class="celestial-control"
      id="ocean-theme-switch"
      type="button"
      aria-label="Switch to dark theme"
    >
      <span class="celestial-glow" aria-hidden="true"></span>
      <span class="sun-disc" aria-hidden="true">
        <span class="sun-core"></span>
        <span class="sun-rays"></span>
      </span>
      <span class="moon-disc" aria-hidden="true">
        <span class="moon-crater moon-crater-one"></span>
        <span class="moon-crater moon-crater-two"></span>
      </span>
    </button>

    <main id="ocean-content">
      <section class="hero-copy" aria-labelledby="ocean-heading">
        <div class="hero-eyebrow ocean-reveal ocean-reveal-one">
          <span>Yuda's Channel</span>
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span>Game Wiki</span>
        </div>

        <h1 id="ocean-heading" class="hero-title ocean-reveal ocean-reveal-two">
          <span class="hero-title-prefix">Welcome to</span>
          <em>Dazotikuy Shrine</em>
        </h1>

        <p class="hero-support ocean-reveal ocean-reveal-three">
          Advanced game guides and mechanics for The Legend of Zelda, Super Smash Bros., and beyond.
        </p>

        <div class="hero-actions ocean-reveal ocean-reveal-four" aria-label="Entrance actions">
          <a class="hero-action hero-action-primary" href={wikiHomeUrl}>
            <span>Enter Shrine</span>
            <span class="action-icon" aria-hidden="true">
              <svg class="action-default" viewBox="0 0 24 24" fill="none">
                <path d="M6.5 17.5 17.5 6.5M9 6.5h8.5V15" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <img class="action-hover action-favicon" src={href("/favicon.svg")} alt="" />
            </span>
          </a>
          <a
            class="hero-action hero-action-secondary"
            href={SITE.youtube}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Visit Channel</span>
            <span class="action-icon" aria-hidden="true">
              <svg class="action-default" viewBox="0 0 24 24" fill="none">
                <path d="M6.5 12h11M13.5 8l4 4-4 4" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <svg class="action-hover action-youtube" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1c-1.9-.5-9.4-.5-9.4-.5s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.5 15.6V8.4l6.3 3.6-6.3 3.6Z" />
              </svg>
            </span>
          </a>
        </div>
      </section>
    </main>

    <footer class="ocean-footer ocean-reveal ocean-reveal-five">
      <p>© 2026 Yuhudaddy - Content Curated from Personal YouTube Channel</p>
    </footer>

    <style is:global>
      :root,
      :root[data-theme="light"] {
        color-scheme: light;
        --sky-top: oklch(84% 0.055 240);
        --sky-mid: oklch(88% 0.06 278);
        --sky-low: oklch(91% 0.065 38);
        --sky-horizon: oklch(94% 0.035 76);
        --cloud-far: oklch(97% 0.025 273 / 0.44);
        --cloud-near: oklch(98% 0.025 55 / 0.34);
        --haze: oklch(96% 0.035 67 / 0.52);
        --island-far: oklch(57% 0.045 271);
        --island-mist: oklch(70% 0.035 243);
        --island-back: oklch(41% 0.052 267);
        --cliff-one: oklch(55% 0.052 278);
        --cliff-two: oklch(45% 0.055 258);
        --cliff-three: oklch(34% 0.058 247);
        --cliff-shadow: oklch(32% 0.055 248);
        --cliff-ridge: oklch(38% 0.06 260);
        --grass-one: oklch(49% 0.09 155);
