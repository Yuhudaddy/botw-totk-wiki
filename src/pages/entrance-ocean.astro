        --shore-rock: oklch(29% 0.05 248);
        --tree-back: oklch(30% 0.064 183);
        --tree-front: oklch(23% 0.068 173);
        --tree-trunk: oklch(28% 0.055 55);
        --temple-wall: oklch(66% 0.035 72);
        --temple-shadow: oklch(38% 0.04 258);
        --temple-roof: oklch(30% 0.045 253);
        --temple-line: oklch(84% 0.025 78 / 0.5);
        --temple-light: oklch(73% 0.11 69 / 0);
        --sea-top: oklch(61% 0.075 212);
        --sea-mid: oklch(47% 0.085 208);
        --sea-bottom: oklch(32% 0.075 212);
        --wave: oklch(88% 0.038 204 / 0.36);
        --wave-near: oklch(90% 0.03 187 / 0.24);
        --reflection: oklch(98% 0.045 84 / 0.75);
        --sand: oklch(76% 0.075 72);
        --sand-shadow: oklch(61% 0.08 66);
        --foam: oklch(96% 0.025 83 / 0.68);
        --text: oklch(24% 0.047 234);
        --text-soft: oklch(35% 0.055 227);
        --text-faint: oklch(43% 0.05 224);
        --hairline: oklch(44% 0.074 210 / 0.44);
        --glass: oklch(96% 0.025 210 / 0.29);
        --glass-strong: oklch(94% 0.035 199 / 0.44);
        --glass-edge: oklch(98% 0.025 160 / 0.66);
        --glass-shadow: oklch(25% 0.05 230 / 0.12);
        --focus: oklch(39% 0.12 208);
        --menu-bg: oklch(94% 0.028 218 / 0.94);
        --menu-active: oklch(84% 0.045 204);
        --title-gradient-start: oklch(22% 0.06 239);
        --title-gradient-mid: oklch(34% 0.075 211);
        --title-gradient-end: oklch(31% 0.055 282);
        --title-glow: oklch(94% 0.028 225 / 0.14);
        --sun-core: oklch(98% 0.035 84);
        --sun-edge: oklch(93% 0.065 75);
        --sun-glow: oklch(97% 0.07 75 / 0.38);
        --moon-core: oklch(96% 0.012 95);
        --moon-edge: oklch(86% 0.025 86);
        --moon-glow: oklch(92% 0.01 240 / 0.24);
        --theme-meta: #dce5ec;
        --scene-x: 0px;
        --scene-y: 0px;
        --celestial-x: 94%;
        --celestial-y: 63vh;
        --celestial-control-size: clamp(4rem, 5.8vw, 5.3rem);
        --sea-start: 70.2%;
        --reflection-width: clamp(5.5rem, 9vw, 10rem);
      }

      :root[data-theme="dark"] {
        color-scheme: dark;
        --celestial-x: 93%;
        --sky-top: oklch(21% 0.052 218);
        --sky-mid: oklch(27% 0.06 214);
        --sky-low: oklch(32% 0.058 209);
        --sky-horizon: oklch(35% 0.052 205);
        --cloud-far: oklch(70% 0.018 211 / 0.14);
        --cloud-near: oklch(76% 0.016 205 / 0.12);
        --haze: oklch(64% 0.025 205 / 0.18);
        --island-far: oklch(29% 0.052 265);
        --island-mist: oklch(34% 0.053 251);
        --island-back: oklch(18% 0.052 254);
        --cliff-one: oklch(28% 0.055 271);
        --cliff-two: oklch(22% 0.052 257);
        --cliff-three: oklch(15% 0.043 244);
        --cliff-shadow: oklch(13% 0.038 240);
        --cliff-ridge: oklch(19% 0.05 259);
        --grass-one: oklch(28% 0.062 177);
        --grass-two: oklch(20% 0.052 187);
        --shore-rock: oklch(12% 0.035 241);
        --tree-back: oklch(18% 0.052 184);
        --tree-front: oklch(12% 0.046 179);
        --tree-trunk: oklch(16% 0.035 55);
        --temple-wall: oklch(37% 0.042 265);
        --temple-shadow: oklch(18% 0.04 257);
        --temple-roof: oklch(13% 0.037 248);
        --temple-line: oklch(69% 0.055 251 / 0.34);
        --temple-light: oklch(80% 0.14 75 / 0.72);
        --sea-top: oklch(35% 0.068 202);
        --sea-mid: oklch(27% 0.061 204);
        --sea-bottom: oklch(16% 0.046 207);
        --wave: oklch(76% 0.046 198 / 0.24);
        --wave-near: oklch(70% 0.045 194 / 0.2);
        --reflection: oklch(90% 0.028 205 / 0.62);
        --sand: oklch(36% 0.058 65);
        --sand-shadow: oklch(23% 0.052 58);
        --foam: oklch(80% 0.04 232 / 0.42);
        --text: oklch(94% 0.025 226);
        --text-soft: oklch(84% 0.035 231);
        --text-faint: oklch(72% 0.045 235);
        --hairline: oklch(76% 0.07 229 / 0.42);
        --glass: oklch(27% 0.046 211 / 0.42);
        --glass-strong: oklch(36% 0.052 207 / 0.52);
        --glass-edge: oklch(80% 0.045 202 / 0.45);
        --glass-shadow: oklch(8% 0.025 216 / 0.28);
        --focus: oklch(81% 0.12 205);
        --menu-bg: oklch(21% 0.047 214 / 0.94);
        --menu-active: oklch(31% 0.058 205);
        --title-gradient-start: oklch(96% 0.012 232);
        --title-gradient-mid: oklch(84% 0.025 221);
        --title-gradient-end: oklch(94% 0.015 88);
        --title-glow: oklch(89% 0.018 235 / 0.18);
        --theme-meta: #0d3d4b;
        --celestial-y: clamp(10.75rem, 23.6vh, 13.25rem);
        --reflection-width: clamp(6.25rem, 10.5vw, 11.5rem);
      }

      .ocean-html {
        min-width: 320px;
        min-height: 100%;
        overflow: hidden;
        background: var(--sky-top);
      }

      .ocean-page {
        position: relative;
        display: grid;
        min-width: 320px;
        min-height: 100svh;
        margin: 0;
        overflow: hidden;
        grid-template-rows: auto 1fr auto;
        background: var(--sky-top);
        color: var(--text);
        font-family: "Noto Sans TC", "Noto Serif JP", sans-serif;
        font-size: 1rem;
        font-kerning: normal;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .ocean-page *,
      .ocean-page *::before,
      .ocean-page *::after {
        box-sizing: border-box;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      button {
        font: inherit;
      }

      .skip-link {
        position: fixed;
        z-index: 100;
        top: 10px;
        left: 10px;
        padding: 10px 15px;
        border: 1px solid var(--glass-edge);
        background: var(--menu-bg);
        color: var(--text);
        text-decoration: none;
        transform: translateY(-160%);
        transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .scene {
        position: fixed;
        z-index: 0;
        inset: 0;
        overflow: hidden;
        background: var(--sky-top);
        pointer-events: none;
        isolation: isolate;
      }

      .scene-art,
      .scene-art img,
      .scene-lighting {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .scene-art {
        display: block;
        overflow: hidden;
      }

      .scene-art-day { z-index: 0; }

      .scene-art-night {
        z-index: 1;
        opacity: 0;
        transition: opacity 900ms cubic-bezier(0.65, 0, 0.35, 1);
      }

      .scene-art img {
        object-fit: cover;
        object-position: right center;
        transition:
          filter 900ms cubic-bezier(0.65, 0, 0.35, 1),
          transform 1200ms cubic-bezier(0.65, 0, 0.35, 1);
      }

      .scene-art-day img {
        filter: brightness(0.99) saturate(0.96) contrast(0.98);
        transform: scale(1.002);
      }

      .scene-art-night img {
        filter: brightness(1.06) saturate(0.9) contrast(0.98);
        transform: scale(1.002);
      }

      :root[data-theme="dark"] .scene-art-day img {
        filter: brightness(0.58) saturate(0.72) contrast(1.04) hue-rotate(-7deg);
        transform: scale(1.006);
      }

      :root[data-theme="dark"] .scene-art-night { opacity: 1; }

      .scene-lighting {
        z-index: 2;
        pointer-events: none;
        transition: opacity 900ms cubic-bezier(0.65, 0, 0.35, 1);
      }

      .scene-lighting-day {
        background:
          radial-gradient(circle at var(--celestial-x) var(--celestial-y), oklch(98% 0.042 70 / 0.18) 0, oklch(97% 0.038 69 / 0.085) 8%, transparent 17%),
          linear-gradient(90deg, oklch(92% 0.025 264 / 0.08) 0, transparent 48%);
        mix-blend-mode: screen;
        opacity: 1;
      }

      .scene-lighting-night {
        background: linear-gradient(
          180deg,
          oklch(20% 0.06 219 / 0.96) 0%,
          oklch(27% 0.07 214 / 0.92) 48%,
          oklch(33% 0.065 207 / 0.88) 69%,
          oklch(18% 0.052 204 / 0.94) 100%
        );
        mix-blend-mode: color;
        opacity: 0;
      }

      .scene-night-depth {
        background:
          radial-gradient(ellipse at var(--celestial-x) var(--celestial-y), transparent 0 12%, oklch(8% 0.035 218 / 0.06) 34%, oklch(7% 0.038 213 / 0.22) 76%),
          linear-gradient(180deg, oklch(7% 0.04 221 / 0.12) 0%, transparent 42%, oklch(6% 0.04 202 / 0.46) 100%),
          linear-gradient(90deg, oklch(6% 0.04 218 / 0.2), transparent 55%);
        mix-blend-mode: multiply;
        opacity: 0;
      }

      .scene-night-moonlight {
        background:
          radial-gradient(circle at var(--celestial-x) var(--celestial-y), oklch(98% 0.006 210 / 0.25) 0, oklch(89% 0.014 207 / 0.11) 8%, transparent 19%),
          radial-gradient(ellipse at var(--celestial-x) var(--celestial-y), oklch(92% 0.012 208 / 0.11) 0, transparent 29%),
          radial-gradient(ellipse at var(--celestial-x) var(--sea-start), oklch(92% 0.014 202 / 0.13) 0, oklch(72% 0.03 200 / 0.055) 9%, transparent 20%);
        mix-blend-mode: screen;
        opacity: 0;
      }

      :root[data-theme="dark"] .scene-lighting-day { opacity: 0; }
      :root[data-theme="dark"] .scene-lighting-night { opacity: 0.18; }
      :root[data-theme="dark"] .scene-night-depth { opacity: 0.28; }
      :root[data-theme="dark"] .scene-night-moonlight { opacity: 0.82; }

      /* The former vector environment remains as a structural fallback in the
         document, while the painterly game-environment art provides the scene. */
      .sky,
      .cloud-layer,
      .haze,
      .distant-islands,
      .main-island,
      .shore {
        display: none;
      }

      .sky {
        position: absolute;
        inset: 0 0 31.5%;
        background:
          radial-gradient(circle at var(--celestial-x) var(--celestial-y), var(--sun-glow) 0, transparent 17%),
          linear-gradient(to bottom, var(--sky-top) 0, var(--sky-mid) 42%, var(--sky-low) 75%, var(--sky-horizon) 100%);
      }

      .sky,
      .stars,
      .cloud-layer,
      .haze,
      .distant-islands path,
      .main-island path,
      .main-island stop,
      .sea,
      .sea-depth,
      .light-path,
      .wave-lines path,
      .shore path,
      .edge-vignette,
      .celestial-control,
      .hero-action,
      .lang-switch-button,
      .lang-menu {
        transition-duration: 900ms;
        transition-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
      }

      .sky,
      .haze,
      .sea,
      .sea-depth,
      .light-path,
      .edge-vignette,
      .hero-action,
      .lang-switch-button,
      .lang-menu {
        transition-property: background-color, background-image, border-color, color, opacity, box-shadow;
      }

      .stars {
        position: absolute;
        z-index: 2;
        inset: 0 0 30%;
        opacity: 0;
        transition-property: opacity;
      }

      .stars-far {
        background-image:
          radial-gradient(circle at 9% 16%, oklch(94% 0.02 245) 0 1px, transparent 1.4px),
          radial-gradient(circle at 20% 32%, oklch(92% 0.04 238) 0 1px, transparent 1.4px),
          radial-gradient(circle at 34% 12%, oklch(96% 0.025 246) 0 1px, transparent 1.3px),
          radial-gradient(circle at 48% 28%, oklch(92% 0.04 232) 0 1px, transparent 1.3px),
          radial-gradient(circle at 61% 9%, oklch(96% 0.025 246) 0 1px, transparent 1.3px),
          radial-gradient(circle at 73% 36%, oklch(93% 0.035 239) 0 1px, transparent 1.3px),
          radial-gradient(circle at 91% 12%, oklch(96% 0.025 246) 0 1px, transparent 1.3px);
      }

      .stars-near {
        background-image:
          radial-gradient(circle at 14% 43%, oklch(97% 0.025 245) 0 1.4px, transparent 1.8px),
          radial-gradient(circle at 30% 24%, oklch(94% 0.04 240) 0 1.2px, transparent 1.7px),
          radial-gradient(circle at 55% 18%, oklch(98% 0.02 240) 0 1.3px, transparent 1.8px),
          radial-gradient(circle at 67% 46%, oklch(94% 0.04 240) 0 1.3px, transparent 1.8px),
          radial-gradient(circle at 87% 31%, oklch(98% 0.02 240) 0 1.5px, transparent 2px);
        animation: none;
      }

      :root[data-theme="dark"] .stars {
        opacity: 0.72;
      }

      :root[data-theme="dark"] .stars-near {
        animation: star-breathe 9s ease-in-out infinite alternate;
      }

      .cloud-layer {
        position: absolute;
        width: 113%;
        left: -8%;
        fill: var(--cloud-far);
        transition-property: fill, opacity;
      }

      .cloud-layer-far {
        top: 8%;
        height: 39%;
        animation: cloud-drift 54s ease-in-out infinite alternate;
      }

      .cloud-layer-near {
        top: 24%;
        left: -12%;
        width: 120%;
        height: 38%;
        fill: var(--cloud-near);
        opacity: 0.62;
        animation: cloud-drift-reverse 42s ease-in-out infinite alternate;
      }

      .haze {
        position: absolute;
        border-radius: 50%;
        background: var(--haze);
        opacity: 0.34;
      }

      .haze-one {
        top: 46%;
        right: -8%;
        width: 58%;
        height: 24%;
        animation: haze-drift 28s ease-in-out infinite alternate;
      }

      .haze-two {
        top: 56%;
        left: -15%;
        width: 62%;
        height: 16%;
        opacity: 0.21;
        animation: haze-drift 36s ease-in-out infinite alternate-reverse;
      }

      .distant-islands {
        position: absolute;
        top: calc(68% - 7.4rem);
        left: 0;
        width: 100%;
        height: 8rem;
      }

      .island-far {
        fill: var(--island-far);
        opacity: 0.55;
        transition-property: fill, opacity;
      }

      .island-mist {
        fill: var(--island-mist);
        opacity: 0.72;
        transition-property: fill, opacity;
      }

      .main-island {
        position: absolute;
        right: -1.5%;
        bottom: 27.5%;
        width: clamp(35rem, 49vw, 57rem);
        height: auto;
        transform: translate3d(var(--scene-x), var(--scene-y), 0);
      }

      .main-island path,
      .main-island stop {
        transition-property: fill, stroke, stop-color, opacity;
      }

      .island-back { fill: var(--island-back); }
      .cliff-stop-one { stop-color: var(--cliff-one); }
      .cliff-stop-two { stop-color: var(--cliff-two); }
      .cliff-stop-three { stop-color: var(--cliff-three); }
      .grass-stop-one { stop-color: var(--grass-one); }
      .grass-stop-two { stop-color: var(--grass-two); }
      .cliff-shadow { fill: var(--cliff-shadow); opacity: 0.86; }
      .cliff-ridge { fill: var(--cliff-ridge); opacity: 0.73; }
      .shore-rock { fill: var(--shore-rock); }
      .temple-back { fill: var(--temple-shadow); }
      .temple-roof { fill: var(--temple-roof); }
      .temple-roof-mark { fill: var(--temple-wall); opacity: 0.5; }
      .temple-wall { fill: var(--temple-wall); }
      .temple-column { fill: var(--temple-shadow); opacity: 0.68; }
      .temple-door { fill: var(--temple-shadow); }
      .temple-light { fill: var(--temple-light); }
      .temple-line { fill: none; stroke: var(--temple-line); stroke-width: 2; }
      .tree-back { fill: var(--tree-back); opacity: 0.86; }
      .tree-front { fill: var(--tree-front); }
      .tree-trunks { fill: none; stroke: var(--tree-trunk); stroke-width: 5; stroke-linecap: round; }

      .sea {
        position: absolute;
        z-index: 2;
        inset: var(--sea-start) 0 0;
        overflow: hidden;
        background: transparent;
        opacity: 0.16;
      }

      .sea::before {
        position: absolute;
        content: "";
        inset: 0;
        border-top: 1px solid color-mix(in oklch, var(--wave) 28%, transparent);
        background:
          repeating-radial-gradient(ellipse at 42% 7%, transparent 0 19px, color-mix(in oklch, var(--wave) 20%, transparent) 20px, transparent 22px 48px);
        opacity: 0.22;
      }

      .sea-depth {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(ellipse at var(--celestial-x) 0%, color-mix(in oklch, var(--reflection) 15%, transparent) 0, transparent 14%),
          linear-gradient(to bottom, transparent 0, color-mix(in oklch, var(--sea-bottom) 12%, transparent) 100%);
      }

      .light-path {
        position: absolute;
        top: -6%;
        left: var(--celestial-x);
        width: var(--reflection-width);
        height: 112%;
        background:
          repeating-linear-gradient(180deg, transparent 0 0.65rem, color-mix(in oklch, var(--reflection) 32%, transparent) 0.72rem, transparent 0.88rem 1.45rem),
          radial-gradient(ellipse at 50% 3%, var(--reflection), transparent 70%);
        clip-path: polygon(45% 0, 55% 0, 94% 100%, 6% 100%);
        -webkit-mask-image: linear-gradient(to bottom, #000 0, rgb(0 0 0 / 0.66) 44%, transparent 94%);
        mask-image: linear-gradient(to bottom, #000 0, rgb(0 0 0 / 0.66) 44%, transparent 94%);
        opacity: 0.18;
        mix-blend-mode: screen;
        transform: translateX(-50%);
        animation: water-light 14s ease-in-out infinite alternate;
      }

      :root[data-theme="dark"] .sea {
        opacity: 0.2;
      }

      :root[data-theme="dark"] .light-path {
        background:
          repeating-linear-gradient(180deg, transparent 0 0.72rem, oklch(94% 0.006 240 / 0.11) 0.8rem, transparent 0.96rem 1.62rem),
          radial-gradient(ellipse at 50% 3%, oklch(94% 0.006 240 / 0.26), oklch(72% 0.02 240 / 0.08) 28%, transparent 70%);
      }

      .wave-lines {
        position: absolute;
        left: -4%;
        width: 108%;
        fill: none;
        stroke-linecap: round;
      }

      .wave-lines path { transition-property: stroke; }

      .wave-lines-far {
        top: -3%;
        height: 47%;
        stroke: var(--wave);
        stroke-width: 1.4;
        opacity: 0.13;
        animation: sea-shift 15s ease-in-out infinite alternate;
      }

      .wave-lines-near {
        bottom: -4%;
        height: 76%;
        stroke: var(--wave-near);
        stroke-width: 2.1;
        opacity: 0.08;
        animation: sea-shift-reverse 12s ease-in-out infinite alternate;
      }

      .shore {
        position: absolute;
        z-index: 2;
        bottom: -2%;
        left: -4%;
        width: min(38rem, 39vw);
        height: 27%;
      }

      .shore path { transition-property: fill, stroke; }
      .shore-sand-shadow { fill: var(--sand-shadow); }
      .shore-sand { fill: var(--sand); }
      .shore-foam { fill: none; stroke: var(--foam); stroke-width: 6; stroke-linecap: round; }

      .birds {
        position: absolute;
        top: 26%;
        left: -7rem;
        width: 5.5rem;
        fill: none;
        stroke: var(--text-faint);
        stroke-width: 1.2;
        stroke-linecap: round;
        opacity: 0.48;
        animation: birds-cross 38s linear infinite;
        transition: opacity 520ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      :root[data-theme="dark"] .birds {
        opacity: 0;
        animation: none;
      }

      .scene-grain {
        position: absolute;
        z-index: 4;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.78' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.3'/%3E%3C/svg%3E");
        opacity: 0.026;
        mix-blend-mode: soft-light;
      }

      .edge-vignette {
        position: absolute;
        z-index: 3;
        inset: 0;
        background:
          linear-gradient(90deg, color-mix(in oklch, var(--sky-top) 18%, transparent) 0, transparent 47%),
          linear-gradient(to bottom, transparent 68%, color-mix(in oklch, var(--sea-bottom) 18%, transparent) 100%);
      }

      .ocean-header {
        position: relative;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding:
          max(1.1rem, env(safe-area-inset-top))
          max(1.15rem, env(safe-area-inset-right))
          0
          max(1.15rem, env(safe-area-inset-left));
        pointer-events: none;
      }

      .ocean-brand,
      .lang-switch {
        pointer-events: auto;
      }

      .ocean-brand {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 0.7rem;
        color: var(--text);
      }

      .brand-logo {
        width: clamp(2rem, 4.6vw, 2.75rem);
        height: clamp(2rem, 4.6vw, 2.75rem);
        object-fit: contain;
        filter: drop-shadow(0 2px 7px color-mix(in oklch, var(--glass-shadow) 65%, transparent));
      }

      .brand-copy {
        overflow: hidden;
        font-family: "Fraunces", "Noto Serif TC", "Noto Serif JP", serif;
        font-size: clamp(0.72rem, 1.2vw, 0.88rem);
        font-variation-settings: "opsz" 48;
        letter-spacing: 0.045em;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .lang-switch { position: relative; }

      .lang-switch-button {
        position: relative;
        display: grid;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0;
        place-items: center;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        transition: color 200ms cubic-bezier(0.25, 1, 0.5, 1);
      }

      .lang-switch-button::after {
        position: absolute;
        inset: 0.22rem;
        z-index: 0;
        content: "";
        border: 1px solid color-mix(in oklch, var(--glass-edge) 70%, transparent);
        border-radius: 50%;
        background: color-mix(in oklch, var(--glass) 60%, transparent);
        box-shadow: inset 0 1px 0 color-mix(in oklch, var(--glass-edge) 55%, transparent);
        opacity: 0;
        pointer-events: none;
        transform: scale(0.72);
        transition:
          opacity 220ms cubic-bezier(0.25, 1, 0.5, 1),
          transform 220ms cubic-bezier(0.25, 1, 0.5, 1),
          background-color 900ms cubic-bezier(0.65, 0, 0.35, 1),
          border-color 900ms cubic-bezier(0.65, 0, 0.35, 1);
      }

      .lang-switch-button svg {
        position: relative;
        z-index: 1;
        width: 1.15rem;
        height: 1.15rem;
      }

      .lang-switch-button[aria-expanded="true"]::after {
        opacity: 1;
        transform: scale(1);
      }

      .lang-switch-button:focus-visible,
      .lang-option:focus-visible,
      .hero-action:focus-visible,
      .celestial-control:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 4px;
      }

      .lang-menu {
        position: absolute;
        top: calc(100% + 0.65rem);
        right: 0;
        display: grid;
        width: 10.6rem;
        padding: 0.4rem;
        border: 1px solid var(--glass-edge);
        background: var(--menu-bg);
        box-shadow: 0 1rem 2.8rem var(--glass-shadow);
        clip-path: polygon(0.55rem 0, 100% 0, 100% calc(100% - 0.55rem), calc(100% - 0.55rem) 100%, 0 100%, 0 0.55rem);
        transform-origin: top right;
        animation: menu-enter 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      .lang-menu[hidden] { display: none !important; }

      .lang-option {
        display: flex;
        min-height: 2.65rem;
        align-items: center;
        justify-content: space-between;
        padding: 0 0.75rem;
        border: 0;
        background: transparent;
        color: var(--text-soft);
        font-size: 0.82rem;
        letter-spacing: 0.01em;
        text-align: left;
        cursor: pointer;
        transition: background-color 160ms cubic-bezier(0.25, 1, 0.5, 1), color 160ms;
      }

      .lang-option[aria-checked="true"] {
        background: var(--menu-active);
        color: var(--text);
      }

      .lang-check { opacity: 0; }
      .lang-option[aria-checked="true"] .lang-check { opacity: 1; }

      .celestial-control {
        position: fixed;
        z-index: 9;
        top: var(--celestial-y);
        left: var(--celestial-x);
        width: var(--celestial-control-size);
        height: var(--celestial-control-size);
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        cursor: pointer;
        transform: translate(-50%, -50%);
        transition-property: opacity;
      }

      .celestial-control.is-switching {
        pointer-events: none;
      }

      .celestial-control.is-relocating {
        pointer-events: none;
      }

      .celestial-glow,
      .sun-disc,
      .moon-disc {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        transition: opacity 650ms cubic-bezier(0.65, 0, 0.35, 1), background 900ms cubic-bezier(0.65, 0, 0.35, 1), box-shadow 900ms cubic-bezier(0.65, 0, 0.35, 1);
      }

      .celestial-control.is-switching .celestial-glow,
      .celestial-control.is-switching .sun-disc,
      .celestial-control.is-switching .moon-disc {
        opacity: 0;
        transition-duration: 260ms;
      }

      .celestial-glow {
        inset: -82%;
        background: radial-gradient(circle, var(--sun-glow), transparent 70%);
        opacity: 0.3;
        filter: blur(0.22rem);
        mix-blend-mode: screen;
        animation: celestial-breathe 8s ease-in-out infinite alternate;
      }

      .sun-disc {
        inset: 32%;
        opacity: 1;
      }

      .sun-core {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background:
          radial-gradient(circle at 38% 32%, oklch(100% 0.008 76 / 0.74) 0 10%, transparent 36%),
          radial-gradient(circle at 42% 38%, oklch(100% 0.012 76), var(--sun-core) 58%, var(--sun-edge) 100%);
        box-shadow:
          0 0 0.65rem color-mix(in oklch, var(--sun-core) 46%, transparent),
          0 0 1.8rem color-mix(in oklch, var(--sun-glow) 68%, transparent);
      }

      .sun-rays {
        display: none;
      }

      .moon-disc {
        inset: 31%;
        opacity: 0;
        transform: rotate(-12deg) scale(1);
        background: radial-gradient(circle at 30% 36%, oklch(98% 0.006 95), var(--moon-core) 58%, var(--moon-edge) 100%);
        filter:
          drop-shadow(0 0 0.45rem color-mix(in oklch, var(--moon-core) 42%, transparent))
          drop-shadow(0 0 1.15rem var(--moon-glow));
        -webkit-mask-image: radial-gradient(circle at 73% 37%, transparent 0 51%, #000 52%);
        mask-image: radial-gradient(circle at 73% 37%, transparent 0 51%, #000 52%);
      }

      .moon-disc::after {
        display: none;
      }

      .moon-crater {
        display: none;
      }

      .moon-crater-one { left: 23%; top: 51%; width: 17%; height: 17%; }
      .moon-crater-two { left: 44%; top: 72%; width: 10%; height: 10%; }

      :root[data-theme="dark"] .celestial-glow {
        background: radial-gradient(circle, var(--moon-glow), transparent 70%);
        opacity: 0.28;
      }

      :root[data-theme="dark"] .sun-disc {
        opacity: 0;
      }

      :root[data-theme="dark"] .moon-disc {
        opacity: 1;
      }

      #ocean-content {
