---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SheikahField from "../components/SheikahField.astro";
import { SITE } from "../data/site";
import type { Lang } from "../data/ui-strings";

interface Props {
  title?: string;
  description?: string;
  /** 導覽列 active 判斷用：home / botw / totk / videos */
  active?: string;
  /** 頁面語言；日文版攻略頁傳 "ja"，其餘頁面沿用預設中文 */
  lang?: Lang;
  /** 這一頁對應到另一語言的路徑（不含語言前綴），例如 "/types/totk-11"。
   *  沒給就代表這一頁還沒有另一語言版本，語言切換鈕不會顯示。 */
  altPath?: string;
}

const { title, description, active = "", lang = "zh", altPath } = Astro.props;
// 站名／預設說明目前只有曠野之息、王國之淚有日文版（見 site.ts），
// 其餘遊戲的頁面仍會沿用中文站名，等資料層翻譯補齊後再全面日文化。
const siteTitle = lang === "ja" ? SITE.titleJa : SITE.title;
const siteDescription = lang === "ja" ? SITE.descriptionJa : SITE.description;
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const resolvedDescription = description ?? siteDescription;
// lang 屬性要跟著頁面語言走，否則螢幕閱讀器與搜尋引擎會把日文頁誤判為中文
const htmlLang = lang === "ja" ? "ja" : "zh-Hant-TW";

// 社群分享卡片與 canonical 都必須是「絕對網址」——Discord／Line／X 抓不到
// 相對路徑，Google 也需要絕對網址才能正確判斷正規版本。
// Astro.site 是 astro.config.mjs 的 site 欄位，Astro.url.pathname 已含 base。
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(`${import.meta.env.BASE_URL}/og-image.jpg`.replace(/\/{2,}/g, "/"), Astro.site).href;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} type="image/svg+xml" />
    {/* SVG favicon 在部分平台（iOS 加到主畫面、舊版 Safari）吃不到，補一張 PNG 備援 */}
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/apple-touch-icon.png`} />
    <title>{fullTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : "zh_TW"} />
    {/* X／Twitter 不吃 og:image 的大圖版面，要另外指定 card 型別才會顯示大圖 */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:wght@400;500;600&family=Noto+Serif+TC:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {/* 首屏前套用主題，避免閃爍 */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("wiki-theme");
          var preferred = window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
          var theme = saved || preferred;
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg text-text">
    <SheikahField />
    <Header active={active} lang={lang} altPath={altPath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
