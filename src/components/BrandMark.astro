---
import { href } from "../lib/url";

interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<picture>
  <source srcset={href("/logo/yuda-logo.webp")} type="image/webp" />
  <img
    src={href("/logo/yuda-logo.png")}
    alt="Yuda"
    loading="lazy"
    style={`width:${size}px;height:${size}px;`}
    class="rounded-[5px]"
  />
</picture>
