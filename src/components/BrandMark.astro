---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<picture>
  <source srcset="/botw-totk-wiki/logo/yuda-logo.webp" type="image/webp" />
  <img
    src="/botw-totk-wiki/logo/yuda-logo.png"
    alt="Yuda"
    loading="lazy"
    style={`width:${size}px;height:${size}px;`}
    class="rounded-lg"
  />
</picture>
