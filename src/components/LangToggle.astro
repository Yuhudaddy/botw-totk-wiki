---
// 中／日語言切換鈕。樣式與 ThemeToggle、SupportButton 一致（同一排的圓角方鈕）。
//
// 運作方式：日文版網址是中文版加上 /ja 前綴
//   中文 /types/totk-11
//   日文 /ja/types/totk-11
// 點擊時就地增刪網址開頭的 /ja，讓使用者留在同一頁、只換語言。
//
// 按鈕由伺服器端算好目標網址（data-target），不在瀏覽器端拼字串——
// 頁面知道自己有沒有日文版，瀏覽器不知道。沒有日文版的頁面不會渲染這顆按鈕，
// 也就不可能發生「按下去 404」。
import { uiStrings, type Lang } from "../data/ui-strings";
import { href } from "../lib/url";

interface Props {
  lang?: Lang;
  /** 這一頁對應到另一語言的路徑（不含語言前綴與 base），例如 "/types/totk-11"。
   *  沒給就代表這一頁還沒有另一語言版本，按鈕不顯示。 */
  altPath?: string;
}
const { lang = "zh", altPath } = Astro.props;
const t = uiStrings[lang];
const targetLang: Lang = lang === "zh" ? "ja" : "zh";
const target = altPath ? href(altPath, targetLang) : null;
---

{
  target && (
    <a
      id="lang-toggle"
      href={target}
      data-lang={lang}
      aria-label={t.langLabel}
      title={lang === "zh" ? t.langJa : t.langZh}
      class="ring-hover flex h-9 min-w-9 items-center justify-center rounded-[9px] bg-sand px-2 text-[13px] font-medium text-ink-2 no-underline shadow-[0_0_0_1px_var(--ring)] cursor-pointer"
    >
      {lang === "zh" ? "日" : "中"}
    </a>
  )
}
