---
// 語言切換：地球圖示鈕，點開彈窗顯示「另一個語言」（本站只有中／日兩版，
// 所以彈窗永遠只有一個選項——不是選單，是「還有這個語言」的提示）。
// 樣式與 SupportButton 的彈窗模式一致（同一顆 nav-icon-btn + 下拉彈窗）。
//
// 運作方式：日文版網址是中文版加上 /ja 前綴
//   中文 /types/totk-11
//   日文 /ja/types/totk-11
//
// 按鈕由伺服器端算好目標網址（data-target），不在瀏覽器端拼字串——
// 頁面知道自己有沒有日文版，瀏覽器不知道。沒有日文版的頁面不會渲染這顆按鈕，
// 也就不可能發生「按下去 404」。
//
// 彈窗裡的語言名稱刻意用該語言自己的寫法（中文頁顯示「日本語」、
// 日文頁顯示「繁体中国語」），而不是「日文」「中文」這種被目前語言
// 翻譯過的講法——讀者找語言選項時，看該語言自己的寫法比較直覺。
import { uiStrings, type Lang } from "../data/ui-strings";
import { href } from "../lib/url";

interface Props {
  lang?: Lang;
  /** 這一頁對應到另一語言的路徑（不含語言前綴與 base），例如 "/types/totk-11"。
   *  沒給就代表這一頁還沒有另一語言版本，按鈕不顯示。 */
  altPath?: string;
}
const { lang = "zh", altPath } = Astro.props;
const t = uiStrings[lang];
const targetLang: Lang = lang === "zh" ? "ja" : "zh";
const target = altPath ? href(altPath, targetLang) : null;
const targetLabel = lang === "zh" ? t.langJa : t.langZh;
---

{
  target && (
    <div class="relative">
      <button
        id="lang-toggle-btn"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label={t.langLabel}
        class="nav-icon-btn w-9"
      >
        <svg
          viewBox="0 0 24 24"
          width="17"
          height="17"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <ellipse cx="12" cy="12" rx="4" ry="9"></ellipse>
          <line x1="3" y1="12" x2="21" y2="12"></line>
        </svg>
      </button>

      <div
        id="lang-popover"
        role="dialog"
        aria-label={t.langLabel}
        class="lang-popover pointer-events-none absolute right-0 top-[calc(100%+10px)] z-50 w-[168px] rounded-[5px] border border-border-strong bg-surface p-1.5 opacity-0 shadow-lg transition-opacity duration-150"
      >
        <a
          href={target}
          class="ring-hover lang-option flex items-center rounded-[5px] px-3 py-2.5 text-[14px] text-ink no-underline"
        >
          {targetLabel}
        </a>
      </div>
    </div>
  )
}

<style>
  .lang-popover[data-open="true"] {
    pointer-events: auto;
    opacity: 1;
  }

  /* 沿用 .ring-hover 的旋轉漸層框當作 hover／鍵盤焦點指示，跟 Header
     自己的分頁鈕同一套語言——這顆彈窗本來就是從 Header 長出來的。
     .ring-hover 只處理 border/box-shadow，瀏覽器原生的 :focus 外框
     是另一個屬性，這裡額外關掉，避免開啟彈窗時 JS 把焦點移過來的
     瞬間跳出一圈突兀的系統藍框——鍵盤使用者仍會看到 :focus-visible
     觸發的漸層框，不是拿掉指示，只是換掉樣式。 */
  .lang-option {
    outline: none;
    transition: transform 160ms ease-out;
  }

  .lang-option:active {
    transform: scale(0.97);
  }
</style>

<script is:inline>
  (function () {
    var toggle = document.getElementById("lang-toggle-btn");
    var popover = document.getElementById("lang-popover");
    if (!toggle || !popover) return;
    var wrap = toggle.closest(".relative") || toggle.parentElement;

    // 關閉時把焦點還給觸發按鈕，避免鍵盤使用者的焦點卡在已隱藏的彈窗裡
    function close(returnFocus) {
      if (popover.getAttribute("data-open") !== "true") return;
      popover.removeAttribute("data-open");
      toggle.setAttribute("aria-expanded", "false");
      if (returnFocus) toggle.focus();
    }

    // 跟 SupportButton 同一套防呆：這顆鈕右邊不一定還有空間，
    // 彈窗展開後超出視窗左緣就改貼齊安全邊距。
    function reposition() {
      popover.style.right = "0";
      popover.style.left = "";
      var margin = 12;
      var rect = popover.getBoundingClientRect();
      if (rect.left < margin) {
        var wrapRect = wrap.getBoundingClientRect();
        popover.style.right = "auto";
        popover.style.left = Math.round(margin - wrapRect.left) + "px";
      }
    }

    function open() {
      // 開啟前先通知其他導覽選單收起（贊助彈窗、手機版三角／漢堡選單）
      document.dispatchEvent(new CustomEvent("nav:closeOthers", { detail: { except: popover } }));
      popover.setAttribute("data-open", "true");
      toggle.setAttribute("aria-expanded", "true");
      reposition();
      var first = popover.querySelector("a[href]");
      if (first) first.focus();
    }

    toggle.addEventListener("click", function (e) {
      e.stopPropagation();
      if (popover.getAttribute("data-open") === "true") close(false);
      else open();
    });

    document.addEventListener("click", function (e) {
      if (!popover.contains(e.target) && e.target !== toggle) close(false);
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") close(true);
    });
    document.addEventListener("nav:closeOthers", function (e) {
      if (e.detail.except !== popover) close(false);
    });
    window.addEventListener("resize", function () {
      if (popover.getAttribute("data-open") === "true") reposition();
    });

    // 彈窗只有一個連結，Tab 離開它（正向或反向）就自動關閉
    popover.addEventListener("keydown", function (e) {
      if (e.key !== "Tab") return;
      close(false);
    });
  })();
</script>
