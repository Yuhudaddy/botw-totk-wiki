---
// 技巧家族切換帶（方案 A：彈道切換帶）。同 family 的技巧各自是獨立頁面，
// 這裡只負責在頁首下方畫出橫向卡片，讓使用者知道彼此是同一家族的變體。
// 目前只有「擊飛」家族（風彈／一般擊飛／擊飛加速）在用，圖示暫時就地維護；
// 若之後家族數量變多，再考慮抽成獨立資料檔。
import { href } from "../lib/url";
import type { TypeItem } from "../data/types";
import type { Lang } from "../data/ui-strings";

interface Props {
  game: string;
  members: TypeItem[];
  currentNo: string;
  lang?: Lang;
}

const { game, members, currentNo, lang = "zh" } = Astro.props;

const GLYPHS: Record<string, string> = {
  "01": '<circle cx="6" cy="17" r="3"/><circle cx="17" cy="7" r="3"/><line x1="9" y1="14" x2="14" y2="10" stroke-dasharray="2 2"/>',
  "01-stasis":
    '<circle cx="9" cy="15" r="6"/><line x1="9" y1="15" x2="9" y2="11"/><line x1="9" y1="15" x2="12" y2="13"/><line x1="16" y1="8" x2="21" y2="3"/><polyline points="16 3 21 3 21 8"/>',
  "01-super":
    '<polyline points="2 19 8 13 12 17 18 7" opacity="0.35"/><polyline points="6 17 12 11 16 15 22 5"/><polyline points="16 5 22 5 22 11"/>',
};
---

<div class="relative">
  <div class="relative grid grid-cols-[repeat(auto-fit,minmax(190px,1fr))] gap-3">
    {
      members.map((m) => {
        const active = m.no === currentNo;
        return (
          <a
            href={href(`/types/${game}-${m.no}`, lang)}
            aria-current={active ? "page" : undefined}
            class={`launch-card flex items-center gap-3.5 rounded-[5px] border px-4 py-3.5 no-underline transition-colors ${
              active
                ? "border-ink bg-surface-2"
                : "border-border-soft bg-surface hover:border-brand"
            }`}
          >
            <svg
              class={`h-8 w-8 flex-none ${active ? "text-ink" : "text-muted"}`}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={GLYPHS[m.no] ?? ""}
            />
            <div class="min-w-0">
              <div class="font-mono text-[10px] font-bold uppercase tracking-[1.5px] text-gold">{m.en}</div>
              <div class="truncate font-heading text-[17px] font-medium leading-tight text-ink">
                {lang === "ja" ? m.ja ?? m.zh : m.zh}
              </div>
            </div>
          </a>
        );
      })
    }
  </div>
</div>

<style>
  .launch-card {
    z-index: 1;
  }
</style>
