---
// 「參照流程地圖」：可縮放拖曳的 2D 流程地圖，包裝自行架設的 Leaflet
// （public/vendor/leaflet/，不依賴外部 CDN，比照 Model3DViewer 的做法）。
// 底圖用「每層一張大圖」＋ L.CRS.Simple + imageOverlay，不用完整圖磚金字塔——
// 步驟導覽不需要 objmap 等級的細節，全站也才多幾 MB。
//
// 互動協定（與 [id].astro 的步驟單選按鈕配合）：
//   ・document 上的 CustomEvent "flowmap:show"，detail 為 FlowMapStepAction
//     （見 src/data/type-content.ts），另可帶 stepNo 供狀態列顯示步驟編號
//   ・CustomEvent "flowmap:reset"：清除標記並回到總覽
// 座標系：遊戲內座標 (X, Z)，X 向東為正、Z 向南為正，
// 範圍 X: -6000~6000、Z: -5000~5000；圖片上緣為北（Z = -5000）。
import { uiStrings, type Lang } from "../data/ui-strings";

interface FlowMapLayer {
  id: string;    // 圖層識別字，對應 FlowMapStepAction.layer
  label: string; // 切換按鈕文字
  image: string; // 底圖路徑（相對於 BASE_URL）
}
/** 常駐標記：不隨步驟切換而清除，用於「這個技巧有哪幾個固定地點」這類頁面 */
interface FlowMapPin {
  x: number;
  z: number;
  label?: string;  // 標籤文字；省略時只畫點
  layer?: string;  // 只在指定圖層顯示；省略時所有圖層都顯示
}
interface Props {
  layers?: FlowMapLayer[];
  defaultLayer?: string; // 初始圖層 id，預設第一層
  note?: string;         // 地圖下方的灰色備註
  /** 常駐標記（依序編號 ①②③…），與步驟標記各自獨立，不會被步驟切換清掉 */
  pins?: FlowMapPin[];
  /** 頁面語言；日文攻略頁傳 "ja"，其餘沿用中文 */
  lang?: Lang;
}
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const { lang = "zh" } = Astro.props;
const t = uiStrings[lang];
const {
  layers = [
    { id: "surface", label: t.flowMapLayerSurface, image: "/flow-map/totk/surface.webp" },
    { id: "sky", label: t.flowMapLayerSky, image: "/flow-map/totk/sky.webp" },
  ],
  defaultLayer,
  note,
  pins = [],
} = Astro.props;
const resolvedLayers = layers.map((l) => ({
  ...l,
  image: `${BASE}${l.image.startsWith("/") ? l.image : `/${l.image}`}`,
}));
const config = {
  layers: resolvedLayers,
  pins,
  defaultLayer: defaultLayer ?? resolvedLayers[0]?.id,
  // 底圖涵蓋範圍（遊戲座標）。兩款遊戲的 objmap 圖磚規則相同，這組數字對 totk／botw 通用。
  //
  // ⚠️ 這裡不是「地圖資料的範圍」而是「拼接後那張圖的範圍」，兩者不一樣：
  // 地圖資料本身只有 12000×10000 遊戲單位（zoom 5 下 6000×5000 px，0.5 px/單位），
  // 但圖磚網格是 24×20 塊、每塊 256px＝6144×5120 px，右側與下方各多出一圈留白。
  // 底圖是整個網格拼出來的，所以圖片實際涵蓋 6144/0.5＝12288、5120/0.5＝10240 單位。
  // 原點 (0,0) 落在 zoom 5 的 (3000, 2500) px，因此 min 仍是 -6000／-5000，
  // 但 max 必須是 -6000+12288＝6288、-5000+10240＝5240。
  // （量測方式：在 objmap 用 #/map/z3,{x},{z} 定位兩個已知座標，比對圖磚網格原點的像素差）
  minX: -6000, maxX: 6288, minZ: -5000, maxZ: 5240,
};
---

<link rel="stylesheet" href={`${BASE}/vendor/leaflet/leaflet.css`} />

<div
  class="flow-map"
  data-flow-map
  data-config={JSON.stringify(config)}
  data-status-step-template={t.flowMapStatusStepTemplate}
  data-status-selected={t.flowMapStatusSelected}
>
  <div class="flow-map-toolbar">
    {/* 只有一個圖層時（例：曠野只有地面）不顯示切換鈕，避免看起來像壞掉的單顆按鈕 */}
    <div
      class="flow-map-layers"
      role="group"
      aria-label={t.flowMapToggleLayers}
      hidden={resolvedLayers.length < 2}
    >
      {resolvedLayers.map((l) => (
        <button
          type="button"
          class="flow-map-layer-btn"
          data-flow-layer={l.id}
          aria-pressed={l.id === (defaultLayer ?? resolvedLayers[0]?.id) ? "true" : "false"}
        >
          {l.label}
        </button>
      ))}
    </div>
    <span class="flow-map-status" data-flow-status aria-live="polite">
      {t.flowMapStatusDefault}
    </span>
    <button type="button" class="flow-map-overview-btn" data-flow-overview>{t.flowMapOverview}</button>
  </div>
  <div class="flow-map-canvas" data-flow-canvas></div>
  {note && <p class="flow-map-note">{note}</p>}
</div>

{/* Leaflet 以傳統 script 同步載入（非 module），確保執行順序早於下方的
    Astro 打包 module script，init 時 window.L 一定存在 */}
<script is:inline src={`${BASE}/vendor/leaflet/leaflet.js`}></script>

<script>
  // 型別從簡：Leaflet 由傳統 script 掛在 window 上，這裡不引型別定義檔
  const L = (window as any).L;
  const root = document.querySelector<HTMLElement>("[data-flow-map]");

  if (root && L) {
    const config = JSON.parse(root.dataset.config ?? "{}");
    const canvas = root.querySelector<HTMLElement>("[data-flow-canvas]")!;
    const statusEl = root.querySelector<HTMLElement>("[data-flow-status]");
    const layerBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-flow-layer]"));
    const defaultStatus = statusEl?.textContent ?? "";
    const statusStepTemplate = root.dataset.statusStepTemplate ?? "目前顯示：步驟 {n}";
    const statusSelected = root.dataset.statusSelected ?? "目前顯示：選取的步驟";

    // 1 個地圖單位（latlng）= 10 遊戲單位；圖片上緣為北（z = minZ）
    const W = (config.maxX - config.minX) / 10;
    const H = (config.maxZ - config.minZ) / 10;
    const toLatLng = (x: number, z: number): [number, number] => [
      (config.maxZ - z) / 10,
      (x - config.minX) / 10,
    ];

    const css = getComputedStyle(document.documentElement);
    const accent = css.getPropertyValue("--accent").trim() || "#d97757";
    const inkColor = css.getPropertyValue("--ink").trim() || "#faf9f5";

    const map = L.map(canvas, {
      crs: L.CRS.Simple,
      minZoom: -1,
      maxZoom: 5,
      zoomSnap: 0.25,
      attributionControl: false,
      // CRS.Simple 預設縮放中心行為即可；滾輪、雙指、雙擊縮放全開
    });
    const bounds: [number, number][] = [[0, 0], [H, W]];
    // 拖出界時輕微回彈，避免整張圖被拖到看不見
    map.setMaxBounds([[-150, -150], [H + 150, W + 150]]);

    let activeLayerId: string = config.defaultLayer;
    const layerById = new Map<string, { id: string; label: string; image: string }>(
      (config.layers as { id: string; label: string; image: string }[]).map((l) => [l.id, l])
    );
    const overlay = L.imageOverlay(layerById.get(activeLayerId)?.image, bounds).addTo(map);
    map.fitBounds(bounds);

    // 步驟標記（Pin／軌跡）集中放在一個 layerGroup，換步驟時整組清掉
    const marks = L.layerGroup().addTo(map);
    // 常駐標記獨立一組：不隨步驟切換清除，只在圖層切換時決定顯示與否
    const staticMarks = L.layerGroup().addTo(map);

    // 常駐標記畫成編號圓標（①②③…），和步驟用的小圓點在視覺上分得開
    const staticPins: { x: number; z: number; label?: string; layer?: string }[] =
      config.pins ?? [];
    function renderStaticPins() {
      staticMarks.clearLayers();
      staticPins.forEach((p, i) => {
        if (p.layer && p.layer !== activeLayerId) return;
        const ll = toLatLng(p.x, p.z);
        L.marker(ll, {
          interactive: false,
          icon: L.divIcon({
            className: "flow-map-pin",
            html: `<span class="flow-map-pin-dot">${i + 1}</span>`,
            iconSize: [26, 26],
            iconAnchor: [13, 13],
          }),
        }).addTo(staticMarks);
        if (p.label) {
          L.marker(ll, {
            interactive: false,
            icon: L.divIcon({
              className: "flow-map-pin-label",
              html: `<span>${p.label}</span>`,
              iconSize: [0, 0],
              iconAnchor: [0, -16],
            }),
          }).addTo(staticMarks);
        }
      });
    }

    function setLayer(id: string) {
      const layer = layerById.get(id);
      if (!layer || id === activeLayerId) return;
      activeLayerId = id;
      overlay.setUrl(layer.image);
      layerBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.flowLayer === id)));
      renderStaticPins(); // 常駐標記可能只屬於某個圖層
    }

    renderStaticPins();

    // 軌跡箭頭：divIcon 不隨縮放改變大小，放在每段線段的中點指向前進方向。
    // 螢幕座標 y 向下＝lat 減少，所以 dy 取負
    function addSegmentArrow(a: [number, number], b: [number, number]) {
      const dx = b[1] - a[1];
      const dy = -(b[0] - a[0]);
      const deg = (Math.atan2(dy, dx) * 180) / Math.PI;
      const mid: [number, number] = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
      L.marker(mid, {
        interactive: false,
        icon: L.divIcon({
          className: "flow-map-arrow",
          html: `<svg width="14" height="14" viewBox="0 0 14 14" style="transform:rotate(${deg}deg)"><path d="M2 2 L13 7 L2 12 L5 7 Z" fill="${accent}" stroke="${inkColor}" stroke-width="0.6"/></svg>`,
          iconSize: [14, 14],
          iconAnchor: [7, 7],
        }),
      }).addTo(marks);
    }

    function show(detail: {
      layer?: string;
      focus?: { x: number; z: number; zoom?: number };
      pins?: { x: number; z: number; label?: string }[];
      path?: [number, number][];
      stepNo?: number;
    }) {
      marks.clearLayers();
      if (detail.layer) setLayer(detail.layer);

      const focusPoints: [number, number][] = [];

      (detail.pins ?? []).forEach((p) => {
        const ll = toLatLng(p.x, p.z);
        focusPoints.push(ll);
        const marker = L.circleMarker(ll, {
          radius: 7,
          color: inkColor,
          weight: 1.5,
          fillColor: accent,
          fillOpacity: 0.95,
        }).addTo(marks);
        if (p.label) {
          marker.bindTooltip(p.label, {
            permanent: true,
            direction: "top",
            offset: [0, -9],
            className: "flow-map-tip",
          });
        }
      });

      if (detail.path && detail.path.length >= 2) {
        const latlngs = detail.path.map(([x, z]) => toLatLng(x, z));
        latlngs.forEach((ll) => focusPoints.push(ll));
        L.polyline(latlngs, {
          color: accent,
          weight: 3,
          opacity: 0.9,
          dashArray: "6 6",
        }).addTo(marks);
        for (let i = 0; i < latlngs.length - 1; i++) addSegmentArrow(latlngs[i], latlngs[i + 1]);
      }

      if (detail.focus) {
        map.setView(toLatLng(detail.focus.x, detail.focus.z), detail.focus.zoom ?? 1);
      } else if (focusPoints.length > 0) {
        // 沒指定鏡頭就自動框住所有標記；maxZoom 防止單一 Pin 時貼太近
        map.fitBounds(L.latLngBounds(focusPoints).pad(0.4), { maxZoom: 2 });
      }

      if (statusEl) {
        statusEl.textContent =
          detail.stepNo != null
            ? statusStepTemplate.replace("{n}", String(detail.stepNo))
            : statusSelected;
      }
    }

    function reset() {
      marks.clearLayers();
      map.fitBounds(bounds);
      if (statusEl) statusEl.textContent = defaultStatus;
    }

    document.addEventListener("flowmap:show", ((e: CustomEvent) => show(e.detail)) as EventListener);
    document.addEventListener("flowmap:reset", reset);

    layerBtns.forEach((btn) =>
      btn.addEventListener("click", () => setLayer(btn.dataset.flowLayer ?? ""))
    );
    root.querySelector<HTMLButtonElement>("[data-flow-overview]")?.addEventListener("click", () => {
      map.fitBounds(bounds);
    });
  }
</script>

<style>
  .flow-map {
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .flow-map-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border-strong);
  }
  .flow-map-layers {
    display: flex;
    gap: 6px;
  }
  .flow-map-layer-btn,
  .flow-map-overview-btn {
    cursor: pointer;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--ink-2);
    border-radius: 999px;
    padding: 4px 14px;
    font-size: 13px;
    font-weight: 500;
    transition: border-color 0.15s, color 0.15s;
  }
  .flow-map-layer-btn:hover,
  .flow-map-overview-btn:hover {
    border-color: var(--brand);
  }
  .flow-map-layer-btn[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }
  .flow-map-status {
    flex: 1;
    min-width: 160px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .flow-map-overview-btn {
    margin-left: auto;
  }
  .flow-map-canvas {
    /* 12:10 的地圖塞進 2:1 左右的容器：桌機高一點、手機順著寬度縮 */
    height: clamp(320px, 44vw, 560px);
    background: var(--surface);
    outline: none;
  }
  .flow-map-note {
    margin: 0;
    padding: 8px 14px 10px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--muted);
    border-top: 1px solid var(--border-strong);
  }

  /* Leaflet 控制項配合全站深淺色（元件 scoped 樣式無法選到 Leaflet 動態
     產生的節點，以下用 :global 穿透） */
  .flow-map :global(.leaflet-container) {
    background: var(--surface);
    font: inherit;
  }
  .flow-map :global(.leaflet-bar a) {
    background: var(--surface-2);
    color: var(--ink);
    border-bottom-color: var(--border-strong);
  }
  .flow-map :global(.leaflet-bar a:hover) {
    background: var(--surface);
  }
  .flow-map :global(.leaflet-bar) {
    border-color: var(--border-strong);
  }
  .flow-map :global(.flow-map-tip) {
    background: var(--surface-2);
    color: var(--ink);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 12px;
    box-shadow: none;
  }
  .flow-map :global(.flow-map-tip::before) {
    display: none; /* 拿掉 Leaflet tooltip 預設的小三角，深淺色下顏色對不上 */
  }
  .flow-map :global(.flow-map-arrow) {
    background: none;
    border: none;
  }

  /* 常駐標記：編號圓標（步驟標記是小圓點，兩者要一眼分得出來） */
  .flow-map :global(.flow-map-pin) {
    background: none;
    border: none;
  }
  .flow-map :global(.flow-map-pin-dot) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    border: 2px solid var(--ink);
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.45);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .flow-map :global(.flow-map-pin-label) {
    background: none;
    border: none;
    white-space: nowrap;
  }
  .flow-map :global(.flow-map-pin-label span) {
    display: inline-block;
    transform: translateX(-50%);
    background: var(--surface-2);
    color: var(--ink);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 12px;
  }
</style>
