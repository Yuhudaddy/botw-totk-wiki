---
// 「參照流程地圖」：可縮放拖曳的 2D 流程地圖，包裝自行架設的 Leaflet
// （public/vendor/leaflet/，不依賴外部 CDN，比照 Model3DViewer 的做法）。
// 底圖用「每層一張大圖」＋ L.CRS.Simple + imageOverlay，不用完整圖磚金字塔——
// 步驟導覽不需要 objmap 等級的細節，全站也才多幾 MB。
//
// 互動協定（與 [id].astro 的步驟單選按鈕配合）：
//   ・document 上的 CustomEvent "flowmap:show"，detail 為 FlowMapStepAction
//     （見 src/data/type-content.ts），另可帶 stepNo 供狀態列顯示步驟編號
//   ・CustomEvent "flowmap:reset"：清除標記並回到總覽
// 座標系：遊戲內座標 (X, Z)，X 向東為正、Z 向南為正，
// 範圍 X: -6000~6000、Z: -5000~5000；圖片上緣為北（Z = -5000）。
import { uiStrings, type Lang } from "../data/ui-strings";

interface FlowMapLayer {
  id: string;    // 圖層識別字，對應 FlowMapStepAction.layer
  label: string; // 切換按鈕文字
  image: string; // 底圖路徑（相對於 BASE_URL）
}
/** 常駐標記：不隨步驟切換而清除，用於「這個技巧有哪幾個固定地點」這類頁面 */
interface FlowMapPin {
  x: number;
  z: number;
  label?: string;  // 標籤文字；省略時只畫點
  layer?: string;  // 只在指定圖層顯示；省略時所有圖層都顯示
  image?: string;  // 實景圖網址；有值時 Pin 變成可點擊（滑鼠與鍵盤皆可），點擊後彈出圖片
  caption?: string;
  /** 從該 Pin 出發的建議路線；有值時「路線」按鈕會在選取此 Pin 後啟用 */
  routes?: { to: { x: number; z: number }; alt?: boolean; label?: string }[];
}
interface Props {
  layers?: FlowMapLayer[];
  defaultLayer?: string; // 初始圖層 id，預設第一層
  note?: string;         // 地圖下方的灰色備註
  /** 常駐標記（依序編號 ①②③…），與步驟標記各自獨立，不會被步驟切換清掉 */
  pins?: FlowMapPin[];
  /** 顯示「格線」按鈕：疊上地圖單元格（A～J × 1～8）參考層 */
  grid?: boolean;
  /** 頁面語言；日文攻略頁傳 "ja"，其餘沿用中文 */
  lang?: Lang;
}
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const { lang = "zh" } = Astro.props;
const t = uiStrings[lang];
const {
  layers = [
    { id: "surface", label: t.flowMapLayerSurface, image: "/flow-map/totk/surface.webp" },
    { id: "sky", label: t.flowMapLayerSky, image: "/flow-map/totk/sky.webp" },
  ],
  defaultLayer,
  note,
  pins = [],
  grid = false,
} = Astro.props;
const hasImages = pins.some((p) => p.image);
const resolvedLayers = layers.map((l) => ({
  ...l,
  image: `${BASE}${l.image.startsWith("/") ? l.image : `/${l.image}`}`,
}));
const config = {
  layers: resolvedLayers,
  pins,
  grid,
  pinAriaTemplate: t.flowMapPinAriaTemplate,
  defaultLayer: defaultLayer ?? resolvedLayers[0]?.id,
  // 底圖涵蓋範圍（遊戲座標）。兩款遊戲的 objmap 圖磚規則相同，這組數字對 totk／botw 通用。
  //
  // ⚠️ 這裡不是「地圖資料的範圍」而是「拼接後那張圖的範圍」，兩者不一樣：
  // 地圖資料本身只有 12000×10000 遊戲單位（zoom 5 下 6000×5000 px，0.5 px/單位），
  // 但圖磚網格是 24×20 塊、每塊 256px＝6144×5120 px，右側與下方各多出一圈留白。
  // 底圖是整個網格拼出來的，所以圖片實際涵蓋 6144/0.5＝12288、5120/0.5＝10240 單位。
  // 原點 (0,0) 落在 zoom 5 的 (3000, 2500) px，因此 min 仍是 -6000／-5000，
  // 但 max 必須是 -6000+12288＝6288、-5000+10240＝5240。
  // （量測方式：在 objmap 用 #/map/z3,{x},{z} 定位兩個已知座標，比對圖磚網格原點的像素差）
  minX: -6000, maxX: 6288, minZ: -5000, maxZ: 5240,
};
---

<link rel="stylesheet" href={`${BASE}/vendor/leaflet/leaflet.css`} />

<div
  class="flow-map"
  data-flow-map
  data-config={JSON.stringify(config)}
  data-status-step-template={t.flowMapStatusStepTemplate}
  data-status-selected={t.flowMapStatusSelected}
>
  <div class="flow-map-toolbar">
    {/* 只有一個圖層時（例：曠野只有地面）不顯示切換鈕，避免看起來像壞掉的單顆按鈕 */}
    <div
      class="flow-map-layers"
      role="group"
      aria-label={t.flowMapToggleLayers}
      hidden={resolvedLayers.length < 2}
    >
      {resolvedLayers.map((l) => (
        <button
          type="button"
          class="flow-map-layer-btn"
          data-flow-layer={l.id}
          aria-pressed={l.id === (defaultLayer ?? resolvedLayers[0]?.id) ? "true" : "false"}
        >
          {l.label}
        </button>
      ))}
    </div>
    <span class="flow-map-status" data-flow-status aria-live="polite">
      {t.flowMapStatusDefault}
    </span>
    <div class="flow-map-actions">
      {hasImages && (
        // 先點地圖上的標記才知道要開哪一張圖，所以初始為停用；aria-disabled 而非 disabled，
        // 讓鍵盤使用者仍能聚焦讀到 title 的說明，不會變成「摸不到的按鈕」
        <button
          type="button"
          class="flow-map-overview-btn"
          data-flow-demo-image
          aria-disabled="true"
          title={t.flowMapDemoImageHint}
        >{t.flowMapDemoImage}</button>
      )}
      {grid && (
        <button
          type="button"
          class="flow-map-overview-btn"
          data-flow-grid
          aria-pressed="false"
        >{t.flowMapGrid}</button>
      )}
      <button type="button" class="flow-map-overview-btn" data-flow-overview>{t.flowMapOverview}</button>
    </div>
  </div>
  <div class="flow-map-canvas" data-flow-canvas></div>
  {note && <p class="flow-map-note">{note}</p>}

  {/* Pin 實景圖：窄螢幕改成置中的對話框，寬螢幕則由 Leaflet popup 貼在 Pin 上 */}
  <div class="flow-map-photo" data-flow-photo hidden>
    <button type="button" class="flow-map-photo-backdrop" tabindex="-1" aria-hidden="true" data-flow-photo-close></button>
    <div class="flow-map-photo-dialog" role="dialog" aria-modal="true" aria-labelledby="flow-map-photo-title">
      <div class="flow-map-photo-head">
        <h3 id="flow-map-photo-title"></h3>
        <button type="button" data-flow-photo-close aria-label={t.flowMapPinClose}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <div class="flow-map-photo-body"><img src="" alt="" /></div>
      <p class="flow-map-photo-caption"></p>
    </div>
  </div>
</div>

{/* Leaflet 以傳統 script 同步載入（非 module），確保執行順序早於下方的
    Astro 打包 module script，init 時 window.L 一定存在 */}
<script is:inline src={`${BASE}/vendor/leaflet/leaflet.js`}></script>

<script>
  // 型別從簡：Leaflet 由傳統 script 掛在 window 上，這裡不引型別定義檔
  const L = (window as any).L;
  const root = document.querySelector<HTMLElement>("[data-flow-map]");

  if (root && L) {
    const config = JSON.parse(root.dataset.config ?? "{}");
    const canvas = root.querySelector<HTMLElement>("[data-flow-canvas]")!;
    const statusEl = root.querySelector<HTMLElement>("[data-flow-status]");
    const layerBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-flow-layer]"));
    const defaultStatus = statusEl?.textContent ?? "";
    const statusStepTemplate = root.dataset.statusStepTemplate ?? "目前顯示：步驟 {n}";
    const statusSelected = root.dataset.statusSelected ?? "目前顯示：選取的步驟";

    // 1 個地圖單位（latlng）= 10 遊戲單位；圖片上緣為北（z = minZ）
    const W = (config.maxX - config.minX) / 10;
    const H = (config.maxZ - config.minZ) / 10;
    const toLatLng = (x: number, z: number): [number, number] => [
      (config.maxZ - z) / 10,
      (x - config.minX) / 10,
    ];

    const css = getComputedStyle(document.documentElement);
    const accent = css.getPropertyValue("--accent").trim() || "#d97757";
    const inkColor = css.getPropertyValue("--ink").trim() || "#faf9f5";

    const map = L.map(canvas, {
      crs: L.CRS.Simple,
      // 手機版總覽需要比 -1 更小的縮放，才能把 12:10 的完整地圖塞進窄而矮的畫布。
      minZoom: -2,
      maxZoom: 5,
      zoomSnap: 0.25,
      attributionControl: false,
      // CRS.Simple 預設縮放中心行為即可；滾輪、雙指、雙擊縮放全開
    });
    const bounds: [number, number][] = [[0, 0], [H, W]];
    // 拖出界時輕微回彈，避免整張圖被拖到看不見
    map.setMaxBounds([[-150, -150], [H + 150, W + 150]]);

    let activeLayerId: string = config.defaultLayer;
    const layerById = new Map<string, { id: string; label: string; image: string }>(
      (config.layers as { id: string; label: string; image: string }[]).map((l) => [l.id, l])
    );
    const overlay = L.imageOverlay(layerById.get(activeLayerId)?.image, bounds).addTo(map);
    map.fitBounds(bounds);

    // 步驟標記（Pin／軌跡）集中放在一個 layerGroup，換步驟時整組清掉
    const marks = L.layerGroup().addTo(map);
    // 常駐標記獨立一組：不隨步驟切換清除，只在圖層切換時決定顯示與否
    const staticMarks = L.layerGroup().addTo(map);

    // 地圖單元格（Map Unit Grid）：A～J × 1～8，每格 1000 遊戲單位，
    // 遊玩區域為 X -5000~5000、Z -4000~4000（底圖比這個範圍再大一圈）
    const gridLayer = L.layerGroup();
    let gridOn = false;
    const COLS = "ABCDEFGHIJ";
    function buildGrid() {
      for (let c = 0; c < 10; c++) {
        for (let r = 0; r < 8; r++) {
          const x0 = -5000 + c * 1000, z0 = -4000 + r * 1000;
          const nw = toLatLng(x0, z0), se = toLatLng(x0 + 1000, z0 + 1000);
          L.rectangle([nw, se], {
            color: "#ffffff", weight: 1, opacity: 0.35,
            fillColor: "#ffffff", fillOpacity: 0.06,
            interactive: false,
          }).addTo(gridLayer);
          L.marker(toLatLng(x0 + 500, z0 + 500), {
            interactive: false,
            icon: L.divIcon({
              className: "flow-map-grid-label",
              html: `<span>${COLS[c]}${r + 1}</span>`,
              iconSize: [0, 0], iconAnchor: [0, 0],
            }),
          }).addTo(gridLayer);
        }
      }
    }
    buildGrid();

    // 路線層：選取某個 Pin 後才知道要畫哪一條
    const routeLayer = L.layerGroup().addTo(map);
    let selectedPin: number | null = null;

    // 常駐標記畫成編號圓標（①②③…），和步驟用的小圓點在視覺上分得開
    const staticPins: {
      x: number; z: number; label?: string; layer?: string;
      image?: string; caption?: string;
      routes?: { to: { x: number; z: number }; alt?: boolean; label?: string }[];
    }[] = config.pins ?? [];
    const pinAriaTemplate: string = config.pinAriaTemplate ?? "查看標記 {n} 的建議路線";

    function renderStaticPins() {
      staticMarks.clearLayers();
      staticPins.forEach((p, i) => {
        if (p.layer && p.layer !== activeLayerId) return;
        const ll = toLatLng(p.x, p.z);
        const clickable = !!(p.image || p.routes?.length);
        // 有圖或有路線才做成可聚焦的按鈕；都沒有的維持純標記，避免點了沒反應
        const inner = clickable
          ? `<button type="button" class="flow-map-pin-dot is-clickable" data-pin-index="${i}"
               aria-label="${pinAriaTemplate.replace("{n}", String(i + 1))}">${i + 1}</button>`
          : `<span class="flow-map-pin-dot">${i + 1}</span>`;
        L.marker(ll, {
          interactive: clickable,
          keyboard: false,
          icon: L.divIcon({
            className: "flow-map-pin",
            html: inner,
            iconSize: [26, 26],
            iconAnchor: [13, 13],
          }),
        }).addTo(staticMarks);
        if (p.label) {
          L.marker(ll, {
            interactive: false,
            icon: L.divIcon({
              className: "flow-map-pin-label",
              html: `<span>${p.label}</span>`,
              iconSize: [0, 0],
              iconAnchor: [0, -16],
            }),
          }).addTo(staticMarks);
        }
      });
      markSelectedPin();
    }

    function markSelectedPin() {
      root!.querySelectorAll<HTMLElement>(".flow-map-pin-dot").forEach((el) => {
        const idx = Number(el.dataset.pinIndex);
        el.classList.toggle("is-selected", selectedPin !== null && idx === selectedPin);
      });
    }

    function setLayer(id: string) {
      const layer = layerById.get(id);
      if (!layer || id === activeLayerId) return;
      activeLayerId = id;
      overlay.setUrl(layer.image);
      layerBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.flowLayer === id)));
      renderStaticPins(); // 常駐標記可能只屬於某個圖層
    }

    renderStaticPins();

    // 軌跡箭頭：divIcon 不隨縮放改變大小，放在每段線段的中點指向前進方向。
    // 螢幕座標 y 向下＝lat 減少，所以 dy 取負
    // target 預設為步驟軌跡的 marks；路線功能有自己的圖層，畫在別處才能各自獨立清除
    function addSegmentArrow(a: [number, number], b: [number, number], target: any = marks) {
      const dx = b[1] - a[1];
      const dy = -(b[0] - a[0]);
      const deg = (Math.atan2(dy, dx) * 180) / Math.PI;
      const mid: [number, number] = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
      L.marker(mid, {
        interactive: false,
        icon: L.divIcon({
          className: "flow-map-arrow",
          html: `<svg width="14" height="14" viewBox="0 0 14 14" style="transform:rotate(${deg}deg)"><path d="M2 2 L13 7 L2 12 L5 7 Z" fill="${accent}" stroke="${inkColor}" stroke-width="0.6"/></svg>`,
          iconSize: [14, 14],
          iconAnchor: [7, 7],
        }),
      }).addTo(target);
    }

    function show(detail: {
      layer?: string;
      focus?: { x: number; z: number; zoom?: number };
      pins?: { x: number; z: number; label?: string }[];
      path?: [number, number][];
      stepNo?: number;
    }) {
      marks.clearLayers();
      if (detail.layer) setLayer(detail.layer);

      const focusPoints: [number, number][] = [];

      (detail.pins ?? []).forEach((p) => {
        const ll = toLatLng(p.x, p.z);
        focusPoints.push(ll);
        const marker = L.circleMarker(ll, {
          radius: 7,
          color: inkColor,
          weight: 1.5,
          fillColor: accent,
          fillOpacity: 0.95,
        }).addTo(marks);
        if (p.label) {
          marker.bindTooltip(p.label, {
            permanent: true,
            direction: "top",
            offset: [0, -9],
            className: "flow-map-tip",
          });
        }
      });

      if (detail.path && detail.path.length >= 2) {
        const latlngs = detail.path.map(([x, z]) => toLatLng(x, z));
        latlngs.forEach((ll) => focusPoints.push(ll));
        L.polyline(latlngs, {
          color: accent,
          weight: 3,
          opacity: 0.9,
          dashArray: "6 6",
        }).addTo(marks);
        for (let i = 0; i < latlngs.length - 1; i++) addSegmentArrow(latlngs[i], latlngs[i + 1]);
      }

      if (detail.focus) {
        map.setView(toLatLng(detail.focus.x, detail.focus.z), detail.focus.zoom ?? 1);
      } else if (focusPoints.length > 0) {
        // 沒指定鏡頭就自動框住所有標記；maxZoom 防止單一 Pin 時貼太近
        map.fitBounds(L.latLngBounds(focusPoints).pad(0.4), { maxZoom: 2 });
      }

      if (statusEl) {
        statusEl.textContent =
          detail.stepNo != null
            ? statusStepTemplate.replace("{n}", String(detail.stepNo))
            : statusSelected;
      }
    }

    function reset() {
      marks.clearLayers();
      map.fitBounds(bounds);
      if (statusEl) statusEl.textContent = defaultStatus;
    }

    document.addEventListener("flowmap:show", ((e: CustomEvent) => show(e.detail)) as EventListener);
    document.addEventListener("flowmap:reset", reset);

    layerBtns.forEach((btn) =>
      btn.addEventListener("click", () => setLayer(btn.dataset.flowLayer ?? ""))
    );
    root.querySelector<HTMLButtonElement>("[data-flow-overview]")?.addEventListener("click", () => {
      routeLayer.clearLayers();
      selectedPin = null;
      markSelectedPin();
      enableDemoBtn(false);
      map.fitBounds(bounds);
    });

    // ── 格線 ──────────────────────────────────────────────
    const gridBtn = root.querySelector<HTMLButtonElement>("[data-flow-grid]");
    gridBtn?.addEventListener("click", () => {
      gridOn = !gridOn;
      if (gridOn) gridLayer.addTo(map); else gridLayer.remove();
      gridBtn.setAttribute("aria-pressed", String(gridOn));
    });

    // ── 路線：點 pin 直接顯示，不需要另外開關 ──────────────────
    function drawRoutes(idx: number) {
      routeLayer.clearLayers();
      const p = staticPins[idx];
      if (!p?.routes?.length) return;
      const pts: [number, number][] = [];
      p.routes.forEach((r) => {
        const a = toLatLng(p.x, p.z), b = toLatLng(r.to.x, r.to.z);
        pts.push(a, b);
        const color = r.alt ? inkColor : accent;
        L.polyline([a, b], { color, weight: 3.5, opacity: 0.95 }).addTo(routeLayer);
        addSegmentArrow(a, b, routeLayer);      // 箭頭沿用步驟軌跡的樣式，但畫進路線自己的圖層才能被 routeLayer.clearLayers() 清乾淨
        L.circleMarker(b, {
          radius: 5, color, weight: 2, fillColor: color, fillOpacity: 0.9, interactive: false,
        }).addTo(routeLayer);
      });
      // 起終點都框進畫面，pad 留白避免箭頭貼邊
      if (pts.length) map.fitBounds(L.latLngBounds(pts).pad(0.35), { maxZoom: 3 });
    }

    // ── 示意圖：選了 pin 之後才能點，開啟該處實景照 ──────────────
    const demoBtn = root.querySelector<HTMLButtonElement>("[data-flow-demo-image]");
    function enableDemoBtn(on: boolean) {
      if (!demoBtn) return;
      demoBtn.setAttribute("aria-disabled", String(!on));
      demoBtn.classList.toggle("is-disabled", !on);
    }
    enableDemoBtn(false); // 初始狀態就要反灰，不能只靠 aria-disabled（那只影響輔助技術，不影響外觀）

    const photo = root.querySelector<HTMLElement>("[data-flow-photo]");
    const photoImg = photo?.querySelector("img") as HTMLImageElement | null;
    const photoTitle = photo?.querySelector("h3");
    const photoCaption = photo?.querySelector<HTMLElement>(".flow-map-photo-caption");
    let photoTrigger: HTMLElement | null = null;

    function closePhoto() {
      if (!photo) return;
      photo.hidden = true;
      if (photoImg) { photoImg.src = ""; photoImg.alt = ""; }
      document.documentElement.style.overflow = "";
      photoTrigger?.focus();
    }
    function openPhoto(idx: number, trigger: HTMLElement) {
      const p = staticPins[idx];
      if (!photo || !photoImg || !p?.image) return;
      photoTrigger = trigger;
      if (photoTitle) photoTitle.textContent = p.label ?? String(idx + 1);
      photoImg.src = p.image;
      photoImg.alt = p.caption ?? p.label ?? "";
      if (photoCaption) {
        photoCaption.textContent = p.caption ?? "";
        photoCaption.hidden = !p.caption;
      }
      photo.hidden = false;
      document.documentElement.style.overflow = "hidden";
      photo.querySelector<HTMLButtonElement>(".flow-map-photo-head button")?.focus();
    }
    demoBtn?.addEventListener("click", () => {
      if (demoBtn.getAttribute("aria-disabled") === "true" || selectedPin === null) return;
      openPhoto(selectedPin, demoBtn);
    });

    // ── Pin 點擊 → 直接顯示該點的建議路線，並讓「示意圖」按鈕可用 ──────
    // 事件委派：Pin 是每次 renderStaticPins 重建的，逐顆綁定會在切圖層後失效
    root.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>(".flow-map-pin-dot.is-clickable");
      if (!btn) return;
      const idx = Number(btn.dataset.pinIndex);
      selectedPin = idx;
      markSelectedPin();
      drawRoutes(idx);
      enableDemoBtn(!!staticPins[idx]?.image);
    });

    photo?.querySelectorAll<HTMLButtonElement>("[data-flow-photo-close]")
      .forEach((b) => b.addEventListener("click", closePhoto));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && photo && !photo.hidden) closePhoto();
    });
    // 焦點鎖在對話框內：宣告了 aria-modal="true"，Tab 不該跑到背景
    photo?.addEventListener("keydown", (e) => {
      if (e.key !== "Tab" || photo.hidden) return;
      const f = Array.from(photo.querySelectorAll<HTMLElement>("button, a[href], [tabindex]"))
        .filter((el) => el.tabIndex >= 0);
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  }
</script>

