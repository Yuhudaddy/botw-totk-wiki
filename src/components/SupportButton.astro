---
// 贊助入口：右上角導覽列按鈕，點擊在下方彈出小視窗，導向 YouTube 訂閱與 Portaly 贊助。
import { SITE } from "../data/site";
import { uiStrings, type Lang } from "../data/ui-strings";

interface Props {
  /** 頁面語言；日文攻略頁傳 "ja"，其餘沿用中文 */
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const t = uiStrings[lang];
---

<div class="relative">
  <button
    id="support-toggle"
    type="button"
    aria-label={t.supportToggle}
    aria-haspopup="true"
    aria-expanded="false"
    class="nav-icon-btn w-9 font-heading text-[15px] font-semibold"
  >
    $
  </button>

  <div
    id="support-popover"
    role="dialog"
    class="support-popover pointer-events-none absolute left-1/2 top-[calc(100%+10px)] z-50 w-[250px] -translate-x-1/2 rounded-[5px] border border-border-strong bg-surface p-5 opacity-0 shadow-lg transition-opacity duration-150"
  >
    <div class="flex flex-col gap-2">
      <p class="text-[13px] leading-[1.5] text-text">{t.supportSubscribeHint}</p>
      <a
        href={`${SITE.youtube}?sub_confirmation=1`}
        target="_blank"
        rel="noopener"
        title={t.supportSubscribeTitle}
        data-support-ripple="subscribe"
        class="support-btn support-btn-subscribe block rounded-[5px] border border-border-strong bg-transparent px-3 py-2 text-center text-[13px] font-medium text-ink no-underline"
      >
        {t.supportSubscribe}
      </a>
    </div>
    <div class="mt-4 flex flex-col gap-2">
      <p class="text-[13px] leading-[1.5] text-text">{t.supportSponsorHint}</p>
      <a
        href="https://portaly.cc/yuhudaddy/support"
        target="_blank"
        rel="noopener"
        title={t.supportSponsorTitle}
        data-support-ripple="sponsor"
        class="support-btn support-btn-sponsor block rounded-[5px] border border-transparent bg-[var(--gold)] px-3 py-2 text-center text-[13px] font-medium text-[var(--gold-ink)] no-underline"
      >
        {t.supportSponsor}
      </a>
    </div>
  </div>
</div>

<style>
  .support-popover[data-open="true"] {
    pointer-events: auto;
    opacity: 1;
  }

  /* 淺色底用深紅、深色底用亮紅，兩種主題都維持足夠對比 */
  .support-btn-subscribe {
    --yt-red: #d32f2f;
    --yt-red-edge: #ff0000;
  }
  :global([data-theme="dark"]) .support-btn-subscribe {
    --yt-red: #ff5252;
    --yt-red-edge: #ff3b3b;
  }

  .support-btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 160ms ease-out,
      border-color 200ms ease-out,
      color 150ms ease-out,
      background-color 200ms ease-out;
  }

  /* 按下時輕微內縮：target="_blank" 不會離開本頁，:active 一定看得到 */
  .support-btn:active {
    transform: scale(0.97);
  }

  /* 負 z-index ＋ isolation：色塊疊在按鈕底色之上、文字之下 */
  .support-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* 訂閱：淡紅底淡入，邊框與文字轉為 YouTube 紅 */
  .support-btn-subscribe::before {
    background: color-mix(in srgb, var(--yt-red-edge) 9%, transparent);
    opacity: 0;
    transition: opacity 220ms ease-out;
  }

  /* 贊助：不透明淺色由下往上注入，頂端 2px 較亮處是「液面」。
     半透明版本疊在金底上幾乎看不見，且會把字的對比壓下來；
     改為不透明填充並讓文字同步轉深銅。贊助按鈕整組走希卡金
     （金＝贊助的語意剛好），填充用暖乳白配銅字。 */
  .support-btn-sponsor {
    --milk: #fbf6e8;
    --milk-text: #7a5b1e;
  }
  .support-btn-sponsor::before {
    background: linear-gradient(
      to top,
      var(--milk) 0%,
      var(--milk) calc(100% - 2px),
      #fffdf2 100%
    );
    transform: translateY(100%);
    transition: transform 240ms cubic-bezier(0.22, 0.8, 0.36, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .support-btn-subscribe:hover,
    .support-btn-subscribe:focus-visible {
      border-color: var(--yt-red-edge);
      color: var(--yt-red);
    }
    .support-btn-subscribe:hover::before,
    .support-btn-subscribe:focus-visible::before {
      opacity: 1;
    }

    /* 文字轉色比填充快，縮短「深字疊在橘底上」的過渡空窗 */
    .support-btn-sponsor:hover,
    .support-btn-sponsor:focus-visible {
      color: var(--milk-text);
    }
    .support-btn-sponsor:hover::before,
    .support-btn-sponsor:focus-visible::before {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .support-btn {
      transition: border-color 200ms ease-out, color 200ms ease-out, background-color 200ms ease-out;
    }
    .support-btn:active {
      transform: none;
    }
    /* 保留顏色變化，取消位移：奶白直接淡入而非由下升起 */
    .support-btn-sponsor::before {
      transform: none;
      opacity: 0;
      transition: opacity 200ms ease-out;
    }
    .support-btn-sponsor:hover::before,
    .support-btn-sponsor:focus-visible::before {
      opacity: 1;
    }
  }
</style>

{/* 水波紋由 JS 動態插入，拿不到 Astro scoped 樣式屬性，須放在 global 樣式 */}
<style is:global>
  .support-ripple {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
    transform: scale(0);
    animation: support-ripple 520ms ease-out forwards;
  }

  .support-ripple-subscribe {
    background: radial-gradient(circle, rgba(255, 0, 0, 0.26) 0%, rgba(255, 0, 0, 0.12) 55%, transparent 78%);
  }

  /* 點擊當下按鈕已被淺色填滿，漣漪需用深銅才看得見 */
  .support-ripple-sponsor {
    background: radial-gradient(circle, rgba(122, 91, 30, 0.3) 0%, rgba(122, 91, 30, 0.14) 55%, transparent 78%);
  }

  @keyframes support-ripple {
    to {
      transform: scale(1);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .support-ripple {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var toggle = document.getElementById("support-toggle");
    var popover = document.getElementById("support-popover");
    if (!toggle || !popover) return;

    // 關閉時把焦點還給觸發按鈕，避免鍵盤使用者的焦點卡在已隱藏的彈窗裡
    function close(returnFocus) {
      if (popover.getAttribute("data-open") !== "true") return;
      popover.removeAttribute("data-open");
      toggle.setAttribute("aria-expanded", "false");
      if (returnFocus) toggle.focus();
    }

    // 預設用 CSS 置中在觸發鈕正下方（left:50% + translateX(-50%)）。
    // 窄螢幕上這顆鈕可能偏在畫面邊緣，置中後彈窗仍會被推出視窗外，
    // 開啟後量一次實際位置，超出安全邊距就用 margin-left 微調位置，
    // 不動 left／transform——它們是置中定位的基礎，另外疊加位移比
    // 互相覆蓋更不容易踩到 Tailwind 邏輯屬性（inset-inline-start）
    // 跟物理屬性（left）互相打架的坑。
    function reposition() {
      popover.style.marginLeft = "0px";
      var margin = 12;
      // 用 clientWidth 而非 window.innerWidth：後者在桌面版還含捲軸寬度，
      // 前者才是實際可視寬度。
      var vw = document.documentElement.clientWidth;
      var rect = popover.getBoundingClientRect();
      if (rect.left < margin) {
        popover.style.marginLeft = Math.round(margin - rect.left) + "px";
      } else if (rect.right > vw - margin) {
        popover.style.marginLeft = Math.round(vw - margin - rect.right) + "px";
      }
    }

    function open() {
      // 開啟前先通知其他導覽選單收起（語言彈窗、手機版三角／漢堡選單）
      document.dispatchEvent(new CustomEvent("nav:closeOthers", { detail: { except: popover } }));
      popover.setAttribute("data-open", "true");
      toggle.setAttribute("aria-expanded", "true");
      reposition();
      var first = popover.querySelector("a[href]");
      if (first) first.focus();
    }

    toggle.addEventListener("click", function (e) {
      e.stopPropagation();
      if (popover.getAttribute("data-open") === "true") close(false);
      else open();
    });

    document.addEventListener("click", function (e) {
      if (!popover.contains(e.target) && e.target !== toggle) close(false);
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") close(true);
    });
    document.addEventListener("nav:closeOthers", function (e) {
      if (e.detail.except !== popover) close(false);
    });
    window.addEventListener("resize", function () {
      if (popover.getAttribute("data-open") === "true") reposition();
    });

    // Tab 走出彈窗最後一個連結時自動關閉，焦點順勢回到頁面後續元素
    popover.addEventListener("keydown", function (e) {
      if (e.key !== "Tab") return;
      var links = popover.querySelectorAll("a[href]");
      if (!links.length) return;
      var first = links[0];
      var last = links[links.length - 1];
      if (e.shiftKey && document.activeElement === first) close(true);
      else if (!e.shiftKey && document.activeElement === last) close(false);
    });

    // 點擊水波紋。兩顆按鈕都是 target="_blank"，本頁不會離開，
    // 因此不必像首頁那樣 preventDefault 延後跳轉，動畫可自然播完。
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    popover.querySelectorAll("[data-support-ripple]").forEach(function (btn) {
      btn.addEventListener("click", function (event) {
        if (reduceMotion) return;

        var rect = btn.getBoundingClientRect();
        var size = Math.max(rect.width, rect.height) * 2.1;
        // 鍵盤觸發（Enter）沒有座標，改由按鈕中心擴散
        var originX = event.clientX || rect.left + rect.width / 2;
        var originY = event.clientY || rect.top + rect.height / 2;

        var ripple = document.createElement("span");
        ripple.className = "support-ripple support-ripple-" + btn.dataset.supportRipple;
        ripple.style.width = size + "px";
        ripple.style.height = size + "px";
        ripple.style.left = originX - rect.left - size / 2 + "px";
        ripple.style.top = originY - rect.top - size / 2 + "px";
        btn.appendChild(ripple);

        window.setTimeout(function () {
          ripple.remove();
        }, 560);
      });
    });
  })();
</script>
